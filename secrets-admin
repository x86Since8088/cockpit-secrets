# ===========================================================================
# locating backends/ — code, so this is stricter than the data seams
# ===========================================================================

def _lib_candidates():
    """Where `backends/` may live, most specific first.

    The helper installs to /usr/local/sbin while its Python package installs
    with the Cockpit payload, so the two are not siblings on a real host. The
    search is ordered and every candidate is validated; the installer only has
    to put the package in one of them.
    """
    here = os.path.dirname(os.path.realpath(__file__))
    out = []
    env = os.environ.get("COCKPIT_SECRETS_LIB")
    # NOT honoured for a root helper: this variable selects importable code, and
    # an environment variable that chooses code in a euid-0 process is an
    # escalation channel. Data seams (ETC/VAR) are re-validated and safe; this
    # one is simply refused where it would matter.
    if env and os.geteuid() != 0:
        out.append(env)
    out.append(here)
    out.append("/usr/local/lib/cockpit-secrets")
    out.append("/usr/share/cockpit/secrets")
    return out


def _trusted_dir(path, euid):
    """True when `path` is a directory this euid may safely read code or policy
    from: absolute, a real directory (not a symlink we followed blindly), owned
    by root or by us, and not writable by group or other.

    Opened with O_NOFOLLOW|O_DIRECTORY and checked by fstat on the fd — the same
    discipline base.open_safe_fd applies to a safe file, for the same reason
    (I5): a path can change between a stat and an open; a file descriptor
    cannot.
    """
    if not path or not os.path.isabs(path):
        return False
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                     | os.O_CLOEXEC | getattr(os, "O_NOCTTY", 0))
        st = os.fstat(fd)
    except OSError:
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    if not stat.S_ISDIR(st.st_mode):
        return False
    if st.st_uid not in (0, euid):
        return False
    # Group- or other-writable means someone else can drop a file in it. For a
    # registry that is a root grant; for a code directory it is arbitrary
    # execution. No sticky-bit exception here — /tmp-shaped semantics have no
    # business holding either.
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        return False
    return True


def _install_lib_path():
    """Find backends/ and put it on sys.path. Returns (root, trusted).

    One honest asymmetry. CPython puts the script's OWN directory on sys.path
    before this file runs, so refusing to "add" it would be theatre — it is
    already there and the only way to undo that is to re-exec. So the script's
    directory is used when it holds the package, and its trust is *reported*
    through `health` rather than pretended about. Every OTHER candidate is a
    directory we are choosing, and those must pass `_trusted_dir`.

    On a real install this is moot: the helper lives in root-owned
    /usr/local/sbin and the package in a root-owned library directory. It
    matters on a development tree that is group-writable, where the right
    answer is to say so out loud.
    """
    euid = os.geteuid()
    here = os.path.dirname(os.path.realpath(__file__))
    for cand in _lib_candidates():
        try:
            if not os.path.isfile(os.path.join(cand, "backends", "base.py")):
                continue
        except (OSError, ValueError):
            continue
        trusted = _trusted_dir(cand, euid)
        if cand == here:
            if not trusted:
                sys.stderr.write(
                    "secrets-admin: WARNING: %s is group/other-writable or "
                    "not owned by root or this user; it is already on "
                    "sys.path as the script's own directory. Install the "
                    "helper root-owned before trusting this host.\n" % cand)
            if cand not in sys.path:
                sys.path.insert(0, cand)
            return cand, trusted
        if not trusted:
            sys.stderr.write("secrets-admin: ignoring untrusted library root "
                             "%s (ownership or mode)\n" % cand)
            continue
        if cand not in sys.path:
            sys.path.insert(0, cand)
        return cand, True
    return None, False


