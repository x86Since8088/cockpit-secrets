# the exception barrier and main  (I15)
# ===========================================================================

def _debug_traceback(exc):
    """A traceback may reach stderr ONLY with COCKPIT_SECRETS_DEBUG=1, and even
    then it goes through redact(). Never stdout, never by default: a traceback
    prints locals, and in this program the locals are the safe."""
    if not DEBUG:
        return
    try:
        import traceback
        text = "".join(traceback.format_exception(type(exc), exc,
                                                  exc.__traceback__))
        sys.stderr.write(redact(text))
    except Exception:                                          # noqa: BLE001
        pass


EXIT_OK, EXIT_ERROR, EXIT_USAGE, EXIT_INTERNAL = 0, 1, 2, 3


def build_parser():
    """Verb on argv; everything else on stdin.

    There is deliberately no --password, --passphrase, --secret or
    --keyfile-anything here, and validate.sh greps for exactly that: an argument
    is /proc/<pid>/cmdline, which is readable by the process owner and by root
    and reaches shell history and audit trails (I10).
    """
    p = argparse.ArgumentParser(
        prog="secrets-admin", add_help=True,
        description="cockpit-secrets verb helper. The request object is read "
                    "from stdin as JSON; no verb accepts a credential on the "
                    "command line.")
    p.add_argument("verb", nargs="?", help="the verb to run")
    p.add_argument("--n", type=int, default=50,
                   help="audit-tail: how many lines to return")
    p.add_argument("--version", action="store_true",
                   help="print the helper version as JSON and exit")
    return p


def main(argv):
    # FIRST, before anything is opened: no core dumps, not dumpable, umask 077,
    # best-effort mlockall, and close every inherited descriptor above 2 (I14).
    harden = harden_process()

    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="surrogateescape")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, ValueError):
        pass

    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        # argparse writes its own text to stderr; the contract still owes stdout
        # exactly one JSON object.
        emit({"error": "invalid", "detail": "bad command line"})
        return EXIT_USAGE if exc.code else EXIT_OK

    if args.version:
        emit({"version": VERSION, "base": BASE_VERSION,
              "schema_version": SCHEMA_VERSION})
        return EXIT_OK

    verb = args.verb
    if not verb:
        emit({"error": "invalid",
              "detail": "usage: secrets-admin VERB  (request JSON on stdin)",
              "verbs": sorted(list(VERBS) + [SESSION_VERB])})
        return EXIT_USAGE

    ident = Identity()
    ctx = Ctx(ident, args, harden)

    try:
        init_state(ident)

        if verb == SESSION_VERB:
            ctx.load()
            return run_session(ctx)

        spec = VERBS.get(verb)
        if spec is None:
            emit({"error": "invalid", "detail": "unknown verb",
                  "verbs": sorted(list(VERBS) + [SESSION_VERB])})
            return EXIT_USAGE

        req = {} if spec.get("stdin") is False else read_request()
        ctx.load()
        emit(run_verb(verb, req, ctx))
        return EXIT_OK

    except SecretsError as exc:
        # The taxonomy is the whole vocabulary: eight codes, an operator-safe
        # detail that has already been redacted and sanitised by base.py, and
        # nothing else.
        emit(exc.to_json())
        return EXIT_ERROR
    except (BrokenPipeError, KeyboardInterrupt):
        return EXIT_OK
    except Exception as exc:                                   # noqa: BLE001
        # The barrier. A class name, and nothing about what the process was
        # holding when it broke.
        _debug_traceback(exc)
        emit({"error": "internal", "detail": type(exc).__name__})
        return EXIT_INTERNAL
    finally:
        drop_all_sessions()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
