#: `open` is dispatched separately: it is the one invocation that writes more
#: than one JSON object, because it answers more than one request.
SESSION_VERB = "open"

#: Which audit note a taxonomy code maps to when the verb itself did not set a
#: more specific one. Codes, never details — a detail is written by code this
#: file does not own (I15).
_NOTE_FOR_CODE = {
    "access-denied": "class-refused",
    "not-found": "no-such-safe",
    "locked-out": "locked-out",
    "bad-credential": "credential-rejected",
    "conflict": "conflict",
    "unsupported": "unsupported",
    "invalid": "bad-request",
    "internal": "internal",
}


def run_verb(verb, req, ctx):
    """One verb, audited, with the class gate inside it. Returns the response.

    The gate is not called here — it is called by each verb against the entry it
    resolved, because "which safe" is what decides "which class", and only the
    verb knows that.
    """
    spec = VERBS.get(verb)
    if spec is None:
        raise Invalid("unknown verb")
    started = time.monotonic()
    ctx.safe_id = None
    ctx.note = ""
    ctx.artifact = None
    ctx.rows = None
    try:
        out = spec["fn"](req, ctx)
        if not isinstance(out, dict):
            raise Internal("verb %s returned a malformed result" % verb)
        if verb not in VALUE_BEARING_VERBS and verb not in SELF_AUTHORED_VERBS:
            out = scrub_listing(out, verb)
        audit(verb, ctx.safe_id, ctx.ident, "ok",
              (time.monotonic() - started) * 1000.0, ctx.note, ctx.in_session,
              artifact=ctx.artifact, rows=ctx.rows)
        return out
    except SecretsError as exc:
        audit(verb, ctx.safe_id, ctx.ident, exc.code,
              (time.monotonic() - started) * 1000.0,
              ctx.note or _NOTE_FOR_CODE.get(exc.code, ""), ctx.in_session,
              artifact=ctx.artifact, rows=ctx.rows)
        raise
    except Exception:
        audit(verb, ctx.safe_id, ctx.ident, "internal",
              (time.monotonic() - started) * 1000.0, "internal", ctx.in_session,
              artifact=ctx.artifact, rows=ctx.rows)
        raise


# ===========================================================================
# the `open` session — one process, many frames, one unlock
# ===========================================================================

def run_session(ctx):
    """Read newline-delimited request frames, answer each with one JSON line.

    Takes NO pre-read of stdin. `read_request()` reads to EOF, and the whole
    point of this verb is that the caller holds the stream open — a pre-read
    would block until the channel closed, which is the moment the session is
    supposed to end. The banner goes out first with the default timeouts, and a
    frame whose verb is `session` may SHORTEN them; nothing can lengthen them
    past the built-in ceilings.

    This is the ONE place the contract's "exactly one JSON object" is relaxed,
    and it is relaxed in the only way that keeps the property it protects: one
    object per REQUEST, in order, on lines. The session ends when the channel
    closes (the browser tab was shut), the idle timer fires, the absolute
    lifetime is reached, or `lock` drops the last handle — and every one of
    those kills the process, which is what ends the unlock.

    Returns the process exit code.
    """
    ctx.in_session = True
    idle = SESSION_IDLE_SECONDS
    lifetime = SESSION_MAX_SECONDS
    reader = FrameReader(0)
    started = time.monotonic()
    hard_deadline = started + lifetime
    reason = "eof"

    # `frame` is the UNAMBIGUOUS tag. Everything else about this object is
    # also true of an unlock reply issued inside a session (which carries
    # "session": true), so a client that disambiguated by shape had to test for
    # both timeouts AND the absence of a handle — and would have broken the
    # moment a reply grew a timeout. A dedicated key that no verb result ever
    # sets costs nothing and cannot collide.
    emit({"frame": "banner", "session": True, "ok": True,
          "idle_seconds": idle, "max_seconds": lifetime,
          "help": "send one JSON request object per line; each carries a "
                  "\"verb\" key"})
    audit(SESSION_VERB, None, ctx.ident, "ok", 0.0, "session-open", True)

    while True:
        if time.monotonic() >= hard_deadline:
            reason = "max-lifetime"
            break
        deadline = min(time.monotonic() + idle, hard_deadline)
        try:
            line = reader.read_frame(deadline)
        except EOFError:
            reason = "eof"
            break
        except SecretsError as exc:
            emit(exc.to_json())
            reason = "invalid-frame"
            break
        if line is None:
            reason = ("max-lifetime" if time.monotonic() >= hard_deadline
                      else "idle")
            break
        if not line.strip():
            continue

        try:
            frame = parse_request(line)
        except SecretsError as exc:
            emit(exc.to_json())
            continue
        verb = frame.get("verb")
        if verb == SESSION_VERB or verb == "session":
            # A settings frame. It may only SHORTEN the window: `_int_field`
            # clamps to the built-in ceilings, and the absolute deadline is
            # recomputed from the session's start rather than from now, so a
            # client cannot keep itself alive by resending this (I18's rule,
            # applied to the session that is not the agent).
            idle = _int_field(frame, "idle_seconds", idle,
                              SESSION_IDLE_MIN, SESSION_IDLE_MAX)
            lifetime = min(lifetime, _int_field(frame, "max_seconds", lifetime,
                                                SESSION_MAX_MIN,
                                                SESSION_MAX_MAX))
            hard_deadline = started + lifetime
            emit({"frame": "banner", "session": True, "ok": True,
                  "idle_seconds": idle, "max_seconds": lifetime,
                  "expires_in": max(0, int(hard_deadline - time.monotonic()))})
            continue
        if not isinstance(verb, str) or verb not in VERBS:
            emit(Invalid("unknown or missing verb in this frame").to_json())
            continue
        try:
            emit(run_verb(verb, frame, ctx))
        except SecretsError as exc:
            emit(exc.to_json())
        except Exception as exc:                               # noqa: BLE001
            _debug_traceback(exc)
            emit({"error": "internal", "detail": type(exc).__name__})
        if verb == "lock" and not HANDLES:
            reason = "locked"
            break

    drop_all_sessions()
    audit(SESSION_VERB, None, ctx.ident, "ok", 0.0, "session-closed", True)
    emit({"frame": "closed", "session_closed": True, "reason": reason})
    return 0


