def _verb(vid, group, title, help_, **kw):
    return {
        "id": vid,
        "group": group,
        "title": title,
        "help": help_,
        "danger": kw.get("danger", False),
        "mutates": kw.get("mutates", False),
        "needs": kw.get("needs", "none"),
        "stdin": kw.get("stdin", True),
        "session_only": kw.get("session_only", False),
        "request": kw.get("request", []),
        "response": kw.get("response", {}),
        "confirm": kw.get("confirm", None),
        "audited": kw.get("audited", True),
        "access": kw.get("access", "class"),
        "breaks_when_wrong": kw.get("breaks_when_wrong", None),
    }


