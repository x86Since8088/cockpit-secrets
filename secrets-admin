_KNOWN_KEYS = ("id", "label", "format", "path", "access", "owner", "groups",
               "mode", "password_required", "keyfile", "yubikey_slot",
               "agent", "export_allowed", "backup")


def validate_entry(raw):
    """One registry object -> (entry with defaults applied, None) | (None, why).

    Fails closed in every direction. In particular a missing `access` resolves
    to **admin**, the restrictive class, so a hand-edited file that loses a line
    refuses access rather than granting it (I1).
    """
    if not isinstance(raw, dict):
        return None, "not a JSON object"

    unknown = sorted(set(raw) - set(_KNOWN_KEYS))
    if unknown:
        # additionalProperties:false. A typo like "acess": "user" must be
        # refused outright rather than half-applied — the half that applies
        # would be the permissive half.
        return None, "unknown key %r" % unknown[0]

    for req in ("id", "label", "format", "path"):
        if req not in raw:
            return None, "missing required key %r" % req

    sid = raw["id"]
    if not isinstance(sid, str) or not 1 <= len(sid) <= 63 \
            or not _ID_RE.match(sid):
        # This string reaches file names (the lockout counter, the backup ring)
        # and log lines. Slashes, spaces, '..' and upper case are refused here
        # so path traversal cannot enter through the one identifier the whole
        # access model is keyed on.
        return None, "id must match ^[a-z0-9][a-z0-9._-]*$ and be 1..63 chars"

    label = raw["label"]
    if not isinstance(label, str) or not 1 <= len(label) <= 128:
        return None, "label must be a string of 1..128 characters"

    fmt = raw["format"]
    if fmt not in FORMATS:
        return None, "format must be one of %s" % ", ".join(FORMATS)

    if not _is_safe_abs_path(raw["path"]):
        return None, "path must be absolute, 2+ characters, and free of '..'"

    access = raw.get("access", "admin")
    if access not in ("admin", "user"):
        return None, "access must be 'admin' or 'user'"

    owner = raw.get("owner", None)
    if owner is not None and (not isinstance(owner, str)
                              or not _OWNER_RE.match(owner)):
        return None, "owner must be null, '%u', a uid, or a login name"

    groups = raw.get("groups", [])
    if not isinstance(groups, list) or len(groups) > 16:
        return None, "groups must be an array of at most 16 names"
    if len(set(map(repr, groups))) != len(groups):
        return None, "groups must not repeat a name"
    for g in groups:
        if not isinstance(g, str) or not 1 <= len(g) <= 32 \
                or not _GROUP_RE.match(g):
            return None, "groups contains an invalid group name"

    mode = raw.get("mode", "rw")
    if mode not in ("rw", "ro"):
        return None, "mode must be 'rw' or 'ro'"

    pw_required = raw.get("password_required", True)
    if not isinstance(pw_required, bool):
        return None, "password_required must be true or false"

    keyfile = raw.get("keyfile", None)
    if keyfile is not None and not _is_safe_abs_path(keyfile):
        return None, "keyfile must be null or an absolute path free of '..'"

    slot = raw.get("yubikey_slot", None)
    if slot is not None and (not _is_int(slot) or slot not in (1, 2)):
        return None, "yubikey_slot must be null, 1 or 2"

    export_allowed = raw.get("export_allowed", False)
    if not isinstance(export_allowed, bool):
        return None, "export_allowed must be true or false"

    agent, why = _sub_object(raw, "agent", _AGENT_SPEC, AGENT_DEFAULT)
    if why:
        return None, why
    backup, why = _sub_object(raw, "backup", _BACKUP_SPEC, BACKUP_DEFAULT)
    if why:
        return None, why

    # ---- rules the schema cannot express, re-checked here on purpose -----

    if pw_required is False and not (isinstance(keyfile, str) or _is_int(slot)):
        # "password_required": false with no other key registered is not a
        # configuration, it is an unlocked file. The schema refuses it first;
        # this is the enforcement.
        return None, ("password_required:false needs a keyfile or a "
                      "yubikey_slot — otherwise the safe opens with nothing")

    if agent["max_seconds"] < agent["idle_seconds"]:
        # JSON Schema cannot compare two sibling fields. An inverted pair means
        # the absolute lifetime is shorter than the idle timeout, which reads as
        # "no limit at all" to anyone skimming the file (I18).
        return None, "agent.max_seconds must be >= agent.idle_seconds"

    bdir = backup.get("dir")
    if isinstance(bdir, str):
        norm = bdir if bdir.endswith("/") else bdir + "/"
        if any(norm.startswith(p) for p in _FORBIDDEN_BACKUP_PREFIXES):
            return None, ("backup.dir must not be under /tmp, /var/tmp or "
                          "/dev/shm — a backup is as sensitive as the safe")

    return {
        "id": sid, "label": label, "format": fmt, "path": raw["path"],
        "access": access, "owner": owner, "groups": groups, "mode": mode,
        "password_required": pw_required, "keyfile": keyfile,
        "yubikey_slot": slot, "agent": agent,
        "export_allowed": export_allowed, "backup": backup,
    }, None


# ------------------------------------------------- the jsonschema gate ----

_SCHEMA_GATE = {"engine": "builtin-only", "reason": "", "path": None}
_SCHEMA_VALIDATOR = None


def _schema_file_candidates(etc_root):
    here = os.path.dirname(os.path.realpath(__file__))
    out = [os.path.join(etc_root, "schema", SCHEMA_FILE),
           os.path.join(here, "schema", SCHEMA_FILE)]
    if LIB_ROOT:
        out.append(os.path.join(LIB_ROOT, "schema", SCHEMA_FILE))
    out.append(os.path.join("/usr/share/cockpit/secrets/schema", SCHEMA_FILE))
    return out


def _schema_validator(etc_root):
    """Draft7Validator over safe-registry.schema.json, or None.

    None is not "fail open": `validate_entry()` has already run and is the
    enforcement point. This gate only ever REMOVES entries, so its absence
    cannot admit one. `health` reports which engine is live.
    """
    global _SCHEMA_VALIDATOR
    if _SCHEMA_VALIDATOR is not None:
        return _SCHEMA_VALIDATOR
    try:
        import jsonschema                                       # noqa: F401
    except Exception as exc:                                    # noqa: BLE001
        _SCHEMA_GATE["reason"] = ("python3-jsonschema not installed (%s); the "
                                  "built-in validator is the enforcement point"
                                  % type(exc).__name__)
        return None
    for cand in _schema_file_candidates(etc_root):
        try:
            with open(cand, "rb") as fh:
                doc = json.loads(fh.read(1024 * 1024).decode("utf-8"))
        except (OSError, ValueError, UnicodeDecodeError):
            continue
        try:
            _SCHEMA_VALIDATOR = jsonschema.Draft7Validator(doc)
        except Exception as exc:                                # noqa: BLE001
            _SCHEMA_GATE["reason"] = ("schema file is not valid Draft-07 (%s)"
                                      % type(exc).__name__)
            return None
        _SCHEMA_GATE["engine"] = "jsonschema+builtin"
        _SCHEMA_GATE["path"] = cand
        return _SCHEMA_VALIDATOR
    _SCHEMA_GATE["reason"] = "safe-registry.schema.json not found"
    return None


# ------------------------------------------------------- reading files ----

def registry_root():
    """The registry ROOT. `COCKPIT_SECRETS_ETC` overrides it for hermetic tests;
    see the module docstring for why that changes no security property."""
    env = os.environ.get("COCKPIT_SECRETS_ETC")
    if env:
        if not os.path.isabs(env):
            raise Invalid("COCKPIT_SECRETS_ETC must be an absolute path")
        return env.rstrip("/") or "/"
    return DEFAULT_ETC


def _read_registry_file(dirfd, name, euid):
    """Read one safes.d/*.json through the directory fd. Returns (text, why).

    Opened relative to a descriptor on the directory we already validated, with
    O_NOFOLLOW, and checked by fstat on the returned fd — so a symlink swapped
    in after the listing is refused rather than followed (I5).
    """
    fd = None
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
                     | getattr(os, "O_NOCTTY", 0), dir_fd=dirfd)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, "not a regular file"
        if st.st_uid not in (0, euid):
            return None, "owned by uid %d (expected root or the caller)" % st.st_uid
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return None, "group- or other-writable"
        if st.st_size > MAX_REGISTRY_FILE_BYTES:
            return None, ("%d bytes exceeds the %d byte cap"
                          % (st.st_size, MAX_REGISTRY_FILE_BYTES))
        data = os.read(fd, MAX_REGISTRY_FILE_BYTES + 1)
        if len(data) > MAX_REGISTRY_FILE_BYTES:
            return None, "larger than the registry file cap"
        return data.decode("utf-8"), None
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            return None, "is a symlink"
        return None, "unreadable (%s)" % errno.errorcode.get(exc.errno, "EIO")
    except UnicodeDecodeError:
        return None, "is not valid UTF-8"
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def load_registry(ident):
    """Load and validate every safes.d entry. Returns (entries, errors).

    `entries` is an ordered dict id -> entry, in lexical file order. `errors` is
    a list of {"file","error"} for everything that was DROPPED — surfaced by
    `health` as `registry_errors[]`, which is the supported way to find out why
    a safe is missing from the list. A dropped entry is never partially applied
    and never defaulted to the permissive class (I1).
    """
    errors = []
    entries = {}
    root = registry_root()
    safes_d = os.path.join(root, SAFES_D)

    if not _trusted_dir(root, ident.euid):
        # A registry an unprivileged user can edit is a registry that grants
        # itself root. Refusing the whole directory is the only correct answer:
        # partially trusting it would mean trusting the part they wrote.
        errors.append({"file": root,
                       "error": "registry root is missing, not a directory, "
                                "not owned by root or this user, or is "
                                "group/other-writable — the whole registry is "
                                "refused"})
        return entries, errors
    if not _trusted_dir(safes_d, ident.euid):
        errors.append({"file": safes_d,
                       "error": "safes.d is missing, not a directory, not "
                                "owned by root or this user, or is "
                                "group/other-writable — the whole registry is "
                                "refused"})
        return entries, errors

    dirfd = None
    try:
        dirfd = os.open(safes_d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                        | os.O_CLOEXEC)
        names = sorted(n for n in os.listdir(dirfd) if n.endswith(".json"))
    except OSError as exc:
        errors.append({"file": safes_d,
                       "error": "cannot list (%s)"
                                % errno.errorcode.get(exc.errno, "EIO")})
        if dirfd is not None:
            try:
                os.close(dirfd)
            except OSError:
                pass
        return entries, errors

    validator = _schema_validator(root)
    try:
        if len(names) > MAX_REGISTRY_FILES:
            errors.append({"file": safes_d,
                           "error": "more than %d entries; only the first %d "
                                    "are read" % (MAX_REGISTRY_FILES,
                                                  MAX_REGISTRY_FILES)})
            names = names[:MAX_REGISTRY_FILES]
        for name in names:
            text, why = _read_registry_file(dirfd, name, ident.euid)
            if why:
                errors.append({"file": name, "error": why})
                continue
            try:
                raw = json.loads(text)
            except ValueError as exc:
                errors.append({"file": name,
                               "error": "not valid JSON (%s)"
                                        % type(exc).__name__})
                continue
            entry, why = validate_entry(raw)
            if why:
                errors.append({"file": name, "error": why})
                continue
            if validator is not None:
                schema_errs = sorted(validator.iter_errors(raw), key=str)
                if schema_errs:
                    errors.append({
                        "file": name,
                        "error": "rejected by safe-registry.schema.json: %s"
                                 % str(schema_errs[0].message)[:160]})
                    continue
            if entry["id"] in entries:
                # The lexically last file wins (schema/README.md), but silently
                # is not good enough: a duplicate id means one of the two files
                # is not doing what its author thinks.
                errors.append({"file": name,
                               "error": "duplicate id %r overrides an earlier "
                                        "entry" % entry["id"]})
            entries[entry["id"]] = entry
    finally:
        try:
            os.close(dirfd)
        except OSError:
            pass
    return entries, errors


def resolve_entry(entry, ident):
    """Apply per-caller substitution and return a COPY for the backend.

    `owner: "%u"` means "each user gets their own safe at this path", so `%u` in
    the path expands to the caller's login name. This is the only templating in
    the system and it expands to a name the kernel gave us, never to anything
    from the request (I4).
    """
    out = dict(entry)
    if entry.get("owner") == "%u":
        name = ident.real_name if ident.euid != 0 else None
        if not name:
            raise AccessDenied("this safe is per-user and the calling user has "
                               "no name on this host")
        if "%u" in out["path"]:
            out["path"] = out["path"].replace("%u", name)
        if isinstance(out.get("keyfile"), str):
            out["keyfile"] = out["keyfile"].replace("%u", name)
    return out


def lookup_safe(safe_id, ctx):
    """Registry id -> entry. THE ONLY place an id becomes a path (I4)."""
    if not isinstance(safe_id, str) or not safe_id:
        raise Invalid("a safe id is required")
    if len(safe_id) > 63 or not _ID_RE.match(safe_id):
        # Refused by shape before it is looked up, so a traversal-shaped id
        # never reaches a dict key, a log line or a state file name.
        raise Invalid("a safe id must match ^[a-z0-9][a-z0-9._-]*$")
    entry = ctx.registry.get(safe_id)
    if entry is None:
        raise NotFound("no safe with that id is registered")
    return entry


# ===========================================================================
# writable state: the lockout counter and the audit log
# ===========================================================================
#
# Both want to live under /var, both are written by a helper that is root for
# admin safes and an ordinary user for user safes, and /var/lib is not writable
# by the latter. The resolution is a documented fallback rather than a silent
# one, and `health` reports which paths are actually in use.
#
# What that costs, stated plainly: a user-class lockout counter lives in the
# user's own state directory and the user can delete it. That is not a hole,
# because the user already owns the safe file and can run an offline attack on
# it with no help from this program. The counter that matters is the admin-class
# one, which lives under a root-owned 0700 directory an attacker cannot touch
# without already being root.

_STATE_REPORT = {"state_dir": None, "audit_log": None,
                 "state_persisted": False, "audit_persisted": False,
                 "reason": ""}


def _var_root():
    env = os.environ.get("COCKPIT_SECRETS_VAR")
    if env:
        if not os.path.isabs(env):
            raise Invalid("COCKPIT_SECRETS_VAR must be an absolute path")
        return env.rstrip("/") or "/"
    return None


def _user_state_home(ident):
    try:
        home = pwd.getpwuid(ident.euid).pw_dir
    except (KeyError, OSError):
        return None
    if not home or not os.path.isabs(home):
        return None
    return os.path.join(home, ".local", "state", "cockpit-secrets")


def _ensure_dir(path, mode=0o700):
    """Create `path` 0700 and return it, or None. Never follows a symlink into
    place: an existing non-directory or a foreign owner is a refusal."""
    try:
        os.makedirs(path, mode=mode, exist_ok=True)
    except OSError:
        return None
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                     | os.O_CLOEXEC)
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
            return None
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH | stat.S_IRGRP
                         | stat.S_IROTH):
            # Tighten rather than refuse: an inherited 0755 here is a mistake we
            # can fix, and leaving it would make the audit log group-readable —
            # the exact failure wg-admin's header warns about.
            try:
                os.fchmod(fd, mode)
            except OSError:
                return None
    except OSError:
        return None
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    return path


def init_state(ident):
    """Resolve and create the state and audit directories. Idempotent."""
    if _STATE_REPORT["state_dir"] is not None:
        return _STATE_REPORT
    var = _var_root()
    if var:
        state = _ensure_dir(os.path.join(var, "state"))
        logdir = _ensure_dir(os.path.join(var, "log"))
        _STATE_REPORT["reason"] = "COCKPIT_SECRETS_VAR override"
    else:
        state = _ensure_dir(os.path.join(DEFAULT_VAR, "state"))
        logdir = _ensure_dir(DEFAULT_LOG_DIR)
        if state is None or logdir is None:
            home = _user_state_home(ident)
            if home:
                state = state or _ensure_dir(os.path.join(home, "state"))
                logdir = logdir or _ensure_dir(home)
                _STATE_REPORT["reason"] = (
                    "system state directory is not writable by this uid; "
                    "using the caller's own state directory")
    _STATE_REPORT["state_dir"] = state
    _STATE_REPORT["state_persisted"] = state is not None
    _STATE_REPORT["audit_log"] = (os.path.join(logdir, "audit.log")
                                  if logdir else None)
    _STATE_REPORT["audit_persisted"] = logdir is not None
    if state is None and not _STATE_REPORT["reason"]:
        _STATE_REPORT["reason"] = "no writable state directory"
    return _STATE_REPORT


# ------------------------------------------------------------ lockout ----

def _lockout_path(safe_id):
    state = _STATE_REPORT.get("state_dir")
    if not state:
        return None
    # safe_id already matched ^[a-z0-9][a-z0-9._-]*$ in lookup_safe, so it
    # cannot contain a slash or a '..'. Asserted rather than assumed, because
    # this is the one place an id becomes a filename.
    if not _ID_RE.match(safe_id):
        raise Internal("refusing to build a state path from an invalid id")
    return os.path.join(state, "fail.%d.%s.json" % (os.geteuid(), safe_id))


def _lockout_read(safe_id):
    path = _lockout_path(safe_id)
    if not path:
        return {}
    try:
        with open(path, "rb") as fh:
            doc = json.loads(fh.read(8192).decode("utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return {}
    return doc if isinstance(doc, dict) else {}


def _lockout_write(safe_id, doc):
    path = _lockout_path(safe_id)
    if not path:
        return False
    fd = None
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC
                     | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        os.fchmod(fd, 0o600)
        os.write(fd, json.dumps(doc).encode("utf-8"))
        return True
    except OSError:
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def lockout_check(safe_id):
    """Raise LockedOut while the backoff window for (this uid, this safe) is
    open. Called before the KDF, so a locked-out caller costs nothing."""
    doc = _lockout_read(safe_id)
    until = doc.get("locked_until")
    if not isinstance(until, (int, float)):
        return
    now = time.time()
    remaining = until - now
    if remaining <= 0:
        return
    # Clamp on read. A tampered or clock-skewed state file must not be able to
    # lock a legitimate user out for a year, and the file is writable by the
    # user on the user-class path.
    remaining = min(remaining, LOCKOUT_MAX_SECONDS)
    raise LockedOut("too many failed unlock attempts for this safe; try again "
                    "in %d seconds" % int(math.ceil(remaining)))


def lockout_fail(safe_id):
    """Record ONE failed credential attempt and widen the backoff.

    Only a `bad-credential` outcome lands here. An access-denied or a not-found
    deliberately does not count: if it did, anyone who could reach the helper
    could lock a legitimate administrator out of a safe they cannot open
    themselves. Every caller who reaches this line has already passed the class
    gate, so the counter can only be moved by someone entitled to try.
    """
    doc = _lockout_read(safe_id)
    fails = doc.get("failures")
    fails = (fails + 1) if _is_int(fails) and fails >= 0 else 1
    delay = LOCKOUT_BASE_SECONDS * (2 ** max(0, min(fails - 1, 20)))
    if fails >= LOCKOUT_THRESHOLD:
        delay = max(delay, LOCKOUT_HARD_SECONDS)
    delay = min(delay, LOCKOUT_MAX_SECONDS)
    now = time.time()
    _lockout_write(safe_id, {"failures": fails, "locked_until": now + delay,
                             "last": _iso_utc(now)})
    return fails, delay


def lockout_reset(safe_id):
    """A successful unlock clears the counter — the window exists to slow
    guessing, not to punish a typo an hour ago."""
    path = _lockout_path(safe_id)
    if not path:
        return
    try:
        os.unlink(path)
    except OSError:
        _lockout_write(safe_id, {"failures": 0, "locked_until": 0})


def fail_floor_seconds(ident):
    """The I16 constant time floor, in seconds.

    A wrong passphrase must never come back faster than a right one. Most of
    that is free — the KDF runs before the MAC check either way — but the cases
    that fail BEFORE the KDF (a header that will not parse, a key file of the
    wrong length) would otherwise return instantly and tell an attacker their
    guess was not even a valid attempt.

    `COCKPIT_SECRETS_FAIL_FLOOR` lowers it so the suite is not 0.75 s per
    negative case, and is IGNORED on the production admin path (euid 0 against
    the real registry) — the only configuration where that timing distinction
    buys an attacker anything they do not already have.
    """
    default = float(Limits.FAIL_FLOOR_SECONDS)
    raw = os.environ.get("COCKPIT_SECRETS_FAIL_FLOOR")
    if not raw:
        return default
    if ident.euid == 0 and not os.environ.get("COCKPIT_SECRETS_ETC"):
        return default
    try:
        value = float(raw)
    except ValueError:
        return default
    return max(0.0, min(value, 10.0))


class FailFloor:
    """Hold the failure path open until `floor` seconds have passed.

    Monotonic, so a wall-clock step (ntp, a VM resume) cannot collapse the floor
    to nothing or stretch it to a hang.
    """

    __slots__ = ("floor", "start")

    def __init__(self, floor):
        self.floor = float(floor)
        self.start = time.monotonic()

    def wait(self):
        remaining = self.floor - (time.monotonic() - self.start)
        if remaining > 0:
            time.sleep(min(remaining, 30.0))


# -------------------------------------------------------------- audit ----

#: Everything the audit line may contain. There is no field here for a value,
#: an entry title, a path or a traceback, and `audit()` builds the dict from
#: this list rather than from whatever a caller passes (I15).
_AUDIT_KEYS = ("ts", "verb", "safe", "uid", "euid", "outcome", "note",
               "duration_ms", "pid", "session")

#: `note` is helper-controlled and drawn from this set. A backend's `detail`
#: never reaches the log: it is operator-safe by construction, but "operator
#: safe" is a promise made by code this file does not own.
_AUDIT_NOTES = frozenset((
    "", "class-refused", "locked-out", "handle-unknown", "handle-expired",
    "registry-dropped", "no-such-safe", "backend-unavailable", "file-refused",
    "credential-rejected", "conflict", "read-only", "session-open",
    "session-closed", "unsupported", "bad-request", "internal",
))


def audit(verb, safe_id, ident, outcome, duration_ms, note="", session=False):
    """Append ONE JSON line: verb, safe, uid, outcome, duration. Never a value.

    Best effort by design. An audit write that fails must not fail the verb —
    but it must not be invisible either, so the failure goes to stderr and
    `health` reports whether the log is persisted at all.
    """
    path = _STATE_REPORT.get("audit_log")
    if not path:
        return
    line = {
        "ts": _iso_utc(),
        "verb": str(verb)[:64],
        "safe": (str(safe_id)[:63] if safe_id else None),
        "uid": ident.real_uid,
        "euid": ident.euid,
        "outcome": str(outcome)[:32],
        "note": note if note in _AUDIT_NOTES else "",
        "duration_ms": int(duration_ms),
        "pid": ident.pid,
        "session": bool(session),
    }
    assert set(line) == set(_AUDIT_KEYS)      # the shape is the guarantee
    fd = None
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND
                     | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        st = os.fstat(fd)
        if st.st_mode & 0o077:
            os.fchmod(fd, 0o600)
        # redact() over the finished line, not over the pieces: the filter is
        # cheap and this is the last chance to catch a secret that reached a
        # field it had no business reaching.
        os.write(fd, (redact(json.dumps(line, ensure_ascii=False)) + "\n")
                 .encode("utf-8"))
    except OSError as exc:
        _note("audit write failed (%s); the operation still ran"
              % errno.errorcode.get(exc.errno, "EIO"))
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


# ===========================================================================
# handles and the single-process session
# ===========================================================================

class Session:
    """One unlocked backend, reachable only from inside this process.

    The handle is 128 bits of `secrets.token_urlsafe` bound to (uid, safe id,
    pid). There is no persistence layer under this object: when the process
    exits the dict goes with the address space, which is why "the passphrase is
    prompted every time" needs no timer to be true (docs/ARCHITECTURE.md).
    """

    __slots__ = ("handle", "uid", "safe", "pid", "backend", "entry",
                 "created", "last_used", "expires_at", "mutated")

    def __init__(self, handle, uid, safe, pid, backend, entry, ttl):
        self.handle = handle
        self.uid = uid
        self.safe = safe
        self.pid = pid
        self.backend = backend
        self.entry = entry
        self.created = time.monotonic()
        self.last_used = self.created
        self.expires_at = self.created + ttl
        self.mutated = False

    def expires_in(self):
        return max(0, int(self.expires_at - time.monotonic()))


HANDLES = {}


def new_session(safe_id, ident, backend, entry, ttl):
    handle = _sysrandom.token_urlsafe(16)          # 128 bits, URL-safe
    HANDLES[handle] = Session(handle, ident.euid, safe_id, ident.pid,
                              backend, entry, ttl)
    return HANDLES[handle]


def find_session(handle, ident):
    """Handle -> Session, or AccessDenied.

    Presenting a handle you do not own is access-denied, never not-found
    (docs/CONTRACT.md): the two must be indistinguishable or the verb becomes an
    oracle for which handles exist. Every candidate is compared with
    `constant_time_eq` and the loop does not stop early, so neither the answer
    nor the timing separates "unknown" from "someone else's".
    """
    if not isinstance(handle, str) or not handle or len(handle) > 128:
        raise AccessDenied("this handle is not valid for this caller")
    match = None
    for known, sess in HANDLES.items():
        if constant_time_eq(known, handle):
            match = sess
    if match is None:
        raise AccessDenied("this handle is not valid for this caller")
    if match.uid != ident.euid or match.pid != ident.pid:
        raise AccessDenied("this handle is not valid for this caller")
    if match.expires_in() <= 0:
        drop_session(match)
        raise AccessDenied("this handle has expired; unlock again")
    match.last_used = time.monotonic()
    return match


def drop_session(sess):
    """Lock and forget one session. Idempotent."""
    try:
        sess.backend.lock()
    except Exception as exc:                                   # noqa: BLE001
        _note("backend lock() raised %s during teardown" % type(exc).__name__)
    HANDLES.pop(sess.handle, None)


def drop_all_sessions():
    for sess in list(HANDLES.values()):
        drop_session(sess)


# ===========================================================================
# request framing — the verb is on argv, everything else is stdin  (I10)
# ===========================================================================

def read_request(limit=None):
    """Read ONE JSON object from stdin, to EOF, capped at MAX_REQUEST_BYTES.

    This is the whole of I10 in one function: the master passphrase, the key
    file's bytes and every new value arrive here and nowhere else. Nothing is
    parsed from argv, nothing is read from the environment, and nothing is
    written to a temp file on the way in.

    An interactive tty is treated as an empty request so an operator can run
    `secrets-admin health` in a shell without the helper hanging on a read that
    will never end.
    """
    cap = Limits.MAX_REQUEST_BYTES if limit is None else limit
    try:
        if os.isatty(0):
            return {}
    except OSError:
        pass
    chunks, total = [], 0
    while True:
        try:
            chunk = os.read(0, 65536)
        except OSError as exc:
            if exc.errno == errno.EINTR:
                continue
            raise Invalid("could not read the request from stdin")
        if not chunk:
            break
        total += len(chunk)
        if total > cap:
            # Refuse by arithmetic before the allocation grows, and do not keep
            # reading: a hostile caller must not be able to balloon the helper
            # by streaming into it forever.
            raise Invalid("the request exceeds the %d byte limit" % cap)
        chunks.append(chunk)
    return parse_request(b"".join(chunks))


def parse_request(data):
    if not data.strip():
        return {}
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Invalid("the request is not valid UTF-8")
    try:
        req = json.loads(text)
    except ValueError:
        raise Invalid("the request is not valid JSON")
    if not isinstance(req, dict):
        raise Invalid("the request must be a single JSON object")
    return req


class FrameReader:
    """Newline-delimited JSON frames off fd 0, for the `open` session.

    Reads the raw descriptor rather than sys.stdin so the idle timer is a real
    `select` on the channel and not a guess about a buffered file object.
    """

    __slots__ = ("fd", "limit", "buf")

    def __init__(self, fd=0, limit=None):
        self.fd = fd
        self.limit = Limits.MAX_REQUEST_BYTES if limit is None else limit
        self.buf = b""

    def read_frame(self, deadline):
        """One line, or None on idle timeout. Raises EOFError when the channel
        closes — which is how closing the browser tab ends an unlock."""
        while True:
            nl = self.buf.find(b"\n")
            if nl >= 0:
                line, self.buf = self.buf[:nl], self.buf[nl + 1:]
                return line
            if len(self.buf) > self.limit:
                raise Invalid("a session frame exceeds the %d byte limit"
                              % self.limit)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            try:
                ready, _, _ = select.select([self.fd], [], [],
                                            min(remaining, 5.0))
            except (OSError, ValueError) as exc:
                if getattr(exc, "errno", None) == errno.EINTR:
                    continue
                raise EOFError
            if not ready:
                continue
            try:
                chunk = os.read(self.fd, 65536)
            except OSError as exc:
                if exc.errno == errno.EINTR:
                    continue
                raise EOFError
            if not chunk:
                if self.buf:
                    line, self.buf = self.buf, b""
                    return line
                raise EOFError
            self.buf += chunk


# ===========================================================================
# backends — imported lazily, missing ones reported not raised
# ===========================================================================

def load_backend_class(fmt):
    """Format id -> Backend subclass. Raises Unsupported, never a traceback.

    The module name is matched against FORMATS first. The registry is root
    owned, but "root owned" is not the same as "safe to concatenate into an
    import statement", and this is the only line in the file that turns data
    into code.
    """
    if fmt not in FORMATS:
        raise Unsupported("format %r has no backend" % str(fmt)[:16])
    try:
        importlib.import_module("backends." + fmt)
    except ImportError as exc:
        raise Unsupported("the %s backend is not installed (%s)"
                          % (fmt, type(exc).__name__))
    except Exception as exc:                                   # noqa: BLE001
        # A backend that raises while importing is broken, not absent. Same
        # answer to the client either way; the class name is enough for an
        # operator and carries no value.
        raise Unsupported("the %s backend failed to import (%s)"
                          % (fmt, type(exc).__name__))
    try:
        return backend_for(fmt)
    except SecretsError:
        raise Unsupported("the %s backend did not register itself" % fmt)


def backend_health(fmt):
    """One row of `health.backends`. Never raises."""
    row = {"available": False, "reason": "", "module": "backends." + fmt,
           "class": None}
    try:
        cls = load_backend_class(fmt)
    except SecretsError as exc:
        row["reason"] = exc.detail
        return row
    except Exception as exc:                                   # noqa: BLE001
        row["reason"] = "%s while loading" % type(exc).__name__
        return row
    row["available"] = True
    row["class"] = getattr(cls, "__name__", None)
    return row


# ===========================================================================
# defensive scrubbing of backend output
# ===========================================================================
#
# docs/CONTRACT.md makes `entries()` returning a password a class invariant, and
# backends/base.py restates it. Invariants stated in a docstring are kept by the
# code that reads the docstring, and the backends are written by other hands, so
# the helper checks rather than trusts. A listing that arrives carrying a value
# loses it here and the anomaly goes to stderr.

_BANNED_LISTING_KEYS = frozenset((
    "password", "passphrase", "pass", "secret", "value", "plaintext",
    "keyfile", "keyfile_b64", "totp_uri", "otp_uri", "otp", "code", "b64",
))

#: The four verbs whose whole purpose is to return one value. Everything else
#: is metadata, and `reveal` is the only door (docs/CONTRACT.md).
VALUE_BEARING_VERBS = frozenset(("reveal", "totp", "attach-get", "generate"))

#: Verbs whose response this file builds itself, with no backend involved. The
#: scrubber exists to catch a BACKEND that breaks contract invariant 1; running
#: it over `schema` would strip the `value` key out of every enum option and
#: quietly amputate the document the whole UI is generated from.
SELF_AUTHORED_VERBS = frozenset(("schema", "health", "audit-tail"))


def scrub_listing(obj, verb, _depth=0):
    """Strip value-shaped keys from a metadata response. Returns the object."""
    if _depth > 12:
        return obj
    if isinstance(obj, dict):
        out = {}
        for key, value in obj.items():
            if isinstance(key, str) and key.lower() in _BANNED_LISTING_KEYS:
                _note("backend returned %r from %s; dropped (contract "
                      "invariant 1)" % (key, verb))
                continue
            out[key] = scrub_listing(value, verb, _depth + 1)
        return out
    if isinstance(obj, list):
        return [scrub_listing(v, verb, _depth + 1) for v in obj]
    return obj


# ===========================================================================
# unlock — the one place credentials are handled
# ===========================================================================

def _keyfile_secret(entry, req):
    """The key file's BYTES as a Secret, from the request or from the registry.

    A caller may send bytes (`keyfile_b64`, read by the browser from the user's
    own machine) but never a path: a path from a request is I4, and a root
    helper reading a caller-named file is I5. The registry's `keyfile` IS a
    path, because the registry is root-owned policy rather than caller input,
    and it is opened through the same O_NOFOLLOW/fstat guard as the safe.
    """
    raw = req.get("keyfile_b64")
    if raw:
        if not isinstance(raw, str):
            raise Invalid("keyfile_b64 must be a base64 string")
        return Secret.from_b64(raw)
    path = entry.get("keyfile")
    if not path:
        return None
    sf = open_safe_fd(path)
    try:
        return Secret(sf.read_all(Limits.MAX_KEYFILE_BYTES))
    finally:
        sf.close()


def _password_secret(entry, req):
    raw = req.get("password")
    if raw is None or raw == "":
        if entry.get("password_required", True):
            raise Invalid("this safe requires a passphrase")
        return None
    if not isinstance(raw, str):
        raise Invalid("password must be a string")
    return Secret(raw)


def do_unlock(entry, req, ctx, *, safe_id):
    """Gate -> lockout -> derive -> MAC -> handle. The failure path has a floor.

    The credentials are zeroed in a `finally` that runs before this returns, so
    by the time a response is serialised there is no live `Secret` left for
    `redact()` to catch — which is what keeps the blanket filter over stdout
    from mangling a legitimate `reveal` (I14, I15).

    `bad-credential` covers a wrong passphrase AND a failed MAC with the same
    detail string, because distinguishing them is a decryption oracle (I6). The
    distinction, where a backend can even see one, belongs in the audit log.
    """
    cls = load_backend_class(entry["format"])
    lockout_check(safe_id)

    floor = FailFloor(fail_floor_seconds(ctx.ident))
    password = keyfile = None
    try:
        try:
            password = _password_secret(entry, req)
            keyfile = _keyfile_secret(entry, req)
            backend = cls(entry)
            result = backend.unlock(password, keyfile,
                                    session=req.get("session"))
        except BadCredential:
            fails, delay = lockout_fail(safe_id)
            ctx.note = "credential-rejected"
            floor.wait()
            raise
        except SecretsError:
            # Everything else — a header that will not parse, a clamp refusal,
            # a missing file — also waits out the floor. Returning those faster
            # than a real attempt is the timing oracle the flat error taxonomy
            # was designed to close (I16).
            floor.wait()
            raise
        except Exception as exc:                               # noqa: BLE001
            floor.wait()
            raise Internal("the %s backend raised %s during unlock"
                           % (entry["format"], type(exc).__name__))
    finally:
        for item in (password, keyfile):
            if item is not None:
                item.zero()

    lockout_reset(safe_id)
    if not isinstance(result, dict):
        raise Internal("the backend returned a malformed unlock result")
    return backend, result


def _session_ttl(req):
    """Absolute lifetime for a handle, clamped. Requests may shorten it, never
    extend it past the built-in ceiling."""
    want = req.get("max_seconds")
    ttl = SESSION_MAX_SECONDS
    if _is_int(want):
        ttl = max(SESSION_MAX_MIN, min(int(want), SESSION_MAX_MAX))
    return ttl


def need_backend(req, ctx, *, verb, write=False):
    """Resolve a request to an unlocked backend. Returns (backend, entry, kind).

    Two shapes are legal, and both re-run the class gate here rather than
    trusting whatever ran when the handle was minted (I3):

      handle          — an `open` session that already unlocked this safe
      safe + password — a single-shot verb that unlocks, acts and exits, which
                        is the DEFAULT and is what makes the passphrase prompted
                        every time (docs/ARCHITECTURE.md)

    `kind` is "session" or "transient"; a transient backend is locked by the
    caller when the verb is done.
    """
    handle = req.get("handle")
    if handle:
        sess = find_session(handle, ctx.ident)
        ctx.safe_id = sess.safe
        gate(sess.entry, ctx.ident, want_write=write)
        return sess.backend, sess.entry, "session"

    safe_id = req.get("safe")
    entry = lookup_safe(safe_id, ctx)
    ctx.safe_id = entry["id"]
    gate(entry, ctx.ident, want_write=write)
    resolved = resolve_entry(entry, ctx.ident)
    backend, _ = do_unlock(resolved, req, ctx, safe_id=entry["id"])
    return backend, resolved, "transient"


# ===========================================================================
# the verbs
# ===========================================================================

class Ctx:
    """Per-invocation state. Not a place to put anything a verb should re-derive
    — `ident` is re-read from the kernel once per process and the gate consults
    it on every verb, but nothing here is authority for an access decision."""

    __slots__ = ("ident", "registry", "registry_errors", "args", "in_session",
                 "safe_id", "note", "harden")

    def __init__(self, ident, args, harden):
        self.ident = ident
        self.args = args
        self.harden = harden
        self.registry = {}
        self.registry_errors = []
        self.in_session = False
        self.safe_id = None
        self.note = ""

    def load(self):
        self.registry, self.registry_errors = load_registry(self.ident)
        for err in self.registry_errors:
            _note("registry: %s: %s" % (err["file"], err["error"]))
        return self


def _int_field(req, name, default, lo, hi):
    value = req.get(name, default)
    if value is None:
        return default
    if not _is_int(value):
        raise Invalid("%s must be an integer" % name)
    return max(lo, min(int(value), hi))


# ------------------------------------------------------------- meta -------

def v_schema(req, ctx):
    """The single source of truth for the UI. Static, so it is safe to call
    unauthenticated and cheap to cache in the browser."""
    return build_schema()


def v_health(req, ctx):
    """What actually works here, with reasons — never a claim.

    `mlockall` failing is normal for the unescalated path and is reported as a
    failure rather than swallowed: claiming a defence you do not have is worse
    than not having it (I14).
    """
    state = init_state(ctx.ident)
    # Probe the schema gate even when the registry was refused outright, so the
    # report says which validator WOULD run rather than "builtin-only" because
    # nothing was validated.
    try:
        _schema_validator(registry_root())
    except SecretsError:
        pass
    return {
        "version": VERSION,
        "base_version": BASE_VERSION,
        "schema_version": SCHEMA_VERSION,
        "backends": {fmt: backend_health(fmt) for fmt in FORMATS},
        "registry_errors": ctx.registry_errors,
        "registry_root": registry_root(),
        "registry_entries": len(ctx.registry),
        "registry_gate": dict(_SCHEMA_GATE),
        "library_root": LIB_ROOT,
        "library_root_trusted": LIB_ROOT_TRUSTED,
        "identity": ctx.ident.as_dict(),
        "hardening": ctx.harden,
        "state": {
            "state_dir": state["state_dir"],
            "audit_log": state["audit_log"],
            "lockout_persisted": state["state_persisted"],
            "audit_persisted": state["audit_persisted"],
            "reason": state["reason"],
        },
        "policy": {
            "fail_floor_seconds": fail_floor_seconds(ctx.ident),
            "fail_floor_default": Limits.FAIL_FLOOR_SECONDS,
            "lockout_threshold": LOCKOUT_THRESHOLD,
            "lockout_max_seconds": LOCKOUT_MAX_SECONDS,
            "reveal_seconds": Limits.REVEAL_SECONDS,
            "session_idle_seconds": SESSION_IDLE_SECONDS,
            "session_max_seconds": SESSION_MAX_SECONDS,
            "max_request_bytes": Limits.MAX_REQUEST_BYTES,
        },
        "debug": DEBUG,
    }


def v_audit_tail(req, ctx):
    """The tail of the audit log: metadata only, and only what this uid wrote —
    the log this caller can read is the one their own euid owns."""
    n = _int_field(req, "n", ctx.args.n, 1, AUDIT_TAIL_MAX)
    state = init_state(ctx.ident)
    path = state["audit_log"]
    rows = []
    if path:
        try:
            with open(path, "rb") as fh:
                fh.seek(0, os.SEEK_END)
                size = fh.tell()
                fh.seek(max(0, size - AUDIT_TAIL_BYTES))
                blob = fh.read(AUDIT_TAIL_BYTES)
        except OSError:
            blob = b""
        for line in blob.decode("utf-8", "replace").splitlines()[-n:]:
            line = line.strip()
            if not line:
                continue
            try:
                doc = json.loads(line)
            except ValueError:
                continue
            if isinstance(doc, dict):
                # Re-project onto the known key set. A log line is a file on
                # disk, and a file on disk is attacker-shaped the moment anyone
                # else can append to it.
                rows.append({k: doc.get(k) for k in _AUDIT_KEYS})
    return {"entries": rows, "path": path, "count": len(rows)}


# ------------------------------------------------------------ safes -------

def v_list(req, ctx):
    """Every registered safe, with the reason it is not usable right now.

    Admin safes are LISTED to a non-admin caller and marked locked with a
    reason, because the page is more honest when it says "there is a safe here
    you cannot open" than when it pretends the safe does not exist. Nothing in
    this response is a secret: no path, no key file, no group list.
    """
    out = []
    for sid in sorted(ctx.registry):
        entry = ctx.registry[sid]
        reason, usable = "", True
        try:
            gate(entry, ctx.ident)
        except SecretsError as exc:
            reason, usable = exc.detail, False
        fmt_ok = backend_health(entry["format"])
        if usable and not fmt_ok["available"]:
            reason, usable = fmt_ok["reason"], False
        live = any(s.safe == sid and s.uid == ctx.ident.euid
                   for s in HANDLES.values())
        out.append({
            "id": sid,
            "label": entry["label"],
            "format": entry["format"],
            "access": entry["access"],
            "mode": entry["mode"],
            "locked": not live,
            "reason": reason,
            "usable": usable,
            "password_required": entry["password_required"],
            "needs_keyfile": bool(entry["keyfile"]) or entry["yubikey_slot"] is not None,
            "agent_enabled": bool(entry["agent"]["enabled"]),
            "export_allowed": entry["export_allowed"],
        })
    return {"safes": out, "registry_errors": len(ctx.registry_errors)}


def _guard_file(entry, ctx):
    """Open the safe once through the O_NOFOLLOW/fstat guard and close it.

    This is for the ERROR, not for the enforcement: the backend re-opens through
    exactly the same guard, and it is that open which decides anything. Doing it
    here means a missing file, a wrong owner or a symlink is a clean answer from
    the helper with an audit note that says which of the two refused — the class
    gate or the file — instead of both showing up as "class-refused" (I5, I15).
    """
    try:
        open_safe_fd(entry["path"]).close()
    except AccessDenied:
        ctx.note = "file-refused"
        raise


def v_probe(req, ctx):
    """Header-level facts about a safe, with no credentials involved.

    The file is opened and validated first so a missing or ill-owned file is a
    clean not-found / access-denied from the helper rather than whatever the
    backend makes of it. The backend re-opens through the same guard; this
    early open is for the error message, never for enforcement (I5).
    """
    entry = lookup_safe(req.get("safe"), ctx)
    ctx.safe_id = entry["id"]
    gate(entry, ctx.ident)
    resolved = resolve_entry(entry, ctx.ident)
    cls = load_backend_class(resolved["format"])
    _guard_file(resolved, ctx)
    out = cls(resolved).probe()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed probe result")
    out.setdefault("warnings", [])
    out["id"] = entry["id"]
    out["access"] = entry["access"]
    out["mode"] = entry["mode"]
    if entry["mode"] == "ro":
        out["writable"] = False
        out["warnings"] = list(out["warnings"]) + [
            "registered read-only in /etc/cockpit-secrets/safes.d"]
    return scrub_listing(out, "probe")


def v_unlock(req, ctx):
    """Derive, verify, and mint a handle bound to (uid, safe, pid).

    Outside an `open` session the handle returned here is already dead by the
    time the caller reads it: the process exits with the response. That is not
    a wart, it is the guarantee — see docs/ARCHITECTURE.md. Single-shot verbs
    carry their credentials instead, which is what "prompted every time" means.
    """
    entry = lookup_safe(req.get("safe"), ctx)
    ctx.safe_id = entry["id"]
    gate(entry, ctx.ident)
    resolved = resolve_entry(entry, ctx.ident)
    _guard_file(resolved, ctx)
    backend, result = do_unlock(resolved, req, ctx, safe_id=entry["id"])

    ttl = _session_ttl(req)
    sess = new_session(entry["id"], ctx.ident, backend, resolved, ttl)
    out = scrub_listing(dict(result), "unlock")
    out["handle"] = sess.handle
    out["expires_in"] = sess.expires_in()
    out.setdefault("entries_total", 0)
    out.setdefault("groups_total", 0)
    warnings = list(out.get("warnings") or [])
    if not ctx.in_session:
        warnings.append(
            "this handle dies with the helper process; use the open session "
            "for a flow that spans several verbs")
    out["warnings"] = warnings
    out["session"] = ctx.in_session
    return out


def v_lock(req, ctx):
    """Idempotent. With a handle it locks that session; without one there is
    nothing to lock, which is the normal state of this program."""
    handle = req.get("handle")
    if not handle:
        return {"ok": True, "locked": 0}
    sess = find_session(handle, ctx.ident)
    ctx.safe_id = sess.safe
    drop_session(sess)
    return {"ok": True, "locked": 1}


# ----------------------------------------------------------- browsing -----

def v_tree(req, ctx):
    backend, entry, kind = need_backend(req, ctx, verb="tree")
    try:
        out = backend.tree()
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed tree result")
    return scrub_listing(out, "tree")


def v_entries(req, ctx):
    """Metadata only. `reveal` is the only door to a value (contract invariant
    1), and `scrub_listing` enforces that on the way out."""
    group = req.get("group")
    query = req.get("query")
    if group is not None and not isinstance(group, str):
        raise Invalid("group must be a string")
    if query is not None and not isinstance(query, str):
        raise Invalid("query must be a string")
    if isinstance(query, str) and len(query) > 256:
        raise Invalid("query must be 256 characters or fewer")
    offset = _int_field(req, "offset", 0, 0, 1000000)
    limit = _int_field(req, "limit", 100, 1, 1000)
    backend, entry, kind = need_backend(req, ctx, verb="entries")
    try:
        out = backend.entries(group=group, query=query, offset=offset,
                              limit=limit)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed entries result")
    out.setdefault("total", len(out.get("entries") or []))
    out["offset"], out["limit"] = offset, limit
    return scrub_listing(out, "entries")


_FIELD_RE = re.compile(r"^(password|username|url|notes|title|totp"
                       r"|custom:[^\x00-\x1f]{1,128})$")


def v_reveal(req, ctx):
    """THE ONLY DOOR. One field, one entry, one audit line, no title logged."""
    uuid = req.get("uuid")
    field = req.get("field")
    if not isinstance(uuid, str) or not uuid:
        raise Invalid("uuid is required")
    if not isinstance(field, str) or not _FIELD_RE.match(field):
        raise Invalid("field must be one of password, username, url, notes, "
                      "title, totp, or custom:<name>")
    backend, entry, kind = need_backend(req, ctx, verb="reveal")
    try:
        out = backend.reveal(uuid, field)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict) or "value" not in out:
        raise Internal("the backend returned a malformed reveal result")
    # `field` ECHOES THE REQUEST, always. The two backends disagreed here:
    # kdbx answered a request for "password" with the KeePass field name
    # "Password", psafe3 answered with "password". A caller reading frames off
    # a session stream pairs a response to a request by this key, so it has to
    # mean one thing regardless of which backend served it. The backend's own
    # resolved name is not thrown away — it moves to `resolved_field`, which is
    # where a UI can show "this came from the KeePass field 'Password'".
    resolved = out.get("field")
    if isinstance(resolved, str) and resolved and resolved != field:
        out["resolved_field"] = resolved
    out["field"] = field
    out.setdefault("expires_in", Limits.REVEAL_SECONDS)
    return out


def v_totp(req, ctx):
    uuid = req.get("uuid")
    if not isinstance(uuid, str) or not uuid:
        raise Invalid("uuid is required")
    backend, entry, kind = need_backend(req, ctx, verb="totp")
    try:
        out = backend.totp(uuid)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed totp result")
    return out


def v_attach_get(req, ctx):
    """Attachment bytes stream back through the Cockpit channel to the browser.
    Nothing lands on this host's disk, and no destination path is accepted from
    the caller — that whole shape is the I21 exfiltration channel."""
    uuid = req.get("uuid")
    name = req.get("name")
    if not isinstance(uuid, str) or not uuid:
        raise Invalid("uuid is required")
    if not isinstance(name, str) or not name or len(name) > 255:
        raise Invalid("name is required and must be 255 characters or fewer")
    backend, entry, kind = need_backend(req, ctx, verb="attach-get")
    try:
        out = backend.attach_get(uuid, name)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed attachment result")
    return out


# ----------------------------------------------------------- mutation -----

def _mutate(req, ctx, verb, fn):
    """Run one mutating verb, and refuse the shape that would silently lose it.

    Mutations are in-memory until `save` (contract invariant 3). A single-shot
    invocation that mutates and exits therefore discards the change with the
    address space — a no-op that looks like a success, which is the worst kind.
    So a mutation outside an `open` session is refused unless the request opts
    in to `autosave`, which makes unlock -> mutate -> save one explicit,
    auditable operation.
    """
    autosave = bool(req.get("autosave"))
    if not req.get("handle") and not autosave:
        raise Invalid("a mutation outside an open session would be discarded "
                      "when the helper exits; open a session, or set autosave "
                      "to unlock, change and save in one operation")
    backend, entry, kind = need_backend(req, ctx, verb=verb, write=True)
    try:
        out = fn(backend)
        if not isinstance(out, dict):
            raise Internal("the backend returned a malformed %s result" % verb)
        out = scrub_listing(out, verb)
        if kind == "transient":
            saved = backend.save(
                override_stale=bool(req.get("override_stale")))
            out["saved"] = True
            out["backup"] = (saved or {}).get("backup")
            out["bytes"] = (saved or {}).get("bytes")
        else:
            out["saved"] = False
            sess = find_session(req.get("handle"), ctx.ident)
            sess.mutated = True
        return out
    finally:
        if kind == "transient":
            backend.lock()


def _require_str(req, name, maxlen=1024, optional=False):
    value = req.get(name)
    if value is None and optional:
        return None
    if not isinstance(value, str) or not value:
        raise Invalid("%s is required" % name)
    if len(value) > maxlen:
        raise Invalid("%s must be %d characters or fewer" % (name, maxlen))
    return value


def _require_group(req, name):
    """A GROUP ID, which is not the same shape as an entry uuid.

    A group id is whatever `tree` put in a row's `uuid`, and for one of the two
    formats that includes the empty string: PWS3 gives groups no uuid, so a
    group IS its '.'-delimited path and the root's path is "". Validating it
    with _require_str() rejected "" as missing and made the PWS3 root
    unreachable — `move` into it answered {"error":"invalid","detail":"group is
    required"} for a request the backend would have honoured. Both backends
    resolve None and "" to their own root, so both are passed through as the
    caller sent them; neither is coerced into the other.
    """
    value = req.get(name)
    if value is None:
        return None
    if not isinstance(value, str):
        raise Invalid("%s must be a string" % name)
    if len(value) > 1024:
        raise Invalid("%s must be 1024 characters or fewer" % name)
    return value


def _require_obj(req, name):
    value = req.get(name)
    if not isinstance(value, dict) or not value:
        raise Invalid("%s must be a non-empty object" % name)
    return value


def v_add(req, ctx):
    group = req.get("group")
    if group is not None and not isinstance(group, str):
        raise Invalid("group must be a string")
    entry_obj = _require_obj(req, "entry")
    return _mutate(req, ctx, "add", lambda b: b.add(group, entry_obj))


def v_edit(req, ctx):
    uuid = _require_str(req, "uuid")
    changes = _require_obj(req, "changes")
    return _mutate(req, ctx, "edit", lambda b: b.edit(uuid, changes))


def v_move(req, ctx):
    uuid = _require_str(req, "uuid")
    group = _require_group(req, "group")
    return _mutate(req, ctx, "move", lambda b: b.move(uuid, group))


def v_rm(req, ctx):
    uuid = _require_str(req, "uuid")
    permanent = bool(req.get("permanent"))
    return _mutate(req, ctx, "rm", lambda b: b.rm(uuid, permanent=permanent))


def v_group_add(req, ctx):
    parent = _require_group(req, "parent")
    name = _require_str(req, "name", maxlen=255)
    return _mutate(req, ctx, "group-add", lambda b: b.group_add(parent, name))


def v_group_rm(req, ctx):
    uuid = _require_str(req, "uuid")
    permanent = bool(req.get("permanent"))
    return _mutate(req, ctx, "group-rm",
                   lambda b: b.group_rm(uuid, permanent=permanent))


def v_group_mv(req, ctx):
    uuid = _require_str(req, "uuid")
    parent = _require_group(req, "parent")
    return _mutate(req, ctx, "group-mv", lambda b: b.group_mv(uuid, parent))


def v_save(req, ctx):
    """Session-only on purpose: an unlock-then-save with no mutation between
    them rewrites the file for nothing, and rewriting a password safe for
    nothing is how a backup ring fills with identical generations."""
    handle = req.get("handle")
    if not handle:
        raise Invalid("save needs a handle from an open session; a single-shot "
                      "mutation should use autosave instead")
    sess = find_session(handle, ctx.ident)
    ctx.safe_id = sess.safe
    gate(sess.entry, ctx.ident, want_write=True)
    # A stale `.lock`/`.plk` — the debris a helper killed mid-save leaves —
    # otherwise makes the safe permanently un-savable, because LockFile removes
    # only a lock still carrying OUR token and has no timeout heuristic (I13,
    # deliberately). The override is per-call, explicit, never inferred, and
    # the schema marks the field so the UI has to ask before sending it.
    out = sess.backend.save(override_stale=bool(req.get("override_stale")))
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed save result")
    sess.mutated = False
    out.setdefault("ok", True)
    out.setdefault("conflict", False)
    return scrub_listing(out, "save")


# -------------------------------------------------------------- tools -----

#: No quote, backslash or space: those are the characters that get mangled by a
#: shell, a CSV export or a config file somewhere downstream, and a password
#: that cannot be pasted is a password that gets written down.
GEN_SYMBOLS = "!#$%&()*+,-./:;<=>?@[]^_{|}~"
#: Removed when exclude_ambiguous is on — the pairs people mistype off a screen.
GEN_AMBIGUOUS = "0OoIl1|`',\";:.{}[]()"
GEN_CLASSES = (
    ("upper", "ABCDEFGHIJKLMNOPQRSTUVWXYZ"),
    ("lower", "abcdefghijklmnopqrstuvwxyz"),
    ("digits", "0123456789"),
    ("symbols", GEN_SYMBOLS),
)


def v_generate(req, ctx):
    """A password from `secrets.SystemRandom`, with the entropy calculation.

    `random` is a Mersenne Twister: 624 outputs recover the state and every
    password it ever generates, before or after. `SystemRandom.choice` draws
    from the OS CSPRNG through `_randbelow`, which rejection-samples rather
    than taking a modulus, so every character is uniform over the alphabet and
    the reported entropy is the real figure.
    """
    policy = req.get("policy")
    if policy is None:
        policy = {}
    if not isinstance(policy, dict):
        raise Invalid("policy must be an object")

    length = policy.get("length", 20)
    if not _is_int(length) or not 8 <= length <= 256:
        raise Invalid("policy.length must be an integer between 8 and 256")

    wanted = []
    for name, chars in GEN_CLASSES:
        default = name != "symbols" or True
        flag = policy.get(name, default if name != "symbols" else True)
        if not isinstance(flag, bool):
            raise Invalid("policy.%s must be true or false" % name)
        if flag:
            wanted.append((name, chars))
    if not wanted:
        raise Invalid("at least one character class must be enabled")

    custom = policy.get("symbol_set")
    if custom is not None:
        if not isinstance(custom, str) or not 1 <= len(custom) <= 128:
            raise Invalid("policy.symbol_set must be 1..128 characters")
        wanted = [(n, custom if n == "symbols" else c) for n, c in wanted]

    exclude = policy.get("exclude_ambiguous", True)
    require_each = policy.get("require_each", True)
    for name, flag in (("exclude_ambiguous", exclude),
                       ("require_each", require_each)):
        if not isinstance(flag, bool):
            raise Invalid("policy.%s must be true or false" % name)

    pools = []
    for name, chars in wanted:
        pool = "".join(dict.fromkeys(
            c for c in chars
            if not (exclude and c in GEN_AMBIGUOUS)))
        if pool:
            pools.append((name, pool))
    if not pools:
        raise Invalid("every selected character class is empty after "
                      "excluding ambiguous characters")

    alphabet = "".join(dict.fromkeys("".join(p for _, p in pools)))
    if len(alphabet) < 2:
        raise Invalid("the alphabet must have at least two characters")
    if require_each and length < len(pools):
        raise Invalid("policy.length is shorter than the number of required "
                      "character classes")

    rng = _sysrandom.SystemRandom()
    value = None
    for _ in range(10000):
        candidate = "".join(rng.choice(alphabet) for _ in range(length))
        if not require_each or all(any(c in pool for c in candidate)
                                   for _, pool in pools):
            value = candidate
            break
    if value is None:
        raise Internal("the generator could not satisfy its own policy")

    bits = length * math.log2(len(alphabet))
    out = {
        "value": value,
        "length": length,
        "alphabet_size": len(alphabet),
        "entropy_bits": round(bits, 1),
        "calculation": "%d characters x log2(%d) = %.1f bits"
                       % (length, len(alphabet), bits),
        "classes": [name for name, _ in pools],
        "source": "secrets.SystemRandom (the OS CSPRNG), rejection sampled",
        "note": "",
    }
    if require_each:
        out["note"] = ("requiring one of each class rejects some strings, so "
                       "the true entropy is a fraction of a bit below the "
                       "figure above")
    return out


# ===========================================================================
# the `schema` verb — the single source of truth for the UI
# ===========================================================================
#
# Same shape as cockpit-wireguard's contract v2 and cockpit-adlab's verb table,
# merged into the five keys docs/CONTRACT.md fixes for this project:
#
#     { version, verbs[], groups[], fields[], enums{} }
#
# The rule the UI agent works to: **render nothing that is not in here.** Every
# control, bound, option, placeholder, help string and `breaks_when_wrong` hint
# comes from this verb, so adding a field to the helper adds it to the page with
# no JS change — and anything omitted here cannot appear in the UI at all.
#
# Two keys are specific to this project and the UI must implement both:
#
#   "secret": true      the value is a credential. Render type=password with
#                       autocomplete="off", never put it in a storage API, never
#                       in a data-attribute, never in a global, and overwrite the
#                       variable after the spawn (I11).
#   "options_from"      the option list is not static. "list.safes" means "call
#                       the list verb"; "tree.groups" means "call tree". The
#                       schema cannot know the registry, and inventing the list
#                       in JS is exactly what this design forbids.

CONTROLS = ("text", "password", "number", "toggle", "select", "radio",
            "textarea", "tags", "search", "object", "file-bytes", "readonly",
            "password-reveal", "hidden")


def fld(fid, label, control, **kw):
    """One field. Every key the UI may read is present on every field, with
    null where it does not apply — a renderer that has to test for the presence
    of a key is a renderer that will one day guess."""
    out = {
        "id": fid,
        "label": label,
        "control": control,
        "type": kw.get("type", "string"),
        "required": kw.get("required", False),
        "secret": kw.get("secret", False),
        "default": kw.get("default", None),
        "min": kw.get("min", None),
        "max": kw.get("max", None),
        "maxlength": kw.get("maxlength", None),
        "options": kw.get("options", None),
        "options_from": kw.get("options_from", None),
        "pattern": kw.get("pattern", None),
        "placeholder": kw.get("placeholder", ""),
        "help": kw.get("help", ""),
        "breaks_when_wrong": kw.get("breaks_when_wrong", None),
        "unit": kw.get("unit", None),
        "fields": kw.get("fields", None),
        "partial": kw.get("partial", False),
    }
    if control not in CONTROLS:
        raise Internal("schema field %r uses an unknown control" % fid)
    return out


