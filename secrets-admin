#: THE SECOND COUNTER, and why there are two (I40).
#:
#: The per-principal counter above is keyed on `ident.real_uid` — the human
#: behind the escalation — because keying it on euid gave every administrator
#: ONE counter per admin safe, so operator A's typo refused operator B with the
#: correct passphrase. That is the accountability fix and it is the right key.
#:
#: It is not, on its own, a brake. `real_uid` comes from SUDO_UID/PKEXEC_UID,
#: which are only believed at euid 0 — but a caller who HAS reached euid 0 can
#: present a different one per attempt and collect a fresh counter every time.
#: A lockout an attacker resets by changing one number is theatre, so the
#: per-principal counter is paired with a per-SAFE one that no identity resets.
#:
#: It is a FIXED-WINDOW RATE CAP, not a second lockout, and the difference is
#: the whole reason it is safe to have: at most SAFE_THRESHOLD credential
#: attempts against one safe per SAFE_WINDOW seconds, from all principals
#: together, and the longest anyone can be denied by it is one window. A
#: counter with the per-principal escalation would let one bad actor deny a
#: safe to every operator for 15 minutes, which is a worse hazard than the one
#: it closes.
LOCKOUT_SAFE_THRESHOLD = 20
LOCKOUT_SAFE_WINDOW = 60.0

#: How long a helper waits for the counter's `flock` before giving up (I39).
#: Every critical section under that lock is a read and a write of one small
#: JSON file with nothing blocking in between, so the real wait is microseconds
#: and this bound only ever fires for a foreign holder.
LOCKOUT_LOCK_SECONDS = 5.0

# ------------------------------------------------------------- session ----

#: `open` session idle timeout: the channel is silent this long and the process
#: exits, taking the unlock with it. Deliberately short — this is the one place
#: the project keeps a key alive across verbs.
SESSION_IDLE_SECONDS = 120
#: Absolute lifetime of an `open` session, not extendable by activity.
SESSION_MAX_SECONDS = 900
SESSION_IDLE_MIN, SESSION_IDLE_MAX = 10, 600
SESSION_MAX_MIN, SESSION_MAX_MAX = 30, 3600

# ------------------------------------------------------------- limits -----

#: A registry entry is a few hundred bytes. Anything larger is not a config
#: file, and reading it before parsing is a cheap way to be sure.
MAX_REGISTRY_FILE_BYTES = 64 * 1024
MAX_REGISTRY_FILES = 512
#: audit-tail: bound both the request and the bytes read off the end of the log.
AUDIT_TAIL_MAX = 1000
AUDIT_TAIL_BYTES = 4 * 1024 * 1024

DEBUG = os.environ.get("COCKPIT_SECRETS_DEBUG") == "1"

# ===========================================================================
# output framing — one JSON object, redacted, and nothing else  (I15)
# ===========================================================================

def _note(msg):
    """Diagnostics to stderr. stdout carries exactly one JSON object."""
    try:
        sys.stderr.write("secrets-admin: %s\n" % redact(str(msg)))
    except Exception:                                          # noqa: BLE001
        pass


def emit(obj):
    """Write ONE JSON object to stdout, through the redaction filter.

    `ensure_ascii=False` is deliberate: with the default, a non-ASCII passphrase
    that somehow reached a response would be escaped to \\uXXXX and would slip
    straight past `redact()`, which matches text. Emitting real UTF-8 keeps the
    safety net able to see what it is supposed to catch.

    The net only works if credentials are already zeroed by the time a response
    is built — otherwise a revealed value that happens to equal the master
    passphrase would come back as "***". Every verb zeroes its `Secret`s in a
    `finally` before returning, which is also what I14 wants.
    """
    text = json.dumps(obj, ensure_ascii=False, sort_keys=False)
    try:
        sys.stdout.write(redact(text) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        # The Cockpit channel went away mid-answer. Nothing to report to, and a
        # traceback here would be the only thing this program ever printed that
        # was not one JSON object.
        raise SystemExit(0)


def _iso_utc(when=None):
    ts = datetime.datetime.fromtimestamp(
        time.time() if when is None else when, datetime.timezone.utc)
    return ts.strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


# ===========================================================================
# identity — from the kernel, never from the request body  (I2, I3)
# ===========================================================================

class Identity:
    """Who the kernel says is calling, re-derived inside every verb.

    `real_uid` is the human behind an escalation. Cockpit's admin path runs this
    helper through pkexec/sudo, so `getuid()` is 0 there too and the only record
    of who asked is SUDO_UID / PKEXEC_UID. Those are read ONLY when euid is 0:
    an unprivileged caller can set SUDO_UID to anything they like, and believing
    it would turn an environment variable into a group membership.
    """

    __slots__ = ("uid", "euid", "gid", "egid", "groups", "real_uid",
                 "real_name", "escalated", "admin_group", "pid")

    def __init__(self):
        self.uid = os.getuid()
        self.euid = os.geteuid()
        self.gid = os.getgid()
        self.egid = os.getegid()
        self.pid = os.getpid()
        try:
            self.groups = sorted(os.getgroups())
        except OSError:
            self.groups = []
        self.escalated = False
        real = self.uid
        if self.euid == 0:
            for var in ("SUDO_UID", "PKEXEC_UID"):
                raw = os.environ.get(var)
                if raw and raw.isdigit():
                    try:
                        cand = int(raw)
                    except ValueError:
                        continue
                    if 0 < cand < 2 ** 31:
                        real, self.escalated = cand, True
                        break
        self.real_uid = real
        self.real_name = _uid_name(real)
        self.admin_group = _host_admin_group()

    def as_dict(self):
        """What `health` may show. No environment, no command line."""
        return {"uid": self.uid, "euid": self.euid,
                "real_uid": self.real_uid, "real_user": self.real_name,
                "escalated": self.escalated, "pid": self.pid,
                "admin_group": self.admin_group,
                "class_available": "admin" if self.euid == 0 else "user"}


def _uid_name(uid):
    try:
        return pwd.getpwuid(uid).pw_name
    except (KeyError, OSError, TypeError):
        return None


def _host_admin_group():
    """`sudo` on Debian/Ubuntu, `wheel` on the RPM side. Detected, not assumed —
    edt1 has `sudo` and no `wheel`, and a hardcoded name would silently widen
    the gate to "no group matched" on the other family."""
    for name in ("sudo", "wheel"):
        try:
            grp.getgrnam(name)
            return name
        except (KeyError, OSError):
            continue
    return None


def _in_group(uid, group_name):
    """Membership by primary gid OR supplementary list, resolved for the REAL
    caller — not from os.getgroups(), which behind an escalation is root's."""
    if not group_name:
        return False
    try:
        who = pwd.getpwuid(uid)
    except (KeyError, OSError, TypeError):
        return False
    try:
        gr = grp.getgrnam(group_name)
    except (KeyError, OSError):
        return False
    if who.pw_gid == gr.gr_gid:
        return True
    return who.pw_name in gr.gr_mem


def _resolve_owner(owner):
    """Registry `owner` (uid string, login name, or None/%u) -> uid or None."""
    if owner is None or owner == "%u":
        return None
    if isinstance(owner, str) and owner.isdigit():
        try:
            return int(owner)
        except ValueError:
            return None
    try:
        return pwd.getpwnam(owner).pw_uid
    except (KeyError, OSError, TypeError):
        # An owner we cannot resolve must not become "anybody". The gate treats
        # None-from-a-real-value as a refusal below, so this returns a sentinel.
        return -1


# ===========================================================================
# the access class gate — run inside EVERY verb  (I1, I2, I3)
# ===========================================================================

def gate(entry, ident, *, want_write=False):
    """Refuse the verb unless the kernel agrees this caller may have it.

    Called at the top of every verb and again for every frame inside an `open`
    session. Not once at start-up, and not when the safe list is built: a caller
    who can reach the helper can call any verb in any order, so the check has to
    live where the operation does.

    Nothing in this function reads the request. `access`, `groups` and `owner`
    come from the root-owned registry; `euid`, `real_uid` and group membership
    come from the kernel and /etc/group.
    """
    access = entry.get("access", "admin")

    if access == "admin":
        # I2: the admin class is the one that runs as root, so the euid check is
        # the whole point. `superuser: "require"` in the browser is a request,
        # not a guarantee — this is the guarantee.
        if ident.euid != 0:
            raise AccessDenied(
                "this safe is administrator-class; turn on Cockpit's "
                "Administrative access and try again")
        groups = list(entry.get("groups") or [])
        if not groups:
            groups = [ident.admin_group] if ident.admin_group else []
        # Direct root (no escalation behind it) is administrative by definition;
        # asking /etc/group whether uid 0 is in `sudo` would answer "no" on a
        # perfectly normal host.
        if ident.real_uid != 0:
            if not groups:
                raise AccessDenied(
                    "no administrative group is configured for this safe and "
                    "this host has neither sudo nor wheel")
            if not any(_in_group(ident.real_uid, g) for g in groups):
                raise AccessDenied(
                    "the calling user is not in an administrative group "
                    "permitted to open this safe")
    else:
        # I2 again, from the other side: a root helper opening a file inside a
        # directory the user controls is exactly the symlink race I5 exists for.
        # The user class is served unescalated or not at all.
        if ident.euid == 0:
            raise AccessDenied(
                "this safe is user-class and is not opened by a root helper; "
                "call it without Cockpit's Administrative access")
        want = _resolve_owner(entry.get("owner"))
        if want == -1:
            raise AccessDenied(
                "this safe names an owner that does not exist on this host")
        if want is not None and want != ident.euid:
            raise AccessDenied("this safe belongs to another user")
        # File ownership itself is not asserted here: open_safe_fd fstats the
        # descriptor it opened with expect_uid = this euid, which is the only
        # check that cannot be raced.

    if want_write and entry.get("mode", "rw") == "ro":
        # Three distinct causes of read-only, three distinct codes
        # (docs/CONTRACT.md): registry mode is access-denied; KDBX3 is
        # unsupported; a lossy round trip is conflict. The latter two are the
        # backend's to raise.
        raise AccessDenied("this safe is registered read-only")


# ===========================================================================
# the registry — the only source of safes  (I1, I4)
# ===========================================================================
#
# Two validators run over every entry and BOTH must pass:
#
#   1. `validate_entry()` below — hand written, dependency free, and the actual
#      enforcement point. It is what runs when python3-jsonschema is not
#      installed, so a missing package can never mean "no validation".
#   2. the Draft-07 schema in schema/safe-registry.schema.json, via jsonschema
#      when it is importable. That is the machine-readable half of
#      docs/CONTRACT.md, and running it here is how drift between the document
#      and this file shows up as a dropped entry rather than as a surprise.
#
# The duplication is deliberate and schema/README.md says so: a schema is a
# validator, not an enforcement point, and the only enforcement that counts is
# the one in the process the caller cannot rewrite.

_ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")

#: The stricter pattern a CREATED id must match (C2). Compiled from the string
#: the `schema` verb publishes, so the UI cannot be validating against a
#: different rule than the helper enforces.
#:
#: MATCHED WITH `fullmatch`, ALWAYS. Python's `$` also matches immediately
#: before a trailing newline, so `re.match(r"^[a-z0-9-]+$", "lab-dc\n")`
#: SUCCEEDS — and this id becomes a file name. Everywhere else in this file an
#: id that slips through resolves to a dict key that is not there and answers
#: not-found; here it would reach `os.open`. `fullmatch` has no such corner.
_NEW_ID_RE = re.compile(NEW_ID_PATTERN)

_OWNER_RE = re.compile(r"^(%u|[0-9]{1,10}|[a-z_][a-z0-9_.-]{0,31}\$?)$")
_GROUP_RE = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_.-]*\$?$")
_DOTDOT_RE = re.compile(r"(^|/)\.\.(/|$)")

#: Backup rings under these trees are refused before atomic_replace ever sees
#: them: a backup is exactly as sensitive as the safe, and these are
#: world-writable and usually a different filesystem.
_FORBIDDEN_BACKUP_PREFIXES = ("/tmp/", "/var/tmp/", "/dev/shm/")


def _is_safe_abs_path(value, minlen=2):
    return (isinstance(value, str) and len(value) >= minlen
            and value.startswith("/") and not _DOTDOT_RE.search(value))


def _is_int(value):
    """int, and not a bool. `isinstance(True, int)` is True in Python, which is
    how `"keep": true` becomes a retention ring of one."""
    return isinstance(value, int) and not isinstance(value, bool)


def _sub_object(raw, key, spec, default):
    """Validate a nested object with additionalProperties:false semantics."""
    value = raw.get(key, None)
    if value is None and key not in raw:
        return dict(default), None
    if not isinstance(value, dict):
        return None, "%s must be an object" % key
    unknown = sorted(set(value) - set(spec))
    if unknown:
        return None, "%s has unknown key %s" % (key, unknown[0])
    out = dict(default)
    for name, (kind, lo, hi) in spec.items():
        if name not in value:
            continue
        got = value[name]
        if kind == "bool":
            if not isinstance(got, bool):
                return None, "%s.%s must be true or false" % (key, name)
        elif kind == "int":
            if not _is_int(got):
                return None, "%s.%s must be an integer" % (key, name)
            if got < lo or got > hi:
                return None, ("%s.%s must be between %d and %d"
                              % (key, name, lo, hi))
        elif kind == "path_or_null":
            if got is not None and not _is_safe_abs_path(got):
                return None, ("%s.%s must be an absolute path with no '..'"
                              % (key, name))
        out[name] = got
    return out, None


AGENT_DEFAULT = {"enabled": False, "idle_seconds": 300, "max_seconds": 3600}
BACKUP_DEFAULT = {"keep": 10, "dir": None}

_AGENT_SPEC = {"enabled": ("bool", 0, 0),
               "idle_seconds": ("int", 30, 3600),
               "max_seconds": ("int", 60, 86400)}
_BACKUP_SPEC = {"keep": ("int", 1, 100),
                "dir": ("path_or_null", 0, 0)}

_KNOWN_KEYS = ("id", "label", "format", "path", "access", "owner", "groups",
               "mode", "password_required", "keyfile", "yubikey_slot",
               "agent", "export_allowed", "export_dir", "breach_corpus",
               "backup",
               # PROVENANCE, added with the verbs that write it (I46). Optional
               # and absent from every hand-written entry, so nothing existing
               # changes; but a shipped example carrying them was being dropped
               # as "unknown key" while jsonschema accepted it, which is the
               # helper and its own schema file disagreeing about the trust
               # root. They are advisory: nothing is granted on their basis and
               # `safe-delete`'s gate is DERIVED from the id, not read from
               # here — see `v_safe_delete`.
               "origin", "created_utc", "source")

#: `export_dir` and `breach_corpus` were once tolerated as "schema drift": the
#: helper validated them, the installed schema/safe-registry.schema.json did
#: not list them, and `additionalProperties:false` would have dropped the whole
#: entry on a host whose schema file lagged the helper. That accommodation is
#: GONE, because the schema file now declares both. What it cost while it
#: existed is why it is not coming back: an unknown key is a typo far more
#: often than it is a new feature, and `"acess": "user"` half-applied is the
#: permissive half. An unknown key drops the entry (I1). The remedy for a
#: helper that gains a field is to ship the schema file with it, which is what
#: install.sh does.


#: RFC-3339 with a literal trailing `Z`, matching the pattern
#: `schema/safe-registry.schema.json` declares for `created_utc` and
#: `source.inspected_utc`. Written out here rather than imported so the two
#: gates are the same rule spelled the same way twice, which is the whole
#: point of re-checking anything the schema already checks.
_RFC3339Z_RE = re.compile(
    r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?Z")

#: `source.kdf_params` -- integers only, by NAME. `additionalProperties:false`
#: in the schema means a parameter we have no key for here makes the whole
#: entry fail its next load and the operator's safe vanish from `list`, so the
#: writer drops what it cannot name and the loader refuses what it cannot name.
_SOURCE_KDF_KEYS = ("memory_kib", "time", "parallelism", "rounds", "iterations")


def _sub_source(raw):
    """The optional `source` header summary -> (value|None, None) | (None, why).

    Same fail-closed shape as `_sub_object`, and the same reason it is a
    function rather than four lines inline: `import-commit` writes this and the
    loader reads it, and a writer and a reader that disagree about a registry
    key is how an operator's safe disappears.
    """
    if raw is None:
        return None, None
    if not isinstance(raw, dict):
        return None, "source must be an object or null"
    unknown = sorted(set(raw) - {"format_version", "cipher", "kdf",
                                 "kdf_params", "bytes", "sha256_at_import",
                                 "inspected_utc"})
    if unknown:
        return None, "source has no %r key" % unknown[0]
    stamp = raw.get("inspected_utc")
    if not isinstance(stamp, str) or not _RFC3339Z_RE.fullmatch(stamp):
        # Required by the schema, and required here for the reason the schema
        # gives: a header summary with no timestamp invites being read as
        # current.
        return None, "source.inspected_utc is required and must be RFC-3339 Z"
    out = {"inspected_utc": stamp}
    for key, cap in (("format_version", 32), ("cipher", 32), ("kdf", 32)):
        val = raw.get(key)
        if val is None:
            continue
        if not isinstance(val, str) or not 1 <= len(val) <= cap:
            return None, "source.%s must be a string of 1..%d chars" % (key, cap)
        out[key] = val
    if "bytes" in raw:
        if not _is_int(raw["bytes"]) or raw["bytes"] < 0:
            return None, "source.bytes must be a non-negative integer"
        out["bytes"] = int(raw["bytes"])
    if "sha256_at_import" in raw:
        val = raw["sha256_at_import"]
        if not isinstance(val, str) or not re.fullmatch(r"[0-9a-f]{64}", val):
            return None, "source.sha256_at_import must be 64 lower-case hex"
        out["sha256_at_import"] = val
    params = raw.get("kdf_params")
    if params is not None:
        if not isinstance(params, dict):
            return None, "source.kdf_params must be an object"
        bad = sorted(set(params) - set(_SOURCE_KDF_KEYS))
        if bad:
            return None, "source.kdf_params has no %r parameter" % bad[0]
        clean = {}
        for key in _SOURCE_KDF_KEYS:
            if key in params:
                if not _is_int(params[key]) or params[key] < 0:
                    return None, ("source.kdf_params.%s must be a "
                                  "non-negative integer" % key)
                clean[key] = int(params[key])
        out["kdf_params"] = clean
    return out, None


def validate_entry(raw):
    """One registry object -> (entry with defaults applied, None) | (None, why).

    Fails closed in every direction. In particular a missing `access` resolves
    to **admin**, the restrictive class, so a hand-edited file that loses a line
    refuses access rather than granting it (I1).
    """
    if not isinstance(raw, dict):
        return None, "not a JSON object"

    unknown = sorted(set(raw) - set(_KNOWN_KEYS))
    if unknown:
        # additionalProperties:false. A typo like "acess": "user" must be
        # refused outright rather than half-applied — the half that applies
        # would be the permissive half.
        return None, "unknown key %r" % unknown[0]

    for req in ("id", "label", "format", "path"):
        if req not in raw:
            return None, "missing required key %r" % req

    sid = raw["id"]
    if not isinstance(sid, str) or not 1 <= len(sid) <= 63 \
            or not _ID_RE.match(sid):
        # This string reaches file names (the lockout counter, the backup ring)
        # and log lines. Slashes, spaces, '..' and upper case are refused here
        # so path traversal cannot enter through the one identifier the whole
        # access model is keyed on.
        return None, "id must match ^[a-z0-9][a-z0-9._-]*$ and be 1..63 chars"

    label = raw["label"]
    if not isinstance(label, str) or not 1 <= len(label) <= 128:
        return None, "label must be a string of 1..128 characters"

    fmt = raw["format"]
    if fmt not in FORMATS:
        return None, "format must be one of %s" % ", ".join(FORMATS)

    if not _is_safe_abs_path(raw["path"]):
        return None, "path must be absolute, 2+ characters, and free of '..'"

    access = raw.get("access", "admin")
    if access not in ("admin", "user"):
        return None, "access must be 'admin' or 'user'"

    owner = raw.get("owner", None)
    if owner is not None and (not isinstance(owner, str)
                              or not _OWNER_RE.match(owner)):
        return None, "owner must be null, '%u', a uid, or a login name"

    groups = raw.get("groups", [])
    if not isinstance(groups, list) or len(groups) > 16:
        return None, "groups must be an array of at most 16 names"
    if len(set(map(repr, groups))) != len(groups):
        return None, "groups must not repeat a name"
    for g in groups:
        if not isinstance(g, str) or not 1 <= len(g) <= 32 \
                or not _GROUP_RE.match(g):
            return None, "groups contains an invalid group name"

    mode = raw.get("mode", "rw")
    if mode not in ("rw", "ro"):
        return None, "mode must be 'rw' or 'ro'"

    pw_required = raw.get("password_required", True)
    if not isinstance(pw_required, bool):
        return None, "password_required must be true or false"

    keyfile = raw.get("keyfile", None)
    if keyfile is not None and not _is_safe_abs_path(keyfile):
        return None, "keyfile must be null or an absolute path free of '..'"

    slot = raw.get("yubikey_slot", None)
    if slot is not None and (not _is_int(slot) or slot not in (1, 2)):
        return None, "yubikey_slot must be null, 1 or 2"

    export_allowed = raw.get("export_allowed", False)
    if not isinstance(export_allowed, bool):
        return None, "export_allowed must be true or false"

    export_dir = raw.get("export_dir", None)
    if export_dir is not None and not _is_safe_abs_path(export_dir):
        return None, "export_dir must be null or an absolute path free of '..'"

    breach_corpus = raw.get("breach_corpus", None)
    if breach_corpus is not None and not _is_safe_abs_path(breach_corpus):
        return None, ("breach_corpus must be null or an absolute path free "
                      "of '..'")

    agent, why = _sub_object(raw, "agent", _AGENT_SPEC, AGENT_DEFAULT)
    if why:
        return None, why
    backup, why = _sub_object(raw, "backup", _BACKUP_SPEC, BACKUP_DEFAULT)
    if why:
        return None, why

    # ---- rules the schema cannot express, re-checked here on purpose -----

    if pw_required is False and not (isinstance(keyfile, str) or _is_int(slot)):
        # "password_required": false with no other key registered is not a
        # configuration, it is an unlocked file. The schema refuses it first;
        # this is the enforcement.
        return None, ("password_required:false needs a keyfile or a "
                      "yubikey_slot — otherwise the safe opens with nothing")

    if agent["max_seconds"] < agent["idle_seconds"]:
        # JSON Schema cannot compare two sibling fields. An inverted pair means
        # the absolute lifetime is shorter than the idle timeout, which reads as
        # "no limit at all" to anyone skimming the file (I18).
        return None, "agent.max_seconds must be >= agent.idle_seconds"

    bdir = backup.get("dir")
    if isinstance(bdir, str):
        norm = bdir if bdir.endswith("/") else bdir + "/"
        if any(norm.startswith(p) for p in _FORBIDDEN_BACKUP_PREFIXES):
            return None, ("backup.dir must not be under /tmp, /var/tmp or "
                          "/dev/shm — a backup is as sensitive as the safe")

    if isinstance(export_dir, str):
        # An export is the entire safe in PLAINTEXT. The same rule as the
        # backup ring, for a stronger reason: a world-writable directory is not
        # somewhere to write one, and an operator naming it in the registry
        # does not make it somewhere it is (I21).
        norm = export_dir if export_dir.endswith("/") else export_dir + "/"
        if any(norm.startswith(p) for p in _FORBIDDEN_BACKUP_PREFIXES):
            return None, ("export_dir must not be under /tmp, /var/tmp or "
                          "/dev/shm — an export is the safe in the clear")

    if export_dir is not None and not export_allowed:
        # Not fatal in itself, but it is always a mistake: an export directory
        # on a safe that cannot be exported means somebody set one of the two
        # keys and believes the feature is on. Refusing says so at load time
        # instead of at the moment the operator needs the export.
        return None, ("export_dir is set but export_allowed is false — one of "
                      "the two is not what its author intended")

    # ---- provenance (I46). ADVISORY, and checked anyway ------------------
    #
    # Nothing is granted on the strength of these three and `safe-delete`'s
    # gate is derived from the id rather than read from here — but an entry
    # that carries a malformed one is an entry somebody edited by hand and got
    # wrong, and the loader's whole job is to notice that. They are validated
    # to the same shape `schema/safe-registry.schema.json` declares so the two
    # gates cannot disagree, which is the failure this key set was born in.
    origin = raw.get("origin", "manual")
    if origin is None:
        origin = "manual"
    if origin not in ("manual", "created", "imported"):
        return None, "origin must be 'manual', 'created' or 'imported'"
    created_utc = raw.get("created_utc")
    if created_utc is not None:
        if not isinstance(created_utc, str) \
                or not _RFC3339Z_RE.fullmatch(created_utc):
            return None, ("created_utc must be an RFC-3339 UTC timestamp "
                          "ending in a literal 'Z'")
    source, why = _sub_source(raw.get("source"))
    if why:
        return None, why

    return {
        "id": sid, "label": label, "format": fmt, "path": raw["path"],
        "access": access, "owner": owner, "groups": groups, "mode": mode,
        "password_required": pw_required, "keyfile": keyfile,
        "yubikey_slot": slot, "agent": agent,
        "export_allowed": export_allowed, "export_dir": export_dir,
        "breach_corpus": breach_corpus, "backup": backup,
        "origin": origin, "created_utc": created_utc, "source": source,
    }, None


# ------------------------------------------------- the jsonschema gate ----

_SCHEMA_GATE = {"engine": "builtin-only", "reason": "", "path": None}
_SCHEMA_VALIDATOR = None


def _schema_file_candidates(etc_root):
    here = os.path.dirname(os.path.realpath(__file__))
    out = [os.path.join(etc_root, "schema", SCHEMA_FILE),
           os.path.join(here, "schema", SCHEMA_FILE)]
    if LIB_ROOT:
        out.append(os.path.join(LIB_ROOT, "schema", SCHEMA_FILE))
    out.append(os.path.join("/usr/share/cockpit/secrets/schema", SCHEMA_FILE))
    return out


def _schema_validator(etc_root):
    """Draft7Validator over safe-registry.schema.json, or None.

    None is not "fail open": `validate_entry()` has already run and is the
    enforcement point. This gate only ever REMOVES entries, so its absence
    cannot admit one. `health` reports which engine is live.
    """
    global _SCHEMA_VALIDATOR
    if _SCHEMA_VALIDATOR is not None:
        return _SCHEMA_VALIDATOR
    try:
        import jsonschema                                       # noqa: F401
    except Exception as exc:                                    # noqa: BLE001
        _SCHEMA_GATE["reason"] = ("python3-jsonschema not installed (%s); the "
                                  "built-in validator is the enforcement point"
                                  % type(exc).__name__)
        return None
    for cand in _schema_file_candidates(etc_root):
        try:
            with open(cand, "rb") as fh:
                doc = json.loads(fh.read(1024 * 1024).decode("utf-8"))
        except (OSError, ValueError, UnicodeDecodeError):
            continue
        try:
            _SCHEMA_VALIDATOR = jsonschema.Draft7Validator(doc)
        except Exception as exc:                                # noqa: BLE001
            _SCHEMA_GATE["reason"] = ("schema file is not valid Draft-07 (%s)"
                                      % type(exc).__name__)
            return None
        _SCHEMA_GATE["engine"] = "jsonschema+builtin"
        _SCHEMA_GATE["path"] = cand
        return _SCHEMA_VALIDATOR
    _SCHEMA_GATE["reason"] = "safe-registry.schema.json not found"
    return None


# ------------------------------------------------------- reading files ----

def registry_root():
    """The registry ROOT. `COCKPIT_SECRETS_ETC` overrides it for hermetic tests;
    see the module docstring for why that changes no security property."""
    env = os.environ.get("COCKPIT_SECRETS_ETC")
    if env:
        if not os.path.isabs(env):
            raise Invalid("COCKPIT_SECRETS_ETC must be an absolute path")
        return env.rstrip("/") or "/"
    return DEFAULT_ETC


def user_home(ident):
    """The calling user's home directory. NEVER called at euid 0.

    `COCKPIT_SECRETS_HOME` is the test seam, and it is the safest of the four
    in this file because of WHERE it is reachable from: the only caller is the
    per-user registry, which is read exclusively when `euid != 0`. An
    environment variable that only ever steers an unprivileged process towards
    files that process already owns cannot escalate anything — it names data
    the caller can read anyway. The guard below is belt and braces, and it is
    also the assertion that keeps that sentence true if a caller is ever added.
    """
    if ident.euid == 0:
        # Not a refusal an operator can act on: it is a bug. A root helper has
        # no business resolving a user's home directory, because everything
        # under it is writable by somebody who is not root (I5).
        raise Internal("a root helper does not resolve a home directory")
    env = os.environ.get("COCKPIT_SECRETS_HOME")
    if env:
        if not os.path.isabs(env):
            raise Invalid("COCKPIT_SECRETS_HOME must be an absolute path")
        return env.rstrip("/") or "/"
    try:
        home = pwd.getpwuid(ident.euid).pw_dir
    except (KeyError, OSError):
        home = None
    if not home or not os.path.isabs(home):
        raise AccessDenied("this user has no home directory on this host")
    return home


def user_registry_dir(ident):
    """`~/.config/cockpit-secrets/safes.d` — the per-user registry (C4)."""
    return os.path.join(user_home(ident), *USER_REGISTRY_REL)


def _read_registry_file(dirfd, name, euid, allow_uids=None):
    """Read one safes.d/*.json through the directory fd. Returns (text, why).

    Opened relative to a descriptor on the directory we already validated, with
    O_NOFOLLOW, and checked by fstat on the returned fd — so a symlink swapped
    in after the listing is refused rather than followed (I5).

    `allow_uids` is which uids may own the file. It defaults to "root or the
    caller", which is right for the SYSTEM registry: root writes it, and a
    hermetic test run owns its own copy. The per-user registry passes
    `(euid,)`, because C4 rule 4 says those files must belong to the user whose
    registry it is — a root-owned file sitting inside a user's `~/.config` is
    not a thing that happened on purpose.
    """
    if allow_uids is None:
        allow_uids = (0, euid)
    fd = None
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
                     | getattr(os, "O_NOCTTY", 0), dir_fd=dirfd)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, "not a regular file"
        if st.st_uid not in allow_uids:
            return None, "owned by uid %d (expected root or the caller)" % st.st_uid
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return None, "group- or other-writable"
        if st.st_size > MAX_REGISTRY_FILE_BYTES:
            return None, ("%d bytes exceeds the %d byte cap"
                          % (st.st_size, MAX_REGISTRY_FILE_BYTES))
        data = os.read(fd, MAX_REGISTRY_FILE_BYTES + 1)
        if len(data) > MAX_REGISTRY_FILE_BYTES:
            return None, "larger than the registry file cap"
        return data.decode("utf-8"), None
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            return None, "is a symlink"
        return None, "unreadable (%s)" % errno.errorcode.get(exc.errno, "EIO")
    except UnicodeDecodeError:
        return None, "is not valid UTF-8"
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def load_registry(ident):
    """Load and validate every safes.d entry. Returns (entries, errors).

    `entries` is an ordered dict id -> entry, in lexical file order. `errors` is
    a list of {"file","error"} for everything that was DROPPED — surfaced by
    `health` as `registry_errors[]`, which is the supported way to find out why
    a safe is missing from the list. A dropped entry is never partially applied
    and never defaulted to the permissive class (I1).
    """
    errors = []
    entries = {}
    root = registry_root()
    safes_d = os.path.join(root, SAFES_D)

    if not _trusted_dir(root, ident.euid):
        # A registry an unprivileged user can edit is a registry that grants
        # itself root. Refusing the whole directory is the only correct answer:
        # partially trusting it would mean trusting the part they wrote.
        errors.append({"file": root,
                       "error": "registry root is missing, not a directory, "
                                "not owned by root or this user, or is "
                                "group/other-writable — the whole registry is "
                                "refused"})
        return entries, errors
    if not _trusted_dir(safes_d, ident.euid):
        errors.append({"file": safes_d,
                       "error": "safes.d is missing, not a directory, not "
                                "owned by root or this user, or is "
                                "group/other-writable — the whole registry is "
                                "refused"})
        return entries, errors

    validator = _schema_validator(root)
    entries = _read_registry_dir(safes_d, ident, errors, validator,
                                 source="system")

    # ---- the per-user registry, and the ONE trust-model change (C4) ------
    #
    # THE SAFETY ARGUMENT, WRITTEN WHERE THE LOADER IS, BECAUSE IT IS THE
    # WHOLE JUSTIFICATION FOR THIS DIRECTORY EXISTING.
    #
    # `~/.config/cockpit-secrets/safes.d` is a registry an unprivileged user
    # writes themselves, which is the exact thing I1 says a registry must not
    # be — for the SYSTEM registry, where an entry decides who may open a
    # root-owned file. It is safe here, and only here, because of the four
    # rules enforced below and one fact:
    #
    #   **the helper is running AS that user when it reads this file, and the
    #   only files it can be pointed at are files that user already owns and
    #   can already read.** A user who writes an entry here grants themselves
    #   nothing: they could have read the same bytes with `cat`. It is a
    #   convenience surface — "let me register my own safe without an
    #   administrator" — not a privilege surface.
    #
    # That argument holds ONLY while all four of these hold, and it stops
    # holding the moment any one of them is relaxed:
    #
    #   1. it is read only when `euid != 0`. The root path never opens it, and
    #      the guard is the `if` below, BEFORE the path is even computed;
    #   2. every entry is forced to `access: "user"`, and an entry that
    #      declares `admin` is dropped and reported rather than downgraded;
    #   3. the entry's `path` must pass `open_safe_fd` as this user — their
    #      own file, 0600, no group/other-writable parent (I5);
    #   4. the directory and its files must be owned by this user and not
    #      group- or other-writable, or the whole per-user registry is refused
    #      — the same fail-closed rule the system registry gets.
    #
    # Rule 5 is not about safety but about honesty: a per-user id that collides
    # with a system id loses, and the shadowed entry is REPORTED. Silently
    # preferring either one would let an operator believe they are opening a
    # safe they are not.
    if ident.euid != 0:
        _load_user_registry(ident, entries, errors, validator)
    return entries, errors


def _read_registry_dir(safes_d, ident, errors, validator, *, source,
                       allow_uids=None):
    """Every valid entry in ONE safes.d directory, as {id: entry}.

    Shared by the system registry and the per-user one so the two cannot
    validate differently: the second registry was the moment this loop stopped
    being "the loader" and became "a loader", and two loaders drift.

    Each entry is tagged with the registry it came from (`registry`) and the
    file it came from (`registry_file`). Neither is a registry KEY — the schema
    is `additionalProperties: false` and both would drop the entry — they are
    added after validation, by this file, for `list`/`health` to report and for
    `safe-forget` to know which file to unlink without ever being told a path.
    """
    entries = {}
    dirfd = None
    try:
        dirfd = os.open(safes_d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                        | os.O_CLOEXEC)
        names = sorted(n for n in os.listdir(dirfd) if n.endswith(".json"))
    except OSError as exc:
        errors.append({"file": safes_d,
                       "error": "cannot list (%s)"
                                % errno.errorcode.get(exc.errno, "EIO")})
        if dirfd is not None:
            try:
                os.close(dirfd)
            except OSError:
                pass
        return entries

    try:
        if len(names) > MAX_REGISTRY_FILES:
            errors.append({"file": safes_d,
                           "error": "more than %d entries; only the first %d "
                                    "are read" % (MAX_REGISTRY_FILES,
                                                  MAX_REGISTRY_FILES)})
            names = names[:MAX_REGISTRY_FILES]
        for name in names:
            text, why = _read_registry_file(dirfd, name, ident.euid,
                                            allow_uids=allow_uids)
            if why:
                errors.append({"file": name, "error": why})
                continue
            try:
                raw = json.loads(text)
            except ValueError as exc:
                errors.append({"file": name,
                               "error": "not valid JSON (%s)"
                                        % type(exc).__name__})
                continue
            if source == "user" and isinstance(raw, dict) \
                    and raw.get("access") == "admin":
                # C4 rule 2. DROPPED, not downgraded: a file in the user's own
                # home claiming the administrator class is somebody's mistaken
                # belief about what this directory can do, and honouring the
                # `user` half of it silently would leave them believing it.
                errors.append({
                    "file": name,
                    "error": "a per-user registry entry may not declare "
                             "access:'admin'; the entry is dropped, not "
                             "downgraded"})
                continue
            entry, why = validate_entry(raw)
            if why:
                errors.append({"file": name, "error": why})
                continue
            if validator is not None:
                # EVERY schema error drops the entry. There is no tolerated
                # class of error and no key that is waved through: the gate is
                # `additionalProperties:false`, and an unknown key is a typo
                # far more often than it is a field the helper has and the
                # schema file does not. `"acess": "user"` half-applied is the
                # permissive half, so it is not applied at all (I1).
                schema_errs = sorted(validator.iter_errors(raw), key=str)
                if schema_errs:
                    errors.append({
                        "file": name,
                        "error": "rejected by safe-registry.schema.json: %s"
                                 % str(schema_errs[0].message)[:160]})
                    continue
            if source == "user":
                # C4 rule 2, the forcing half. `validate_entry` has already
                # applied I1's admin default to an entry that omitted the key;
                # this overrides it, and it is the ONLY place in this program
                # where the restrictive default is overridden — which is safe
                # for exactly one reason, stated at the call site: in this
                # directory "user" is not the permissive class, it is the only
                # class, and it grants the caller nothing they did not have.
                entry["access"] = "user"
            entry["registry"] = source
            entry["registry_file"] = name
            # EVERY file that declared this id, not just the winner (I51).
            # `safe-forget` unlinks `registry_file` and answered ok; with two
            # files declaring one id it removed the winner, the loser was
            # promoted on the next load, and the operator was told a safe was
            # unregistered while it stayed fully reachable — with whatever
            # `path`, `access` and `mode` the survivor declares, which need not
            # be the ones they inspected. Carrying the whole list lets forget
            # and delete refuse instead of half-working. Helper-added, like
            # `registry`/`registry_file`, and never a registry KEY.
            entry["registry_files"] = [name]
            if entry["id"] in entries:
                # The lexically last file wins (schema/README.md), but silently
                # is not good enough: a duplicate id means one of the two files
                # is not doing what its author thinks.
                errors.append({"file": name,
                               "error": "duplicate id %r overrides an earlier "
                                        "entry" % entry["id"]})
                entry["registry_files"] = (entries[entry["id"]]
                                           .get("registry_files", []) + [name])
            entries[entry["id"]] = entry
    finally:
        try:
            os.close(dirfd)
        except OSError:
            pass
    return entries


def _load_user_registry(ident, entries, errors, validator):
    """Merge `~/.config/cockpit-secrets/safes.d` into `entries`. See C4.

    Called ONLY from `load_registry`, and only on the `euid != 0` branch. The
    whole safety argument for this directory is in the comment at that call
    site; this function is the four rules it names.
    """
    if ident.euid == 0:                       # rule 1, restated as a guard
        return
    try:
        safes_d = user_registry_dir(ident)
    except SecretsError as exc:
        # No home directory, or an unusable override. Not an error worth
        # reporting on every list: a user with no home simply has no per-user
        # registry. It is still recorded, because "my safe vanished" needs an
        # answer.
        errors.append({"file": "~/" + "/".join(USER_REGISTRY_REL),
                       "error": exc.detail})
        return
    if not os.path.isdir(safes_d):
        return                                # the common case: no such thing

    # Rule 4, and the same fail-closed shape the system registry gets: a
    # directory somebody else can write is a directory whose contents are
    # somebody else's. `_trusted_dir` accepts root OR this euid; here only this
    # euid will do, because a root-owned directory inside a user's home is not
    # something this feature ever creates.
    fd = None
    try:
        fd = os.open(safes_d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                     | os.O_CLOEXEC)
        st = os.fstat(fd)
    except OSError:
        errors.append({"file": safes_d,
                       "error": "the per-user registry cannot be opened as a "
                                "directory; it is refused entirely"})
        return
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    if st.st_uid != ident.euid or (st.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
        errors.append({"file": safes_d,
                       "error": "the per-user registry is not owned by this "
                                "user or is group/other-writable — the whole "
                                "per-user registry is refused"})
        return

    mine = _read_registry_dir(safes_d, ident, errors, validator,
                              source="user", allow_uids=(ident.euid,))
    for sid in sorted(mine):
        entry = mine[sid]
        if sid in entries:
            # Rule 5. The system entry wins and the shadowed one is an ERROR,
            # never a silent preference: an operator who registered `lab-dc`
            # in their home and is being served the administrator's `lab-dc`
            # has to be told, or they will type a passphrase into the wrong
            # prompt.
            errors.append({
                "file": entry.get("registry_file") or sid,
                "error": "per-user entry %r is shadowed by a system registry "
                         "entry with the same id; the system entry is the one "
                         "in use" % sid})
            continue
        # Rule 3. `open_safe_fd` is the check — the same one every unlock does
        # — run here so a per-user entry pointing at a file this user does not
        # own is dropped at load rather than becoming an access-denied later
        # that reads like a bug in the gate. `resolve_entry` first, so a `%u`
        # in the path is expanded exactly as the unlock path would expand it.
        try:
            probe = resolve_entry(entry, ident)
            open_safe_fd(probe["path"], expect_uid=ident.euid).close()
        except SecretsError as exc:
            # DROPPED, and this is the one drop an operator has to be able to
            # clean up themselves, so the message says how. A dropped entry is
            # not in the registry, so `safe-forget` cannot reach it — but this
            # file is in the caller's OWN home and they can remove it with
            # `rm`, which is the whole difference between this and a stuck
            # entry in the root-owned system registry. (A system entry whose
            # file has vanished is NOT dropped — nothing checks the file at
            # load there — so it stays listed and `safe-forget` still works on
            # it, which is the case C8 is actually about.)
            errors.append({
                "file": entry.get("registry_file") or sid,
                "error": "the file this per-user entry names is not a safe "
                         "this user owns 0600 under a safe directory chain "
                         "(%s); the entry is dropped — remove %s to clean it "
                         "up" % (exc.detail,
                                 os.path.join(safes_d,
                                              entry.get("registry_file")
                                              or (sid + ".json")))})
            continue
        entries[sid] = entry


def resolve_entry(entry, ident):
    """Apply per-caller substitution and return a COPY for the backend.

    `owner: "%u"` means "each user gets their own safe at this path", so `%u` in
    the path expands to the caller's login name. This is the only templating in
    the system and it expands to a name the kernel gave us, never to anything
    from the request (I4).
    """
    out = dict(entry)
    if entry.get("owner") == "%u":
        name = ident.real_name if ident.euid != 0 else None
        if not name:
            raise AccessDenied("this safe is per-user and the calling user has "
                               "no name on this host")
        if "%u" in out["path"]:
            out["path"] = out["path"].replace("%u", name)
        if isinstance(out.get("keyfile"), str):
            out["keyfile"] = out["keyfile"].replace("%u", name)
    return out


def lookup_safe(safe_id, ctx):
    """Registry id -> entry. THE ONLY place an id becomes a path (I4)."""
    if not isinstance(safe_id, str) or not safe_id:
        raise Invalid("a safe id is required")
    if len(safe_id) > 63 or not _ID_RE.match(safe_id):
        # Refused by shape before it is looked up, so a traversal-shaped id
        # never reaches a dict key, a log line or a state file name.
        raise Invalid("a safe id must match ^[a-z0-9][a-z0-9._-]*$")
    entry = ctx.registry.get(safe_id)
    if entry is None:
        raise NotFound("no safe with that id is registered")
    return entry


# ===========================================================================
# writable state: the lockout counter and the audit log
# ===========================================================================
#
# Both want to live under /var, both are written by a helper that is root for
# admin safes and an ordinary user for user safes, and /var/lib is not writable
# by the latter. The resolution is a documented fallback rather than a silent
# one, and `health` reports which paths are actually in use.
#
# What that costs, stated plainly: a user-class lockout counter lives in the
# user's own state directory and the user can delete it. That is not a hole,
# because the user already owns the safe file and can run an offline attack on
# it with no help from this program. The counter that matters is the admin-class
# one, which lives under a root-owned 0700 directory an attacker cannot touch
# without already being root.

_STATE_REPORT = {"state_dir": None, "audit_log": None,
                 "state_persisted": False, "audit_persisted": False,
                 "reason": ""}


def _var_root():
    env = os.environ.get("COCKPIT_SECRETS_VAR")
    if env:
        if not os.path.isabs(env):
            raise Invalid("COCKPIT_SECRETS_VAR must be an absolute path")
        return env.rstrip("/") or "/"
    return None


def _user_state_home(ident):
    try:
        home = pwd.getpwuid(ident.euid).pw_dir
    except (KeyError, OSError):
        return None
    if not home or not os.path.isabs(home):
        return None
    return os.path.join(home, ".local", "state", "cockpit-secrets")


def _ensure_dir(path, mode=0o700):
    """Create `path` 0700 and return it, or None. Never follows a symlink into
    place: an existing non-directory or a foreign owner is a refusal."""
    try:
        os.makedirs(path, mode=mode, exist_ok=True)
    except OSError:
        return None
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                     | os.O_CLOEXEC)
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
            return None
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH | stat.S_IRGRP
                         | stat.S_IROTH):
            # Tighten rather than refuse: an inherited 0755 here is a mistake we
            # can fix, and leaving it would make the audit log group-readable —
            # the exact failure wg-admin's header warns about.
            try:
                os.fchmod(fd, mode)
            except OSError:
                return None
    except OSError:
        return None
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    return path


def init_state(ident):
    """Resolve and create the state and audit directories. Idempotent."""
    if _STATE_REPORT["state_dir"] is not None:
        return _STATE_REPORT
    var = _var_root()
    if var:
        state = _ensure_dir(os.path.join(var, "state"))
        logdir = _ensure_dir(os.path.join(var, "log"))
        _STATE_REPORT["reason"] = "COCKPIT_SECRETS_VAR override"
    else:
        state = _ensure_dir(os.path.join(DEFAULT_VAR, "state"))
        logdir = _ensure_dir(DEFAULT_LOG_DIR)
        if state is None or logdir is None:
            home = _user_state_home(ident)
            if home:
                state = state or _ensure_dir(os.path.join(home, "state"))
                logdir = logdir or _ensure_dir(home)
                _STATE_REPORT["reason"] = (
                    "system state directory is not writable by this uid; "
                    "using the caller's own state directory")
    _STATE_REPORT["state_dir"] = state
    _STATE_REPORT["state_persisted"] = state is not None
    _STATE_REPORT["audit_log"] = (os.path.join(logdir, "audit.log")
                                  if logdir else None)
    _STATE_REPORT["audit_persisted"] = logdir is not None
    if state is None and not _STATE_REPORT["reason"]:
        _STATE_REPORT["reason"] = "no writable state directory"
    # START-UP SWEEP for abandoned `safe-import` staging (C5 rule 6). It lives
    # here because this is the one function every invocation runs exactly once,
    # before any verb — so an upload orphaned by a SIGKILL or a closed browser
    # tab is cleaned up by the NEXT helper to run, whatever verb that is,
    # rather than only by an operator who thinks to look. Never fatal: see
    # `_sweep_staging`.
    _sweep_staging(ident)
    return _STATE_REPORT


# ------------------------------------------------------------ lockout ----
#
# TWO COUNTERS, ONE LOCK DISCIPLINE, AND THE INCREMENT BEFORE THE KDF.
#
# The first version of this had three defects and each one is worth naming,
# because the shape of the fix is decided by all three together:
#
#   I39  read-modify-write on a JSON file with no lock. 50 concurrent wrong
#        guesses were 34 fully evaluated and left the counter reading 3 —
#        against a threshold of 5. Measured, not argued.
#   I39' the check ran BEFORE the KDF and the increment AFTER it, so even a
#        perfectly atomic counter would still have let every guess that
#        arrived during one derivation through. The race window WAS the KDF.
#   I40  the path was keyed on `os.geteuid()`, which is 0 for every escalated
#        administrator, so one operator's typo refused every other operator
#        with the correct passphrase.
#
# WHY `flock`, and not an O_EXCL sidecar or a token-file count. The counter
# lives in `/var/lib/cockpit-secrets/state` (root-owned, 0700) on the admin
# path and in the caller's own `~/.local/state/cockpit-secrets/state` on the
# user path. Both are local filesystems and both are single-owner directories,
# so the only contenders for a given file are helper processes of the same
# principal class — which is exactly the population `flock` serialises well.
# The property that decides it is RELEASE ON DEATH: this helper is spawned once
# per verb by a browser channel that can vanish mid-derivation, and a killed
# process drops its `flock` in the kernel with no reaper, no timeout heuristic
# and no stale-lock policy. An O_EXCL sidecar has the opposite property — a
# killed helper leaves a file behind that nothing will ever clean up — and
# "the holder looks dead" is the guess `LockFile` refuses to make for the safe
# file itself, for the same reason it must not be made here. Counting O_EXCL
# token files by listing has a third problem on top: it turns the counter into
# an unbounded directory that has to be swept, in a directory whose whole
# security property is that nothing but this program writes there.
#
# THE LOCK CANNOT BECOME THE DENIAL OF SERVICE. Three things keep it that way:
# nothing blocking happens while it is held (one `read`, one `write`, of a doc
# under 200 bytes — no KDF, no file I/O on the safe, no network, there is none);
# the wait is bounded by LOCKOUT_LOCK_SECONDS rather than indefinite; and the
# per-principal counter is a DIFFERENT FILE per principal, so a wedged helper
# belonging to operator A cannot stall operator B at all. Only the per-safe
# rate cap is shared, and its critical section is the same few microseconds.
#
# WHY THE INCREMENT MOVED IN FRONT OF THE KDF. "Check, derive, then record"
# is check-then-act with a 100-500 ms gap in the middle; no amount of locking
# closes it, because every concurrent caller legitimately observes a counter
# that has not been moved yet. So the attempt is RESERVED — checked and
# incremented in one locked read-modify-write — before any derivation starts,
# and the outcome settles it afterwards: a wrong passphrase keeps the
# reservation, anything that never consumed a guess gives it back, a correct
# passphrase clears the whole counter.
#
# Reserving fails CLOSED, deliberately. A helper killed between the reservation
# and the settlement leaves the attempt counted, which is the direction this
# control has to err in: the alternative is a guessing loop that never records
# anything because it never lets the helper finish.


def _lockout_paths(ident, safe_id):
    """(per-principal counter, per-safe rate cap), or (None, None).

    Keyed on `ident.real_uid`, NOT `os.geteuid()` (I40). `real_uid` is the
    field that exists to answer "who actually asked" behind an escalation: it
    is `getuid()` on the user path and SUDO_UID/PKEXEC_UID at euid 0, where
    those are the only record of the human Cockpit escalated for. The audit log
    has been keyed on it since it was written; the lockout state was not, which
    is why the lockout could not attribute and the audit log could.
    """
    state = _STATE_REPORT.get("state_dir")
    if not state:
        return None, None
    # safe_id already matched ^[a-z0-9][a-z0-9._-]*$ in lookup_safe, so it
    # cannot contain a slash or a '..'. Asserted rather than assumed, because
    # this is the one place an id becomes a filename.
    if not _ID_RE.match(safe_id):
        raise Internal("refusing to build a state path from an invalid id")
    uid = ident.real_uid
    if not _is_int(uid) or uid < 0:
        raise Internal("refusing to build a state path from an invalid uid")
    return (os.path.join(state, "fail.%d.%s.json" % (uid, safe_id)),
            os.path.join(state, "safe.%s.json" % safe_id))


class _StateTxn:
    """An exclusive, bounded, crash-safe read-modify-write of one state file.

    Used as::

        with _StateTxn(path) as txn:        # LockedOut if it cannot be taken
            doc = txn.doc                   # {} when the file is new or junk
            txn.write({...})                # written back on a clean exit

    `write()` and not an assignment to `.doc`: a transaction that read and did
    not write must not rewrite the file, so the intent to write is explicit.

    Opened `O_RDWR|O_CREAT|O_NOFOLLOW` so a symlink planted in the state
    directory is a refusal rather than a write somewhere else (I5), and the fd
    is `fstat`ed rather than the path re-`stat`ed (I4). The lock is held on that
    same fd, so it covers the read and the write and is dropped by the kernel
    when the fd closes — including when the process dies holding it.

    `ftruncate` + write in place, not `atomic_replace`: the exclusion here comes
    from the lock, and a rename would swap the inode out from under every other
    waiter's lock and hand two processes the same "exclusive" file. This is the
    documented exception to I12 and it is the same one the counter has always
    taken; what has changed is that the write is now serialised.
    """

    __slots__ = ("path", "fd", "doc", "_dirty")

    def __init__(self, path):
        self.path = path
        self.fd = None
        self.doc = {}
        self._dirty = False

    def __enter__(self):
        try:
            self.fd = os.open(self.path,
                              os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW
                              | os.O_CLOEXEC, 0o600)
        except OSError as exc:
            raise LockedOut(
                "the lockout counter for this safe cannot be opened (%s); "
                "refusing the attempt rather than not counting it"
                % errno.errorcode.get(exc.errno, exc.errno))
        try:
            st = os.fstat(self.fd)
            if not stat.S_ISREG(st.st_mode):
                raise LockedOut("the lockout counter for this safe is not a "
                                "regular file")
            if st.st_mode & 0o077:
                os.fchmod(self.fd, 0o600)
            self._acquire()
            self.doc = self._read()
        except BaseException:
            self._close()
            raise
        return self

    def _acquire(self):
        """`LOCK_EX`, bounded. Non-blocking with a jittered retry rather than a
        blocking `flock`, because a bound is a property that can be stated and
        tested and "it will come back eventually" is not."""
        deadline = time.monotonic() + LOCKOUT_LOCK_SECONDS
        wait = 0.001
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return
            except OSError as exc:
                if exc.errno not in (errno.EWOULDBLOCK, errno.EACCES,
                                     errno.EINTR):
                    raise LockedOut("the lockout counter for this safe cannot "
                                    "be locked")
            if time.monotonic() >= deadline:
                # FAIL CLOSED. Letting the attempt through because the counter
                # was busy would make "hold this file open" the off switch for
                # I16 entirely.
                raise LockedOut(
                    "the lockout counter for this safe is busy; the attempt "
                    "was refused rather than left uncounted")
            # Jittered so N waiters do not poll in lockstep.
            time.sleep(min(wait, max(0.0, deadline - time.monotonic()))
                       * (0.5 + _sysrandom.randbelow(1000) / 1000.0))
            wait = min(wait * 2.0, 0.02)

    def _read(self):
        try:
            os.lseek(self.fd, 0, os.SEEK_SET)
            raw = os.read(self.fd, 8192)
            doc = json.loads(raw.decode("utf-8")) if raw else {}
        except (OSError, ValueError, UnicodeDecodeError):
            return {}
        return doc if isinstance(doc, dict) else {}

    def write(self, doc):
        self.doc = doc
        self._dirty = True

    def _flush(self):
        blob = json.dumps(self.doc).encode("utf-8")
        os.ftruncate(self.fd, 0)
        os.lseek(self.fd, 0, os.SEEK_SET)
        write_all(self.fd, blob)

    def _close(self):
        if self.fd is not None:
            try:
                os.close(self.fd)          # releases the flock
            except OSError:
                pass
            self.fd = None

    def __exit__(self, exc_type, exc, tb):
        try:
            if exc_type is None and self._dirty:
                try:
                    self._flush()
                except (OSError, TypeError, ValueError):
                    _note("could not write %s" % os.path.basename(self.path))
        finally:
            self._close()
        return False


def _backoff_for(fails):
    """The window one principal's Nth consecutive failure opens."""
    delay = LOCKOUT_BASE_SECONDS * (2 ** max(0, min(fails - 1, 20)))
    if fails >= LOCKOUT_THRESHOLD:
        delay = max(delay, LOCKOUT_HARD_SECONDS)
    return min(delay, LOCKOUT_MAX_SECONDS)


def _locked_remaining(until):
    """Seconds left on a window, or 0. Clamped on READ: a tampered or
    clock-skewed state file must not be able to lock a legitimate user out for
    a year, and the file is writable by the user on the user-class path."""
    if not isinstance(until, (int, float)):
        return 0.0
    remaining = float(until) - time.time()
    if remaining <= 0:
        return 0.0
    return min(remaining, LOCKOUT_MAX_SECONDS)


def _refuse(remaining):
    raise LockedOut("too many failed unlock attempts for this safe; try again "
                    "in %d seconds" % int(math.ceil(remaining)))


def lockout_begin(ident, safe_id):
    """RESERVE one credential attempt: check and increment, atomically, BEFORE
    the KDF runs. Raises LockedOut instead of returning when either counter
    says no.

    Both counters move here, in that order, and each move is one locked
    read-modify-write:

      1. the per-(real_uid, safe) counter, which escalates 2 s, 4 s, 8 s … and
         goes hard at LOCKOUT_THRESHOLD. This is the brake on one principal.
      2. the per-safe fixed-window cap, which counts EVERY principal's attempts
         together and refuses past LOCKOUT_SAFE_THRESHOLD until the window ends.
         This is the brake on an attacker who can vary the identity in step 1.

    If (2) refuses, (1) is given back before the refusal — a caller who never
    got to make an attempt must not be charged for one.

    Returns an opaque token for `lockout_settle`.
    """
    principal, shared = _lockout_paths(ident, safe_id)
    if not principal:
        # No writable state directory. `health` reports this as
        # lockout_persisted=false; there is nothing to lock and nothing to
        # count, and refusing every unlock on a host with no /var would be a
        # worse answer than proceeding with the constant floor alone.
        return None

    now = time.time()
    with _StateTxn(principal) as txn:
        remaining = _locked_remaining(txn.doc.get("locked_until"))
        if remaining > 0:
            _refuse(remaining)
        fails = txn.doc.get("failures")
        fails = (fails + 1) if _is_int(fails) and fails >= 0 else 1
        txn.write({"failures": fails,
                   "locked_until": now + _backoff_for(fails),
                   "last": _iso_utc(now)})

    try:
        with _StateTxn(shared) as txn:
            count, started = _window(txn.doc, now)
            if count >= LOCKOUT_SAFE_THRESHOLD:
                _refuse(max(1.0, started + LOCKOUT_SAFE_WINDOW - now))
            txn.write({"window_count": count + 1, "window_start": started,
                       "last": _iso_utc(now)})
    except BaseException:
        _lockout_give_back(principal)
        raise

    return (principal, shared)


def _window(doc, now):
    """(attempts so far in the live window, when that window opened).

    A FIXED window, not a rolling one: once it expires the count starts again
    from zero. That is what bounds the denial this counter can cause to one
    LOCKOUT_SAFE_WINDOW no matter what an attacker does with it.
    """
    started = doc.get("window_start")
    count = doc.get("window_count")
    if (not isinstance(started, (int, float))
            or not _is_int(count) or count < 0
            or now < float(started)               # clock went backwards
            or now - float(started) >= LOCKOUT_SAFE_WINDOW):
        return 0, now
    return int(count), float(started)


def _lockout_give_back(path, shared=False):
    """Undo one reservation. Best effort, and it may only ever REDUCE a count.

    A decrement rather than a restore of the document we read. It matters most
    for the SHARED file, where another principal really can have moved it
    between our increment and this call: writing back a snapshot would silently
    discard their attempt, which is the lost update this whole fix is about,
    re-introduced by the one function allowed to make a counter smaller.

    The recomputed `locked_until` can only ever come out SHORTER, because the
    give-back happens milliseconds after the increment and `_backoff_for` is
    monotonic in the count.
    """
    try:
        with _StateTxn(path) as txn:
            doc = dict(txn.doc)
            key = "window_count" if shared else "failures"
            value = doc.get(key)
            value = (value - 1) if _is_int(value) and value > 0 else 0
            if not shared and value <= 0:
                doc = {"failures": 0, "locked_until": 0}
            elif shared:
                doc[key] = value
            else:
                doc[key] = value
                # Recomputed from the count we are leaving behind, so giving an
                # attempt back also gives back the window it bought.
                doc["locked_until"] = time.time() + _backoff_for(value)
            txn.write(doc)
    except (LockedOut, OSError):
        # Failing to give an attempt back leaves it counted. That is the safe
        # direction and it is why this is not allowed to raise into a verb.
        _note("could not release a lockout reservation")


def lockout_settle(token, counted):
    """Close out a reservation. `counted=True` keeps it (a wrong passphrase);
    `counted=False` gives it back (an attempt that never consumed a guess —
    a missing passphrase, an unreadable key file, a backend that will not load).

    Only `bad-credential` keeps a reservation. If anything else did, a caller
    who is entitled to try could burn the per-safe cap with requests that never
    reach the KDF and deny the safe to every other operator — the cheap DoS the
    old code avoided by counting nothing until after a real failure.
    """
    if not token or counted:
        return
    principal, shared = token
    _lockout_give_back(principal)
    _lockout_give_back(shared, shared=True)


# There is deliberately NO read-only `lockout_check` any more. The old one was
# the first half of a check-then-act, and every caller of it now has to reserve
# instead — a question about the counter that does not also move it is exactly
# the thing 50 concurrent guesses used to answer 34 times (I39).


def lockout_reset(ident, safe_id):
    """A successful unlock clears BOTH counters — the window exists to slow
    guessing, not to punish a typo an hour ago.

    ZEROED, NOT UNLINKED, and the reason is the lock rather than tidiness.
    `flock` is held on an INODE. Unlinking the counter while other helpers are
    queued on it hands the next arrival an `O_CREAT` of a DIFFERENT inode, and
    two processes then hold two "exclusive" locks on two files with the same
    name — which is I39 back again, reached from the one code path that is
    allowed to make the counter smaller. The earlier version unlinked here.
    Nothing was exploiting it (reaching this line requires the passphrase), but
    a mutual-exclusion primitive with an exception in it is not one.

    What that costs is the litter docs/ROOT-VERIFICATION.md F2 recorded as a
    surprise: one 60-byte 0600 JSON per (real uid, safe) in the state
    directory, forever. It is now the DELIBERATE state rather than an accident
    of `unlink` raising ENOENT, it carries no value, and `lockout_begin`
    returns immediately on it. tests/root/90-cleanup.sh removes the suite's own.

    THE PER-SAFE CAP IS CLEARED TOO, and that is a decision rather than an
    oversight. Someone just proved they hold this safe's key; the run of
    failures the cap was counting was not the guessing campaign it exists to
    stop, and leaving it in place would let one operator's fat fingers throttle
    a safe for a full window after the safe demonstrably opened. An attacker
    cannot reach this line — reaching it requires the passphrase.
    """
    principal, shared = _lockout_paths(ident, safe_id)
    if not principal:
        return
    try:
        with _StateTxn(shared) as txn:
            if txn.doc:
                txn.write({"window_count": 0, "window_start": 0})
    except (LockedOut, OSError):
        _note("could not clear the per-safe attempt window")
    try:
        with _StateTxn(principal) as txn:
            txn.write({"failures": 0, "locked_until": 0})
    except (LockedOut, OSError):
        _note("could not clear the lockout counter")


def fail_floor_seconds(ident):
    """The I16 constant time floor, in seconds.

    A wrong passphrase must never come back faster than a right one. Most of
    that is free — the KDF runs before the MAC check either way — but the cases
    that fail BEFORE the KDF (a header that will not parse, a key file of the
    wrong length) would otherwise return instantly and tell an attacker their
    guess was not even a valid attempt.

    `COCKPIT_SECRETS_FAIL_FLOOR` lowers it so the suite is not 0.75 s per
    negative case, and is IGNORED on the production admin path (euid 0 against
    the real registry) — the only configuration where that timing distinction
    buys an attacker anything they do not already have.
    """
    default = float(Limits.FAIL_FLOOR_SECONDS)
    raw = os.environ.get("COCKPIT_SECRETS_FAIL_FLOOR")
    if not raw:
        return default
    if ident.euid == 0 and not os.environ.get("COCKPIT_SECRETS_ETC"):
        return default
    try:
        value = float(raw)
    except ValueError:
        return default
    return max(0.0, min(value, 10.0))


class FailFloor:
    """Hold the failure path open until `floor` seconds have passed.

    Monotonic, so a wall-clock step (ntp, a VM resume) cannot collapse the floor
    to nothing or stretch it to a hang.
    """

    __slots__ = ("floor", "start")

    def __init__(self, floor):
        self.floor = float(floor)
        self.start = time.monotonic()

    def wait(self):
        remaining = self.floor - (time.monotonic() - self.start)
        if remaining > 0:
            time.sleep(min(remaining, 30.0))


# -------------------------------------------------------------- audit ----

#: Everything the audit line may contain. There is no field here for a value,
#: an entry title, a path or a traceback, and `audit()` builds the dict from
#: this list rather than from whatever a caller passes (I15).
_AUDIT_KEYS = ("ts", "verb", "safe", "uid", "euid", "outcome", "note",
               "duration_ms", "pid", "session", "artifact", "rows")

#: `artifact` is the NAME OF A FILE THIS HELPER CREATED — an export, a save-as
#: target, a restored backup generation. I21 requires exports be "always
#: audited by name", and a restore that cannot be traced to the generation it
#: came from is not an auditable restore. It is a base name only, never a
#: directory, and it is re-checked against this pattern immediately before it
#: is written: a name is not a value, but it is still a string that reached us
#: from somewhere, and the audit log is not the place to discover that (I15).
_ARTIFACT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")

#: `note` is helper-controlled and drawn from this set. A backend's `detail`
#: never reaches the log: it is operator-safe by construction, but "operator
#: safe" is a promise made by code this file does not own.
_AUDIT_NOTES = frozenset((
    "", "class-refused", "locked-out", "handle-unknown", "handle-expired",
    "registry-dropped", "no-such-safe", "backend-unavailable", "file-refused",
    "credential-rejected", "conflict", "read-only", "session-open",
    "session-closed", "unsupported", "bad-request", "internal",
    # The registry-writing verbs. Each names WHICH of the two registries was
    # touched, because "a safe appeared" and "a safe appeared in /etc" are
    # different events to whoever reads this log — and `safe-delete` is the
    # only verb in the program that destroys a safe, so it gets its own word
    # rather than sharing `forgotten`.
    "created-system", "created-user", "imported-system", "imported-user",
    "forgotten", "deleted", "staged", "staging-expired",
))


def audit(verb, safe_id, ident, outcome, duration_ms, note="", session=False,
          artifact=None, rows=None):
    """Append ONE JSON line: verb, safe, uid, outcome, duration. Never a value.

    Best effort by design. An audit write that fails must not fail the verb —
    but it must not be invisible either, so the failure goes to stderr and
    `health` reports whether the log is persisted at all.

    `artifact` and `rows` exist for the three verbs that produce a FILE — see
    `_ARTIFACT_RE`. They are None on every other line. A name that does not
    match the pattern is dropped rather than truncated: half a name in an audit
    log is worse than no name, because it looks like a name.
    """
    path = _STATE_REPORT.get("audit_log")
    if not path:
        return
    if artifact is not None and not _ARTIFACT_RE.match(str(artifact)):
        artifact = None
    line = {
        "ts": _iso_utc(),
        "verb": str(verb)[:64],
        "safe": (str(safe_id)[:63] if safe_id else None),
        "uid": ident.real_uid,
        "euid": ident.euid,
        "outcome": str(outcome)[:32],
        "note": note if note in _AUDIT_NOTES else "",
        "duration_ms": int(duration_ms),
        "pid": ident.pid,
        "session": bool(session),
        "artifact": (str(artifact) if artifact is not None else None),
        "rows": (int(rows) if _is_int(rows) else None),
    }
    assert set(line) == set(_AUDIT_KEYS)      # the shape is the guarantee
    fd = None
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND
                     | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        st = os.fstat(fd)
        if st.st_mode & 0o077:
            os.fchmod(fd, 0o600)
        # redact() over the finished line, not over the pieces: the filter is
        # cheap and this is the last chance to catch a secret that reached a
        # field it had no business reaching.
        write_all(fd, (redact(json.dumps(line, ensure_ascii=False)) + "\n")
                  .encode("utf-8"))
    except OSError as exc:
        _note("audit write failed (%s); the operation still ran"
              % errno.errorcode.get(exc.errno, "EIO"))
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


# ===========================================================================
# handles and the single-process session
# ===========================================================================

class Session:
    """One unlocked backend, reachable only from inside this process.

    The handle is 128 bits of `secrets.token_urlsafe` bound to (uid, safe id,
    pid). There is no persistence layer under this object: when the process
    exits the dict goes with the address space, which is why "the passphrase is
    prompted every time" needs no timer to be true (docs/ARCHITECTURE.md).
    """

    __slots__ = ("handle", "uid", "safe", "pid", "backend", "entry",
                 "created", "last_used", "expires_at", "mutated")

    def __init__(self, handle, uid, safe, pid, backend, entry, ttl):
        self.handle = handle
        self.uid = uid
        self.safe = safe
        self.pid = pid
        self.backend = backend
        self.entry = entry
        self.created = time.monotonic()
        self.last_used = self.created
        self.expires_at = self.created + ttl
        self.mutated = False

    def expires_in(self):
        return max(0, int(self.expires_at - time.monotonic()))


HANDLES = {}


def new_session(safe_id, ident, backend, entry, ttl):
    handle = _sysrandom.token_urlsafe(16)          # 128 bits, URL-safe
    HANDLES[handle] = Session(handle, ident.euid, safe_id, ident.pid,
                              backend, entry, ttl)
    return HANDLES[handle]


def find_session(handle, ident):
    """Handle -> Session, or AccessDenied.

    Presenting a handle you do not own is access-denied, never not-found
    (docs/CONTRACT.md): the two must be indistinguishable or the verb becomes an
    oracle for which handles exist. Every candidate is compared with
    `constant_time_eq` and the loop does not stop early, so neither the answer
    nor the timing separates "unknown" from "someone else's".
    """
    if not isinstance(handle, str) or not handle or len(handle) > 128:
        raise AccessDenied("this handle is not valid for this caller")
    match = None
    for known, sess in HANDLES.items():
        if constant_time_eq(known, handle):
            match = sess
    if match is None:
        raise AccessDenied("this handle is not valid for this caller")
    if match.uid != ident.euid or match.pid != ident.pid:
        raise AccessDenied("this handle is not valid for this caller")
    if match.expires_in() <= 0:
        drop_session(match)
        raise AccessDenied("this handle has expired; unlock again")
    match.last_used = time.monotonic()
    return match


def drop_session(sess):
    """Lock and forget one session. Idempotent."""
    try:
        sess.backend.lock()
    except Exception as exc:                                   # noqa: BLE001
        _note("backend lock() raised %s during teardown" % type(exc).__name__)
    HANDLES.pop(sess.handle, None)


def drop_all_sessions():
    for sess in list(HANDLES.values()):
        drop_session(sess)


# ===========================================================================
# the unlock agent — CLIENT side only  (I18)
# ===========================================================================
#
# `secrets-agent` is a separate program with its own file. What lives here is
# the client: four operations over an AF_UNIX socket, newline-delimited JSON.
#
#     {"op":"put","safe":id,"handle":tok,"idle_seconds":n,"max_seconds":n}
#         -> {"ok":true,"expires_in":n,"material_held":false}
#     {"op":"get","safe":id,"handle":tok}
#         -> {"ok":true,"expires_in":n,"idle_expires_in":n,
#             "material_held":false} | {"error":"access-denied", …}
#     {"op":"drop","safe":id}                  -> {"ok":true,"dropped":n}
#     {"op":"status"}
#
# THIS CLIENT AND agent/secrets_agent.py WERE BUILT IN PARALLEL AND DID NOT
# AGREE. They do now, and the reconciliation went the way it did because
# docs/CONTRACT.md says the agent holds the HANDLE, not the key:
#
#   put    the daemon used to REQUIRE a `material` field carrying unlocked key
#          material. It is now optional, and this client sends none — a
#          TICKET, not a key. Nothing in `Backend` produces key material,
#          nothing here consumes it, and a live material path that only a
#          future caller could use is a loaded gun in the tree. What the
#          ticket buys is I18's other half: a uid-bound record that safe X was
#          unlocked at time T, with both deadlines running, so the UI can show
#          a countdown it did not invent and `lock` can revoke across
#          processes. What it deliberately does NOT buy is a second helper
#          reopening a safe without a prompt — non-negotiable 9.
#          Both spellings of the window are still sent; `idle_seconds`/
#          `max_seconds` is the one the daemon reads.
#   drop   the by-safe form is now native. The `status`-then-drop-by-handle
#          fallback in `agent_drop` is kept for a daemon older than this
#          reconciliation, and is dead code against the shipped one.
#   get    it gives ONE answer for "unknown" and "not yours" and never says
#          "expired", so `_agent_handle_note` below resolves to
#          `handle-unknown` against it. That is the conservative note, and it
#          is the right one when the answer really is "we cannot tell".
#   token  the daemon required 32..128 HEX characters; this helper mints
#          `secrets.token_urlsafe(16)`. The daemon's class was widened to
#          base64url (a superset of hex, so it lost nothing) rather than
#          re-minting handles here: the contract fixes 128 bits of entropy and
#          says nothing about the alphabet, and handle minting is load-bearing
#          working code.
#
# `agent_call` still strips any `material` key out of a reply at the door.
# That is belt to the daemon's braces and stays even though the daemon no
# longer sends one: the day someone implements a material-carrying reattach,
# deleting that line is the deliberate act that starts it.
#
# WHAT THE AGENT IS, AND — MORE IMPORTANTLY — WHAT IT IS NOT.
#
# Read the protocol again: `put` sends a HANDLE. It does not send the
# passphrase, the derived key, or anything else that could reopen a safe, and
# `get` answers with a lifetime, not with key material. **No key material
# crosses this socket in either direction.** So the agent cannot hand a later
# helper process an unlocked database, and enabling it does not weaken
# non-negotiable 9: the passphrase is still prompted on every unlock, because
# the thing that held the key was an address space that has since exited
# (docs/ARCHITECTURE.md).
#
# What the agent DOES buy is the half of I18 that is about visibility and
# revocation: a live, uid-bound record that safe X was unlocked at time T with
# a hard idle timeout and a hard absolute lifetime, so the UI can show
# "unlocked — N s remaining" from a number the helper did not invent, and so
# `lock` can revoke it for every process at once rather than only for this one.
#
# Four rules this client keeps, in order of how much they matter:
#
#   1. **Off unless the registry says otherwise.** `agent.enabled` is false by
#      default and this client is not reached at all when it is false.
#   2. **Never start the daemon.** No fork, no exec, no socket activation, no
#      "helpfully" creating the directory. An absent socket means absent.
#   3. **Never fail a verb because of the agent.** Every call here returns None
#      on any error whatsoever. A hung, missing, hostile or malformed daemon
#      degrades to exactly today's behaviour — prompt again — which is the
#      behaviour we wanted in the first place.
#   4. **Validate the socket before speaking to it.** A1 in
#      docs/THREAT-MODEL.md is another unprivileged local user who can create
#      sockets in a directory they own. Owner and mode are checked on the
#      containing directory AND on the socket node.

_AGENT_REPORT = {"consulted": False, "socket": None, "reachable": False,
                 "reason": "", "status": None}


def agent_socket_path(entry, ident):
    """Where this caller's agent socket would be, or None.

    Two locations, one per access class, exactly as docs/CONTRACT.md fixes
    them. Neither is created here — this function only names a path.
    """
    if entry.get("access", "admin") == "admin":
        # Per-uid under /run so two admins never share a socket, keyed on the
        # REAL caller: behind pkexec/sudo the euid is 0 for everybody, and a
        # single root-shared agent would let one administrator inherit
        # another's unlock.
        return os.path.join(AGENT_ADMIN_RUN, str(ident.real_uid),
                            AGENT_SOCK_NAME)
    run = os.environ.get("XDG_RUNTIME_DIR")
    if not run or not os.path.isabs(run):
        return None
    return os.path.join(run, AGENT_RUN_SUBDIR, AGENT_SOCK_NAME)


def _agent_socket_trusted(path, expect_uid):
    """(True, "") when `path` is a socket we may speak to. (False, why) else.

    `lstat`, never `stat`: a symlink pointing at somebody else's socket must be
    refused, not followed. There is no fd-based equivalent here — a unix socket
    cannot be `open()`ed — so this is a check-then-connect with a window we
    cannot close. It is bounded by the run directory itself being 0700 and
    owned by the caller, which is what stops another user putting anything into
    it in the first place (I5's shape, with the residual stated rather than
    hidden).
    """
    if not path:
        return False, "no run directory for this caller"
    parent = os.path.dirname(path)
    try:
        pst = os.lstat(parent)
    except OSError:
        return False, "the agent run directory does not exist"
    if not stat.S_ISDIR(pst.st_mode):
        return False, "the agent run directory is not a directory"
    if pst.st_uid != expect_uid:
        return False, "the agent run directory is owned by another user"
    if stat.S_IMODE(pst.st_mode) & 0o077:
        return False, "the agent run directory is not 0700"
    try:
        sst = os.lstat(path)
    except OSError:
        return False, "no agent socket (the agent is not running)"
    if not stat.S_ISSOCK(sst.st_mode):
        return False, "the agent socket path is not a socket"
    if sst.st_uid != expect_uid:
        return False, "the agent socket is owned by another user"
    return True, ""


def agent_call(path, req, expect_uid, *, timeout=AGENT_TIMEOUT_SECONDS):
    """One request/response round trip. Returns a dict, or None on ANY failure.

    None is the whole error handling. See rule 3 above: an agent that cannot
    answer must cost the operator one extra passphrase prompt, never a failed
    verb and never a hung Cockpit channel.
    """
    ok, why = _agent_socket_trusted(path, expect_uid)
    if not ok:
        _AGENT_REPORT["reason"] = why
        return None
    sock = None
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        sock.connect(path)
        sock.sendall((json.dumps(req, ensure_ascii=False) + "\n")
                     .encode("utf-8"))
        chunks, total = [], 0
        while True:
            chunk = sock.recv(8192)
            if not chunk:
                break
            total += len(chunk)
            if total > AGENT_MAX_REPLY_BYTES:
                # A daemon that streams without end is a daemon that hangs the
                # channel behind it. Bounded by arithmetic, not by patience.
                _AGENT_REPORT["reason"] = "the agent reply exceeded its cap"
                return None
            chunks.append(chunk)
            if b"\n" in chunk:
                break
        line = b"".join(chunks).split(b"\n", 1)[0]
        if not line:
            _AGENT_REPORT["reason"] = "the agent closed without answering"
            return None
        doc = json.loads(line.decode("utf-8"))
        if not isinstance(doc, dict):
            _AGENT_REPORT["reason"] = "the agent answered with a non-object"
            return None
        _AGENT_REPORT["reachable"] = True
        _AGENT_REPORT["reason"] = ""
        # DROPPED HERE, AT THE DOOR. The shipped daemon's `get` answers with a
        # `material` field carrying base64 key material. This client has no use
        # for it — it does not implement a material-carrying reattach — and a
        # value that no caller wants is a value that can only ever leak. If a
        # later phase does implement that reattach, deleting this is a
        # deliberate act with a reviewer attached, which is the point.
        doc.pop("material", None)
        return doc
    except (OSError, ValueError, UnicodeDecodeError) as exc:
        # socket.timeout is an OSError subclass, so a slow daemon lands here
        # too. The class name only: this is a diagnostic, not a channel for
        # whatever the daemon felt like writing.
        _AGENT_REPORT["reason"] = "the agent did not answer (%s)" \
                                  % type(exc).__name__
        return None
    finally:
        if sock is not None:
            try:
                sock.close()
            except OSError:
                pass


def agent_enabled(entry):
    return bool((entry.get("agent") or {}).get("enabled"))


def agent_put(entry, ident, safe_id, handle):
    """Hand a freshly minted handle to the agent. Returns its reply, or None.

    Called ONLY after a successful unlock of a safe whose registry entry opted
    in. The idle and absolute lifetimes come from the REGISTRY, never from the
    request: a client that could name its own timeout would be a client that
    could ask for an unlock that never ends (I18).
    """
    if not agent_enabled(entry):
        return None
    cfg = entry.get("agent") or {}
    path = agent_socket_path(entry, ident)
    _AGENT_REPORT["consulted"] = True
    _AGENT_REPORT["socket"] = path
    idle = int(cfg.get("idle_seconds", 300))
    lifetime = int(cfg.get("max_seconds", 3600))
    reply = agent_call(path, {"op": "put", "safe": safe_id, "handle": handle,
                              # Both spellings; see the divergence note above.
                              "idle": idle, "max": lifetime,
                              "idle_seconds": idle, "max_seconds": lifetime},
                       ident.euid)
    if not reply or reply.get("ok") is not True:
        return None
    return reply


def agent_get(entry, ident, safe_id, handle):
    """Ask whether the agent still holds this handle. Returns the reply or None.

    The ANSWER IS NOT RETURNED TO THE CALLER. It selects an audit note and
    nothing else — see `need_backend`.
    """
    if not agent_enabled(entry):
        return None
    path = agent_socket_path(entry, ident)
    _AGENT_REPORT["consulted"] = True
    _AGENT_REPORT["socket"] = path
    return agent_call(path, {"op": "get", "safe": safe_id, "handle": handle},
                      ident.euid)


def agent_drop(entry, ident, safe_id, handle=None):
    """Revoke this safe's agent ticket. Idempotent; failure is not an error.

    Two shapes, in order. The by-safe form is the protocol this client was
    specified against and is what the reconciled daemon now answers natively.
    The fallback below — resolve the safe's holdings through `status`, drop
    them by their own handles — is kept for a daemon older than that
    reconciliation, and against the shipped one it never runs. It composes two
    documented operations, never a third one invented, and never
    `{"all": true}`, which would revoke unlocks for safes nobody asked about.
    """
    if not agent_enabled(entry):
        return None
    path = agent_socket_path(entry, ident)
    _AGENT_REPORT["consulted"] = True
    _AGENT_REPORT["socket"] = path

    req = {"op": "drop", "safe": safe_id}
    if handle:
        req["handle"] = handle
    reply = agent_call(path, req, ident.euid)
    if reply and reply.get("ok") is True:
        return reply

    status = agent_call(path, {"op": "status"}, ident.euid)
    if not status or status.get("ok") is not True:
        return reply
    dropped = 0
    for held in (status.get("holdings") or [])[:64]:
        if not isinstance(held, dict) or held.get("safe") != safe_id:
            continue
        token = held.get("handle")
        if not isinstance(token, str) or not token:
            continue
        one = agent_call(path, {"op": "drop", "safe": safe_id,
                                "handle": token}, ident.euid)
        if one and one.get("ok") is True:
            dropped += int(one.get("dropped") or 1)
    if dropped:
        return {"ok": True, "dropped": dropped}
    return reply


def agent_status(ident):
    """Live agent state for `health`. Probes BOTH class sockets for this uid.

    This is where I18's "an unlocked safe must never be invisible" is paid for
    on the helper side: whatever the agent is holding shows up in a verb any
    caller may run, without a handle and without a passphrase.
    """
    out = {"user": None, "admin": None}
    probes = (
        ("user", agent_socket_path({"access": "user"}, ident)),
        ("admin", agent_socket_path({"access": "admin"}, ident)),
    )
    for label, path in probes:
        row = {"socket": path, "present": False, "reachable": False,
               "reason": "", "status": None}
        ok, why = _agent_socket_trusted(path, ident.euid)
        row["present"] = ok
        row["reason"] = why
        if ok:
            reply = agent_call(path, {"op": "status"}, ident.euid)
            if reply is None:
                row["reason"] = _AGENT_REPORT["reason"]
            else:
                row["reachable"] = True
                row["status"] = _agent_status_scrub(reply)
        out[label] = row
    return out


#: Keys the daemon's `status` reply must never propagate into `health`. The
#: value-shaped ones are `scrub_listing`'s job; these are BEARER TOKENS, which
#: that filter deliberately leaves alone because `unlock` has to return one.
#: `health` needs no handle to describe what is held, and a handle printed into
#: a diagnostics panel is a handle somebody screenshots.
_AGENT_STATUS_BANNED = frozenset(("handle", "handles", "token", "tokens",
                                  "material"))


def _agent_status_scrub(reply, _depth=0):
    """Another program's JSON, treated as another program's JSON."""
    if _depth > 8:
        return None
    if isinstance(reply, dict):
        return {k: _agent_status_scrub(v, _depth + 1)
                for k, v in reply.items()
                if not (isinstance(k, str)
                        and k.lower() in _AGENT_STATUS_BANNED)}
    if isinstance(reply, list):
        return [_agent_status_scrub(v, _depth + 1) for v in reply[:256]]
    return scrub_listing(reply, "health", _depth)


# ===========================================================================
# request framing — the verb is on argv, everything else is stdin  (I10)
# ===========================================================================

def read_request(limit=None):
    """Read ONE JSON object from stdin, to EOF, capped at MAX_REQUEST_BYTES.

    This is the whole of I10 in one function: the master passphrase, the key
    file's bytes and every new value arrive here and nowhere else. Nothing is
    parsed from argv, nothing is read from the environment, and nothing is
    written to a temp file on the way in.

    An interactive tty is treated as an empty request so an operator can run
    `secrets-admin health` in a shell without the helper hanging on a read that
    will never end.
    """
    cap = Limits.MAX_REQUEST_BYTES if limit is None else limit
    try:
        if os.isatty(0):
            return {}
    except OSError:
        pass
    chunks, total = [], 0
    while True:
        try:
            chunk = os.read(0, 65536)
        except OSError as exc:
            if exc.errno == errno.EINTR:
                continue
            raise Invalid("could not read the request from stdin")
        if not chunk:
            break
        total += len(chunk)
        if total > cap:
            # Refuse by arithmetic before the allocation grows, and do not keep
            # reading: a hostile caller must not be able to balloon the helper
            # by streaming into it forever.
            raise Invalid("the request exceeds the %d byte limit" % cap)
        chunks.append(chunk)
    return parse_request(b"".join(chunks))


def parse_request(data):
    if not data.strip():
        return {}
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Invalid("the request is not valid UTF-8")
    try:
        req = json.loads(text)
    except ValueError:
        raise Invalid("the request is not valid JSON")
    except RecursionError:
        # `internal` is reserved for "we do not know what went wrong", and for
        # a request frame we ALWAYS do: the caller sent us this text. A body of
        # 100 000 open brackets makes json's recursive-descent parser exceed
        # Python's recursion limit, and RecursionError is a RuntimeError — not
        # a ValueError — so it used to fall through to the top-level barrier
        # and come back as {"error": "internal", "detail": "RecursionError"},
        # in the same breath as a caller who sent `not json` correctly getting
        # `invalid`. The cost is bounded (Python's own limit stops it in about
        # 0.1 s) so this is taxonomy, not a denial of service — but the audit
        # log and the client both key off that code to tell a bad request from
        # a broken helper, and one of the two was lying.
        raise Invalid("the request is nested too deeply to parse")
    if not isinstance(req, dict):
        raise Invalid("the request must be a single JSON object")
    return req


class FrameReader:
    """Newline-delimited JSON frames off fd 0, for the `open` session.

    Reads the raw descriptor rather than sys.stdin so the idle timer is a real
    `select` on the channel and not a guess about a buffered file object.
    """

    __slots__ = ("fd", "limit", "buf")

    def __init__(self, fd=0, limit=None):
        self.fd = fd
        self.limit = Limits.MAX_REQUEST_BYTES if limit is None else limit
        self.buf = b""

    def read_frame(self, deadline):
        """One line, or None on idle timeout. Raises EOFError when the channel
        closes — which is how closing the browser tab ends an unlock."""
        while True:
            nl = self.buf.find(b"\n")
            if nl >= 0:
                line, self.buf = self.buf[:nl], self.buf[nl + 1:]
                return line
            if len(self.buf) > self.limit:
                raise Invalid("a session frame exceeds the %d byte limit"
                              % self.limit)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            try:
                ready, _, _ = select.select([self.fd], [], [],
                                            min(remaining, 5.0))
            except (OSError, ValueError) as exc:
                if getattr(exc, "errno", None) == errno.EINTR:
                    continue
                raise EOFError
            if not ready:
                continue
            try:
                chunk = os.read(self.fd, 65536)
            except OSError as exc:
                if exc.errno == errno.EINTR:
                    continue
                raise EOFError
            if not chunk:
                if self.buf:
                    line, self.buf = self.buf, b""
                    return line
                raise EOFError
            self.buf += chunk


# ===========================================================================
# backends — imported lazily, missing ones reported not raised
# ===========================================================================

def load_backend_class(fmt):
    """Format id -> Backend subclass. Raises Unsupported, never a traceback.

    The module name is matched against FORMATS first. The registry is root
    owned, but "root owned" is not the same as "safe to concatenate into an
    import statement", and this is the only line in the file that turns data
    into code.
    """
    if fmt not in FORMATS:
        raise Unsupported("format %r has no backend" % str(fmt)[:16])
    try:
        importlib.import_module("backends." + fmt)
    except ImportError as exc:
        raise Unsupported("the %s backend is not installed (%s)"
                          % (fmt, type(exc).__name__))
    except Exception as exc:                                   # noqa: BLE001
        # A backend that raises while importing is broken, not absent. Same
        # answer to the client either way; the class name is enough for an
        # operator and carries no value.
        raise Unsupported("the %s backend failed to import (%s)"
                          % (fmt, type(exc).__name__))
    try:
        return backend_for(fmt)
    except SecretsError:
        raise Unsupported("the %s backend did not register itself" % fmt)


def backend_health(fmt):
    """One row of `health.backends`. Never raises.

    "Available" used to mean only "the module imported", and that is a
    diagnostic that lies under exactly the condition you most want it not to:
    while `backends/psafe3.py` was mid-edit and abstract-incomplete against a
    newly grown `Backend`, health reported psafe3 available and every psafe3
    verb answered `internal: TypeError`. The one thing an operator reads
    health for is "why is this format not working", and it was answering "it
    is working".

    So the class must also be INSTANTIABLE. `__abstractmethods__` is the exact
    question — it is the frozenset Python itself consults before refusing a
    constructor — and it costs nothing, needs no safe, and opens no file. It
    is not a promise the backend WORKS; it is the difference between "loaded"
    and "loaded and complete", which is the distinction that was missing.
    """
    row = {"available": False, "reason": "", "module": "backends." + fmt,
           "class": None}
    try:
        cls = load_backend_class(fmt)
    except SecretsError as exc:
        row["reason"] = exc.detail
        return row
    except Exception as exc:                                   # noqa: BLE001
        row["reason"] = "%s while loading" % type(exc).__name__
        return row
    row["class"] = getattr(cls, "__name__", None)
    missing = sorted(getattr(cls, "__abstractmethods__", ()) or ())
    if missing:
        row["reason"] = ("the module loads but the class is incomplete: %s "
                         "%s not implemented"
                         % (", ".join(missing[:8]),
                            "is" if len(missing) == 1 else "are"))
        row["incomplete"] = missing[:8]
        return row
    row["available"] = True
    return row


# ===========================================================================
# defensive scrubbing of backend output
# ===========================================================================
#
# docs/CONTRACT.md makes `entries()` returning a password a class invariant, and
# backends/base.py restates it. Invariants stated in a docstring are kept by the
# code that reads the docstring, and the backends are written by other hands, so
# the helper checks rather than trusts. A listing that arrives carrying a value
# loses it here and the anomaly goes to stderr.

_BANNED_LISTING_KEYS = frozenset((
    "password", "passphrase", "pass", "secret", "value", "plaintext",
    "keyfile", "keyfile_b64", "totp_uri", "otp_uri", "otp", "code", "b64",
))

#: The verbs whose whole purpose is to return one value. Everything else is
#: metadata, and `reveal` is the only door for a value INSIDE a safe
#: (docs/CONTRACT.md).
#:
#: `safe-create` is here for one reason and it is worth stating rather than
#: leaving to be inferred: when the operator asks it to GENERATE a key file, it
#: returns that key file's bytes ONCE, and `keyfile_b64` is in
#: `_BANNED_LISTING_KEYS` — so with the scrubber on, the response would arrive
#: with the key silently missing and the safe would be unopenable by anybody,
#: including its creator. It is exactly the private-key handling rule: shown
#: once, at creation, never stored anywhere it could be shown again. When no
#: key file was asked for, the response carries no value at all.
VALUE_BEARING_VERBS = frozenset(("reveal", "totp", "attach-get", "generate",
                                 "safe-create"))

#: Verbs whose response this file builds itself, with no backend involved. The
#: scrubber exists to catch a BACKEND that breaks contract invariant 1; running
#: it over `schema` would strip the `value` key out of every enum option and
#: quietly amputate the document the whole UI is generated from.
SELF_AUTHORED_VERBS = frozenset(("schema", "health", "audit-tail"))


def scrub_listing(obj, verb, _depth=0):
    """Strip value-shaped keys from a metadata response. Returns the object."""
    if _depth > 12:
        return obj
    if isinstance(obj, dict):
        out = {}
        for key, value in obj.items():
            if isinstance(key, str) and key.lower() in _BANNED_LISTING_KEYS:
                _note("backend returned %r from %s; dropped (contract "
                      "invariant 1)" % (key, verb))
                continue
            out[key] = scrub_listing(value, verb, _depth + 1)
        return out
    if isinstance(obj, list):
        return [scrub_listing(v, verb, _depth + 1) for v in obj]
    return obj


# ===========================================================================
# unlock — the one place credentials are handled
# ===========================================================================

def _keyfile_secret(entry, req):
    """The key file's BYTES as a Secret, from the request or from the registry.

    A caller may send bytes (`keyfile_b64`, read by the browser from the user's
    own machine) but never a path: a path from a request is I4, and a root
    helper reading a caller-named file is I5. The registry's `keyfile` IS a
    path, because the registry is root-owned policy rather than caller input,
    and it is opened through the same O_NOFOLLOW/fstat guard as the safe.
    """
    raw = req.get("keyfile_b64")
    if raw:
        if not isinstance(raw, str):
            raise Invalid("keyfile_b64 must be a base64 string")
        return Secret.from_b64(raw)
    path = entry.get("keyfile")
    if not path:
        return None
    sf = open_safe_fd(path)
    try:
        return Secret(sf.read_all(Limits.MAX_KEYFILE_BYTES))
    finally:
        sf.close()


#: A YubiKey HMAC-SHA1 challenge-response is 20 bytes. The cap is generous
#: enough for any hardware key a backend might later support and small enough
#: that "send a megabyte as the response" is refused by arithmetic.
MAX_YUBIKEY_RESPONSE_BYTES = 1024


def _yubikey_secret(entry, req):
    """The hardware key's RESPONSE bytes as a Secret, or None.

    The response is a credential like any other and arrives the same way: as a
    base64 field of the JSON request object on stdin, never on argv (I10). The
    CHALLENGE it answers comes from `probe`, which is where the file's own
    parameters are read.

    A response for a safe that registers no `yubikey_slot` is refused rather
    than ignored. Ignoring it would mean an operator who thought their hardware
    key was part of the credential had a safe that opens without it, and would
    never find out from this program.
    """
    raw = req.get("yubikey_response")
    if raw is None or raw == "":
        return None
    if not isinstance(raw, str):
        raise Invalid("yubikey_response must be a base64 string")
    if entry.get("yubikey_slot") is None:
        raise Invalid("this safe registers no yubikey_slot, so a hardware-key "
                      "response is not part of its credential")
    if (len(raw) // 4) * 3 > MAX_YUBIKEY_RESPONSE_BYTES:
        raise Invalid("yubikey_response exceeds %d bytes"
                      % MAX_YUBIKEY_RESPONSE_BYTES)
    try:
        data = base64.b64decode(raw, validate=True)
    except (binascii.Error, ValueError):
        # Never echo it: it is key material.
        raise Invalid("yubikey_response is not valid base64")
    if not data or len(data) > MAX_YUBIKEY_RESPONSE_BYTES:
        raise Invalid("yubikey_response must be 1..%d bytes"
                      % MAX_YUBIKEY_RESPONSE_BYTES)
    return Secret(data)


def _accepts_kwarg(fn, name):
    """Whether `fn` will take `name=` — asked before calling, not after.

    A `TypeError` from a call is ambiguous: it is equally "this backend has an
    older signature" and "this backend has a bug three frames down". Asking the
    signature separates them, so an older backend answers `unsupported` (which
    is true and actionable) instead of `internal` (which is neither).
    """
    try:
        params = inspect.signature(fn).parameters
    except (TypeError, ValueError):
        return False
    if name in params:
        return True
    return any(p.kind is p.VAR_KEYWORD for p in params.values())


def _password_secret(entry, req):
    raw = req.get("password")
    if raw is None or raw == "":
        if entry.get("password_required", True):
            raise Invalid("this safe requires a passphrase")
        return None
    if not isinstance(raw, str):
        raise Invalid("password must be a string")
    return Secret(raw)


def do_unlock(entry, req, ctx, *, safe_id):
    """Gate -> RESERVE -> derive -> MAC -> settle -> handle. The failure path
    has a floor.

    THIS IS THE ONLY DOOR. Every credential-consuming verb in the program
    arrives here — `unlock` calls it directly, and `tree`, `entries`, `reveal`,
    `totp`, `attach-list`, `attach-get`, `add`, `edit`, `move`, `rm`,
    `group-*`, `save`, `save-as`, `export` and `history` all reach it through
    `need_backend`'s safe+password branch. The verbs that take no credential —
    `probe`, `backups`, `restore-backup`, `list`, `health`, `strength`,
    `breach-check` — cannot be used to guess a passphrase because they never
    look at one, and an agent reattach presents a HANDLE rather than a
    credential and never derives a key (the agent holds a ticket, not
    material; docs/CONTRACT.md). So the floor and both counters cover every
    path that consumes a credential, and only those. The red team asked this
    and it had not been answered in writing before.

    The reservation is taken BEFORE the derivation, not the failure recorded
    after it: see the block comment above `_lockout_paths`. `lockout_settle`
    gives it back for a failure that never consumed a guess.

    The credentials are zeroed in a `finally` that runs before this returns, so
    by the time a response is serialised there is no live `Secret` left for
    `redact()` to catch — which is what keeps the blanket filter over stdout
    from mangling a legitimate `reveal` (I14, I15).

    `bad-credential` covers a wrong passphrase AND a failed MAC with the same
    detail string, because distinguishing them is a decryption oracle (I6). The
    distinction, where a backend can even see one, belongs in the audit log.
    """
    cls = load_backend_class(entry["format"])
    token = lockout_begin(ctx.ident, safe_id)

    floor = FailFloor(fail_floor_seconds(ctx.ident))
    password = keyfile = yubikey = None
    try:
        try:
            password = _password_secret(entry, req)
            keyfile = _keyfile_secret(entry, req)
            yubikey = _yubikey_secret(entry, req)
            backend = cls(entry)
            if yubikey is None:
                # The default path, unchanged and called exactly as it always
                # was: a safe with no hardware key must not acquire a new
                # keyword argument's worth of behaviour.
                result = backend.unlock(password, keyfile,
                                        session=req.get("session"))
            else:
                if not _accepts_kwarg(backend.unlock, "yubikey_response"):
                    raise Unsupported(
                        "the %s backend does not accept a hardware-key "
                        "response" % entry["format"])
                # bytes(), not the live buffer: the agreed interface is
                # `yubikey_response: bytes | None`. That copy is un-wipeable
                # and is one more instance of hop 5 in docs/ARCHITECTURE.md —
                # bounded, as everything there is, by the process exiting.
                result = backend.unlock(
                    password, keyfile, session=req.get("session"),
                    yubikey_response=bytes(yubikey.bytes))
        except BadCredential:
            # The reservation stands: this IS the outcome it exists to count.
            lockout_settle(token, counted=True)
            ctx.note = "credential-rejected"
            floor.wait()
            raise
        except SecretsError:
            # Everything else — a header that will not parse, a clamp refusal,
            # a missing file — also waits out the floor. Returning those faster
            # than a real attempt is the timing oracle the flat error taxonomy
            # was designed to close (I16).
            #
            # …and gives the reservation back. None of these consumed a guess,
            # and charging them would let anyone entitled to try burn the
            # per-safe cap with requests that never reach the KDF.
            lockout_settle(token, counted=False)
            floor.wait()
            raise
        except Exception as exc:                               # noqa: BLE001
            lockout_settle(token, counted=False)
            floor.wait()
            raise Internal("the %s backend raised %s during unlock"
                           % (entry["format"], type(exc).__name__))
    finally:
        for item in (password, keyfile, yubikey):
            if item is not None:
                item.zero()

    lockout_reset(ctx.ident, safe_id)
    if not isinstance(result, dict):
        raise Internal("the backend returned a malformed unlock result")
    return backend, result


def _session_ttl(req):
    """Absolute lifetime for a handle, clamped. Requests may shorten it, never
    extend it past the built-in ceiling."""
    want = req.get("max_seconds")
    ttl = SESSION_MAX_SECONDS
    if _is_int(want):
        ttl = max(SESSION_MAX_MIN, min(int(want), SESSION_MAX_MAX))
    return ttl


def _agent_handle_note(req, ctx, handle):
    """Which audit note a refused handle deserves. Never reaches the client.

    Returns one of the notes already reserved in `_AUDIT_NOTES` for exactly
    this: `handle-expired` when the agent says it held this handle and the
    lifetime ran out, `handle-unknown` otherwise — including every case where
    the agent is off, absent, or does not answer, because "we cannot tell" and
    "never existed" are the same amount of knowledge.
    """
    safe_id = req.get("safe")
    if not isinstance(safe_id, str) or not safe_id:
        return "handle-unknown"
    try:
        entry = lookup_safe(safe_id, ctx)
    except SecretsError:
        return "handle-unknown"
    if not agent_enabled(entry):
        return "handle-unknown"
    reply = agent_get(entry, ctx.ident, entry["id"], handle)
    if isinstance(reply, dict) and reply.get("reason") == "expired":
        return "handle-expired"
    return "handle-unknown"


def need_backend(req, ctx, *, verb, write=False):
    """Resolve a request to an unlocked backend. Returns (backend, entry, kind).

    Two shapes are legal, and both re-run the class gate here rather than
    trusting whatever ran when the handle was minted (I3):

      handle          — an `open` session that already unlocked this safe
      safe + password — a single-shot verb that unlocks, acts and exits, which
                        is the DEFAULT and is what makes the passphrase prompted
                        every time (docs/ARCHITECTURE.md)

    `kind` is "session" or "transient"; a transient backend is locked by the
    caller when the verb is done.
    """
    handle = req.get("handle")
    if handle:
        try:
            sess = find_session(handle, ctx.ident)
        except AccessDenied:
            # I18's reattach path. A handle this process did not mint may still
            # be live at the agent, and an operator debugging a session needs
            # to be able to tell "expired" from "never existed".
            #
            # THE CLIENT IS TOLD NEITHER. The SAME exception object is
            # re-raised with the same detail whichever the agent says, because
            # a verb that answers differently for a handle that exists is an
            # oracle for which handles exist — the same reason a wrong
            # passphrase and a failed MAC are one error (I6). The distinction
            # goes where every other one goes: the audit log (I15).
            #
            # And note what the agent CANNOT do here: no key material crosses
            # its socket, so even `ok:true` does not reopen the safe. The verb
            # refuses either way, and the operator is prompted — which is the
            # property this program exists to keep.
            ctx.note = _agent_handle_note(req, ctx, handle)
            raise
        ctx.safe_id = sess.safe
        gate(sess.entry, ctx.ident, want_write=write)
        return sess.backend, sess.entry, "session"

    safe_id = req.get("safe")
    entry = lookup_safe(safe_id, ctx)
    ctx.safe_id = entry["id"]
    gate(entry, ctx.ident, want_write=write)
    resolved = resolve_entry(entry, ctx.ident)
    backend, _ = do_unlock(resolved, req, ctx, safe_id=entry["id"])
    return backend, resolved, "transient"


