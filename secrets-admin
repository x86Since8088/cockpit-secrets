class Ctx:
    """Per-invocation state. Not a place to put anything a verb should re-derive
    — `ident` is re-read from the kernel once per process and the gate consults
    it on every verb, but nothing here is authority for an access decision."""

    __slots__ = ("ident", "registry", "registry_errors", "args", "in_session",
                 "safe_id", "note", "harden", "artifact", "rows")

    def __init__(self, ident, args, harden):
        self.ident = ident
        self.args = args
        self.harden = harden
        self.registry = {}
        self.registry_errors = []
        self.in_session = False
        self.safe_id = None
        self.note = ""
        # Set by the three verbs that create a file, read by run_verb when it
        # writes the audit line. Never set from a request field directly; see
        # _ARTIFACT_RE.
        self.artifact = None
        self.rows = None

    def load(self):
        self.registry, self.registry_errors = load_registry(self.ident)
        for err in self.registry_errors:
            _note("registry: %s: %s" % (err["file"], err["error"]))
        return self


def _int_field(req, name, default, lo, hi):
    value = req.get(name, default)
    if value is None:
        return default
    if not _is_int(value):
        raise Invalid("%s must be an integer" % name)
    return max(lo, min(int(value), hi))


# ------------------------------------------------------------- meta -------

def v_schema(req, ctx):
    """The single source of truth for the UI. Static, so it is safe to call
    unauthenticated and cheap to cache in the browser."""
    return build_schema()


def v_health(req, ctx):
    """What actually works here, with reasons — never a claim.

    `mlockall` failing is normal for the unescalated path and is reported as a
    failure rather than swallowed: claiming a defence you do not have is worse
    than not having it (I14).
    """
    state = init_state(ctx.ident)
    # Probe the schema gate even when the registry was refused outright, so the
    # report says which validator WOULD run rather than "builtin-only" because
    # nothing was validated.
    try:
        _schema_validator(registry_root())
    except SecretsError:
        pass
    return {
        "version": VERSION,
        "base_version": BASE_VERSION,
        "schema_version": SCHEMA_VERSION,
        "backends": {fmt: backend_health(fmt) for fmt in FORMATS},
        "registry_errors": ctx.registry_errors,
        "registry_root": registry_root(),
        "registry_entries": len(ctx.registry),
        "registry_gate": dict(_SCHEMA_GATE),
        # The two registries, counted separately, plus where the per-user one
        # would be for this caller (C4). `user_registry` is null on the root
        # path and says so — the root helper does not read it and must not be
        # reported as though it might (rule 1).
        "registry_sources": _registry_source_report(ctx),
        "import_staging": _staging_report(ctx),
        # There is no `registry_drift` key any more, and its absence is the
        # point: it reported entries the jsonschema gate would have dropped for
        # naming a key the installed schema file did not list, and the schema
        # file now lists every key this helper validates. An entry that fails
        # the gate is DROPPED and appears in `registry_errors`, which is the
        # only list of safes that were thrown away.
        # I18's "an unlocked safe must never be invisible", answered without a
        # handle and without a passphrase: whatever the agent is holding for
        # this caller shows up here.
        "agent": agent_status(ctx.ident),
        "export": _export_health(ctx),
        "breach": _breach_health(ctx),
        "library_root": LIB_ROOT,
        "library_root_trusted": LIB_ROOT_TRUSTED,
        "identity": ctx.ident.as_dict(),
        "hardening": ctx.harden,
        "state": {
            "state_dir": state["state_dir"],
            "audit_log": state["audit_log"],
            "lockout_persisted": state["state_persisted"],
            "audit_persisted": state["audit_persisted"],
            "reason": state["reason"],
        },
        "policy": {
            "fail_floor_seconds": fail_floor_seconds(ctx.ident),
            "fail_floor_default": Limits.FAIL_FLOOR_SECONDS,
            "lockout_threshold": LOCKOUT_THRESHOLD,
            "lockout_max_seconds": LOCKOUT_MAX_SECONDS,
            "lockout_safe_threshold": LOCKOUT_SAFE_THRESHOLD,
            "lockout_safe_window_seconds": LOCKOUT_SAFE_WINDOW,
            "reveal_seconds": Limits.REVEAL_SECONDS,
            "session_idle_seconds": SESSION_IDLE_SECONDS,
            "session_max_seconds": SESSION_MAX_SECONDS,
            "max_request_bytes": Limits.MAX_REQUEST_BYTES,
        },
        "debug": DEBUG,
    }


def v_audit_tail(req, ctx):
    """The tail of the audit log: metadata only, and only what this uid wrote —
    the log this caller can read is the one their own euid owns."""
    n = _int_field(req, "n", ctx.args.n, 1, AUDIT_TAIL_MAX)
    state = init_state(ctx.ident)
    path = state["audit_log"]
    rows = []
    if path:
        try:
            with open(path, "rb") as fh:
                fh.seek(0, os.SEEK_END)
                size = fh.tell()
                fh.seek(max(0, size - AUDIT_TAIL_BYTES))
                blob = fh.read(AUDIT_TAIL_BYTES)
        except OSError:
            blob = b""
        for line in blob.decode("utf-8", "replace").splitlines()[-n:]:
            line = line.strip()
            if not line:
                continue
            try:
                doc = json.loads(line)
            except ValueError:
                continue
            if isinstance(doc, dict):
                # Re-project onto the known key set. A log line is a file on
                # disk, and a file on disk is attacker-shaped the moment anyone
                # else can append to it.
                rows.append({k: doc.get(k) for k in _AUDIT_KEYS})
    return {"entries": rows, "path": path, "count": len(rows)}


# ------------------------------------------------------------ safes -------

def v_list(req, ctx):
    """Every registered safe, with the reason it is not usable right now.

    Admin safes are LISTED to a non-admin caller and marked locked with a
    reason, because the page is more honest when it says "there is a safe here
    you cannot open" than when it pretends the safe does not exist. Nothing in
    this response is a secret: no path, no key file, no group list.
    """
    out = []
    for sid in sorted(ctx.registry):
        entry = ctx.registry[sid]
        reason, usable = "", True
        try:
            gate(entry, ctx.ident)
        except SecretsError as exc:
            reason, usable = exc.detail, False
        fmt_ok = backend_health(entry["format"])
        if usable and not fmt_ok["available"]:
            reason, usable = fmt_ok["reason"], False
        live = any(s.safe == sid and s.uid == ctx.ident.euid
                   for s in HANDLES.values())
        out.append({
            "id": sid,
            "label": entry["label"],
            "format": entry["format"],
            "access": entry["access"],
            "mode": entry["mode"],
            "locked": not live,
            "reason": reason,
            "usable": usable,
            "password_required": entry["password_required"],
            "needs_keyfile": bool(entry["keyfile"]) or entry["yubikey_slot"] is not None,
            "agent_enabled": bool(entry["agent"]["enabled"]),
            "export_allowed": entry["export_allowed"],
            # WHICH REGISTRY THIS CAME FROM (C4). "system" is
            # /etc/cockpit-secrets/safes.d, root-owned policy; "user" is the
            # caller's own ~/.config/cockpit-secrets/safes.d, which only they
            # can write and which is forced to the user class. It is reported
            # because the two are not equally trustworthy and an operator
            # deciding whether to type a passphrase is entitled to know which
            # one they are looking at.
            "registry": entry.get("registry", "system"),
            # WHERE THIS ENTRY CAME FROM (I46). Advisory: nothing is granted on
            # it and `safe-delete`'s gate is DERIVED from the id rather than
            # read from here, precisely so a hand-edited provenance key cannot
            # talk the helper into an unlink. It is reported because "this
            # program made this file" is the sentence that makes a delete
            # confirmation feel reasonable, and an operator is entitled to know
            # whether it is true.
            "origin": entry.get("origin", "manual"),
            # Whether THIS caller could `safe-forget` this entry. Decoration in
            # the usual way (I3): the helper is what refuses, and it re-derives
            # the answer on the verb. Drawing a control the caller cannot use is
            # a worse UI than not drawing it, and guessing the rule in JS is the
            # thing this schema exists to prevent — so the rule is computed
            # here, once, from the same two facts the verb uses.
            "manageable": bool(usable) and (
                entry.get("access", "admin") != "admin" or ctx.ident.euid == 0),
        })
    return {"safes": out, "registry_errors": len(ctx.registry_errors)}


def _guard_file(entry, ctx):
    """Open the safe once through the O_NOFOLLOW/fstat guard and close it.

    This is for the ERROR, not for the enforcement: the backend re-opens through
    exactly the same guard, and it is that open which decides anything. Doing it
    here means a missing file, a wrong owner or a symlink is a clean answer from
    the helper with an audit note that says which of the two refused — the class
    gate or the file — instead of both showing up as "class-refused" (I5, I15).
    """
    try:
        open_safe_fd(entry["path"]).close()
    except AccessDenied:
        ctx.note = "file-refused"
        raise


def v_probe(req, ctx):
    """Header-level facts about a safe, with no credentials involved.

    The file is opened and validated first so a missing or ill-owned file is a
    clean not-found / access-denied from the helper rather than whatever the
    backend makes of it. The backend re-opens through the same guard; this
    early open is for the error message, never for enforcement (I5).
    """
    entry = lookup_safe(req.get("safe"), ctx)
    ctx.safe_id = entry["id"]
    gate(entry, ctx.ident)
    resolved = resolve_entry(entry, ctx.ident)
    cls = load_backend_class(resolved["format"])
    _guard_file(resolved, ctx)
    out = cls(resolved).probe()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed probe result")
    out.setdefault("warnings", [])
    out["id"] = entry["id"]
    out["access"] = entry["access"]
    out["mode"] = entry["mode"]
    if entry["mode"] == "ro":
        out["writable"] = False
        out["warnings"] = list(out["warnings"]) + [
            "registered read-only in /etc/cockpit-secrets/safes.d"]

    # -- the hardware key's challenge --------------------------------------
    # `probe` is where it belongs: the challenge is a property of the FILE (for
    # KDBX it is derived from the header's master seed, which is why it is not
    # a random number this helper could invent), and probe is the verb that
    # reads header facts with no credential involved. The UI takes
    # `challenge_b64` to the key, gets a response, and sends that response to
    # `unlock`.
    #
    # `challenge_b64`, not `challenge`: `scrub_listing` strips a bare `b64` key
    # from any non-value-bearing response, and a challenge that silently
    # vanished from probe would be a very slow bug to find.
    out["yubikey_slot"] = entry["yubikey_slot"]
    out["needs_challenge"] = entry["yubikey_slot"] is not None
    # The KDBX backend publishes the whole thing as a nested `yubikey` block
    # (slot, algorithm, challenge_b64, source). Lift the one field the UI has
    # to have to the top level and leave the block alone: one place for the UI
    # to read the challenge from whichever backend served the probe, and no
    # information thrown away.
    nested = out.get("yubikey")
    if isinstance(nested, dict) and nested.get("challenge_b64"):
        out.setdefault("challenge_b64", nested["challenge_b64"])
    if out["needs_challenge"] and not out.get("challenge_b64"):
        out["challenge_b64"] = None
        out["warnings"] = list(out["warnings"]) + [
            "this safe registers a YubiKey slot but the %s backend did not "
            "produce a challenge; unlock needs the response the desktop "
            "client computes for this database" % entry["format"]]
    return scrub_listing(out, "probe")


def v_unlock(req, ctx):
    """Derive, verify, and mint a handle bound to (uid, safe, pid).

    Outside an `open` session the handle returned here is already dead by the
    time the caller reads it: the process exits with the response. That is not
    a wart, it is the guarantee — see docs/ARCHITECTURE.md. Single-shot verbs
    carry their credentials instead, which is what "prompted every time" means.

    THE ONE CONDITIONAL DIFFERENCE (I18). When — and only when — the registry
    entry sets `agent.enabled`, an agent socket exists for this caller, and the
    daemon accepts the handle, the response gains an `agent` block and
    `expires_in` becomes the number the AGENT reports rather than this
    process's own. That is the truthful figure in that configuration: the local
    handle dies with the process either way, so the agent's lifetime is the
    only remaining bound and it is the one the UI's "unlocked — N s left"
    banner has to show.

    When the agent is disabled, its socket is absent, or the daemon refuses,
    this function returns byte-for-byte what it returned before the agent
    existed. There is no `agent` key, no reason string, no hint — nothing to
    parse differently and nothing to get wrong. The state of an agent that did
    not take part belongs in `health`, which is where it is.
    """
    entry = lookup_safe(req.get("safe"), ctx)
    ctx.safe_id = entry["id"]
    gate(entry, ctx.ident)
    resolved = resolve_entry(entry, ctx.ident)
    _guard_file(resolved, ctx)
    backend, result = do_unlock(resolved, req, ctx, safe_id=entry["id"])

    ttl = _session_ttl(req)
    sess = new_session(entry["id"], ctx.ident, backend, resolved, ttl)
    out = scrub_listing(dict(result), "unlock")
    out["handle"] = sess.handle
    out["expires_in"] = sess.expires_in()
    out.setdefault("entries_total", 0)
    out.setdefault("groups_total", 0)
    warnings = list(out.get("warnings") or [])
    if not ctx.in_session:
        warnings.append(
            "this handle dies with the helper process; use the open session "
            "for a flow that spans several verbs")

    held = agent_put(resolved, ctx.ident, entry["id"], sess.handle)
    if held:
        cfg = resolved.get("agent") or {}
        # Clamped to the registry's own absolute lifetime: a daemon that
        # answered with a bigger number than the operator configured is a
        # daemon we do not repeat (I18 — no client and no daemon may extend a
        # lifetime the registry set).
        remaining = held.get("expires_in")
        if not _is_int(remaining) or remaining < 0:
            remaining = int(cfg.get("max_seconds", 3600))
        remaining = min(int(remaining), int(cfg.get("max_seconds", 3600)))
        out["agent"] = {
            "held": True,
            "expires_in": remaining,
            "idle_seconds": int(cfg.get("idle_seconds", 300)),
            "max_seconds": int(cfg.get("max_seconds", 3600)),
            "socket": _AGENT_REPORT["socket"],
        }
        out["expires_in"] = (min(remaining, sess.expires_in())
                             if ctx.in_session else remaining)
        warnings.append(
            "this safe is unlocked at the agent for %d more seconds; show it "
            "and offer lock — an unlocked safe must never be invisible (I18)"
            % remaining)

    out["warnings"] = warnings
    out["session"] = ctx.in_session
    return out


def _agent_dropped(reply):
    """True only when the agent really let go of something.

    The daemon reports a COUNT. `{"ok": true, "dropped": 0}` is a satisfied
    request that revoked nothing — locking a safe nobody had unlocked — and
    reading it as "dropped" is how the receipt starts lying. A reply with no
    count at all (an older daemon) falls back to `ok`, which is the best it
    can say and is at least not a fabrication.
    """
    if not reply or reply.get("ok") is not True:
        return False
    n = reply.get("dropped")
    if _is_int(n):
        return n > 0
    return True


def v_lock(req, ctx):
    """Idempotent. With a handle it locks that session; without one there is
    nothing local to lock, which is the normal state of this program.

    `lock` also revokes the safe's agent ticket when one exists (I18), which is
    why it accepts a bare `safe` with no handle: after the helper that unlocked
    a safe has exited, the agent is the ONLY thing still saying it is unlocked,
    and a Lock button that cannot reach it would be a button that lies. The
    agent's answer never changes this verb's own answer — locking is
    idempotent and a missing agent means there was nothing to revoke.

    `agent_dropped` is true only when a ticket was ACTUALLY revoked. It used to
    be `bool(reply["ok"])`, and the daemon answers a drop for a safe it is not
    holding with `{"ok": true, "dropped": 0}` — a satisfied request that
    revoked nothing — so the key read true on every lock of an agent-enabled
    safe whether or not anything happened. Same failure the docstring above
    warns about, one level down: a button that cannot lie is no use if its
    receipt can.
    """
    handle = req.get("handle")
    safe_id = req.get("safe")
    dropped = None

    if isinstance(safe_id, str) and safe_id:
        entry = lookup_safe(safe_id, ctx)
        ctx.safe_id = entry["id"]
        gate(entry, ctx.ident)
        if agent_enabled(entry):
            reply = agent_drop(resolve_entry(entry, ctx.ident), ctx.ident,
                               entry["id"],
                               handle if isinstance(handle, str) else None)
            dropped = _agent_dropped(reply)

    if not handle:
        out = {"ok": True, "locked": 0}
        if dropped is not None:
            out["agent_dropped"] = dropped
        return out

    sess = find_session(handle, ctx.ident)
    ctx.safe_id = sess.safe
    if dropped is None and agent_enabled(sess.entry):
        reply = agent_drop(sess.entry, ctx.ident, sess.safe, sess.handle)
        dropped = _agent_dropped(reply)
    drop_session(sess)
    out = {"ok": True, "locked": 1}
    if dropped is not None:
        out["agent_dropped"] = dropped
    return out


# ----------------------------------------------------------- browsing -----

def v_tree(req, ctx):
    backend, entry, kind = need_backend(req, ctx, verb="tree")
    try:
        out = backend.tree()
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed tree result")
    return scrub_listing(out, "tree")


def v_entries(req, ctx):
    """Metadata only. `reveal` is the only door to a value (contract invariant
    1), and `scrub_listing` enforces that on the way out."""
    group = req.get("group")
    query = req.get("query")
    if group is not None and not isinstance(group, str):
        raise Invalid("group must be a string")
    if query is not None and not isinstance(query, str):
        raise Invalid("query must be a string")
    if isinstance(query, str) and len(query) > 256:
        raise Invalid("query must be 256 characters or fewer")
    offset = _int_field(req, "offset", 0, 0, 1000000)
    limit = _int_field(req, "limit", 100, 1, 1000)
    backend, entry, kind = need_backend(req, ctx, verb="entries")
    try:
        out = backend.entries(group=group, query=query, offset=offset,
                              limit=limit)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed entries result")
    out.setdefault("total", len(out.get("entries") or []))
    out["offset"], out["limit"] = offset, limit
    return scrub_listing(out, "entries")


_FIELD_RE = re.compile(r"^(password|username|url|notes|title|totp"
                       r"|custom:[^\x00-\x1f]{1,128})$")


def v_reveal(req, ctx):
    """THE ONLY DOOR. One field, one entry, one audit line, no title logged."""
    uuid = req.get("uuid")
    field = req.get("field")
    if not isinstance(uuid, str) or not uuid:
        raise Invalid("uuid is required")
    if not isinstance(field, str) or not _FIELD_RE.match(field):
        raise Invalid("field must be one of password, username, url, notes, "
                      "title, totp, or custom:<name>")
    backend, entry, kind = need_backend(req, ctx, verb="reveal")
    try:
        out = backend.reveal(uuid, field)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict) or "value" not in out:
        raise Internal("the backend returned a malformed reveal result")
    # `field` ECHOES THE REQUEST, always. The two backends disagreed here:
    # kdbx answered a request for "password" with the KeePass field name
    # "Password", psafe3 answered with "password". A caller reading frames off
    # a session stream pairs a response to a request by this key, so it has to
    # mean one thing regardless of which backend served it. The backend's own
    # resolved name is not thrown away — it moves to `resolved_field`, which is
    # where a UI can show "this came from the KeePass field 'Password'".
    resolved = out.get("field")
    if isinstance(resolved, str) and resolved and resolved != field:
        out["resolved_field"] = resolved
    out["field"] = field
    out.setdefault("expires_in", Limits.REVEAL_SECONDS)
    return out


def v_totp(req, ctx):
    uuid = req.get("uuid")
    if not isinstance(uuid, str) or not uuid:
        raise Invalid("uuid is required")
    backend, entry, kind = need_backend(req, ctx, verb="totp")
    try:
        out = backend.totp(uuid)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed totp result")
    return out


def v_attach_list(req, ctx):
    """The NAMES of an entry's attachments. No bytes, and no path anywhere.

    `entries` reports `attachments` as a COUNT — deliberately, because a
    listing must show that an entry HAS attachments without shipping them. But
    `attach-get` is addressed by NAME, so with only those two verbs a file
    could be uploaded through `attach-add` and never fetched again: the page
    knew there was one and had nothing to call it. This is the missing half,
    and it is a separate verb rather than a widening of `entries` for the
    reason `entries` is narrow in the first place — one entry at a time, one
    audit line, and nothing that turns a page of metadata into a page of
    inventory for every safe in the registry.

    It is metadata only and therefore NOT in `VALUE_BEARING_VERBS`: the global
    scrubber runs over this response, which is the check that a backend cannot
    smuggle a `b64` key out through the listing door.
    """
    # THE GATE FIRST, then the request shape — the opposite order to its
    # siblings, deliberately. `gate()` runs inside `need_backend` before any
    # key derivation, so this costs nothing on a refusal, and it means the
    # access class is what answers an admin-class request from a non-root
    # helper even when the request is also malformed. I3's sweep in
    # tests/integration/flow.py takes its verb list from the schema so that "a
    # verb added later is covered the day it appears"; that only holds for a
    # verb whose gate cannot be preempted by argument validation.
    backend, entry, kind = need_backend(req, ctx, verb="attach-list")
    try:
        uuid = req.get("uuid")
        if not isinstance(uuid, str) or not uuid:
            raise Invalid("uuid is required")
        rows = backend.attach_list(uuid)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(rows, list):
        raise Internal("the backend returned a malformed attachment listing")
    out = []
    for row in rows:
        if not isinstance(row, dict) or not isinstance(row.get("name"), str):
            raise Internal("the backend returned a malformed attachment row")
        # Rebuilt key by key rather than passed through. A backend that grew a
        # third key would otherwise publish it here without anyone deciding to,
        # and the key it would most plausibly grow is the content.
        out.append({"name": row["name"], "size": int(row.get("size") or 0)})
    return {"uuid": uuid, "total": len(out), "attachments": out}


def v_attach_get(req, ctx):
    """Attachment bytes stream back through the Cockpit channel to the browser.
    Nothing lands on this host's disk, and no destination path is accepted from
    the caller — that whole shape is the I21 exfiltration channel."""
    uuid = req.get("uuid")
    name = req.get("name")
    if not isinstance(uuid, str) or not uuid:
        raise Invalid("uuid is required")
    if not isinstance(name, str) or not name or len(name) > 255:
        raise Invalid("name is required and must be 255 characters or fewer")
    backend, entry, kind = need_backend(req, ctx, verb="attach-get")
    try:
        out = backend.attach_get(uuid, name)
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed attachment result")
    return out


# ----------------------------------------------------------- mutation -----

def _mutate(req, ctx, verb, fn):
    """Run one mutating verb, and refuse the shape that would silently lose it.

    Mutations are in-memory until `save` (contract invariant 3). A single-shot
    invocation that mutates and exits therefore discards the change with the
    address space — a no-op that looks like a success, which is the worst kind.
    So a mutation outside an `open` session is refused unless the request opts
    in to `autosave`, which makes unlock -> mutate -> save one explicit,
    auditable operation.
    """
    autosave = bool(req.get("autosave"))
    if not req.get("handle") and not autosave:
        raise Invalid("a mutation outside an open session would be discarded "
                      "when the helper exits; open a session, or set autosave "
                      "to unlock, change and save in one operation")
    backend, entry, kind = need_backend(req, ctx, verb=verb, write=True)
    try:
        out = fn(backend)
        if not isinstance(out, dict):
            raise Internal("the backend returned a malformed %s result" % verb)
        out = scrub_listing(out, verb)
        if kind == "transient":
            saved = backend.save(
                override_stale=bool(req.get("override_stale")))
            out["saved"] = True
            out["backup"] = (saved or {}).get("backup")
            out["bytes"] = (saved or {}).get("bytes")
        else:
            out["saved"] = False
            sess = find_session(req.get("handle"), ctx.ident)
            sess.mutated = True
        return out
    finally:
        if kind == "transient":
            backend.lock()


def _require_str(req, name, maxlen=1024, optional=False):
    value = req.get(name)
    if value is None and optional:
        return None
    if not isinstance(value, str) or not value:
        raise Invalid("%s is required" % name)
    if len(value) > maxlen:
        raise Invalid("%s must be %d characters or fewer" % (name, maxlen))
    return value


def _require_group(req, name):
    """A GROUP ID, which is not the same shape as an entry uuid.

    A group id is whatever `tree` put in a row's `uuid`, and for one of the two
    formats that includes the empty string: PWS3 gives groups no uuid, so a
    group IS its '.'-delimited path and the root's path is "". Validating it
    with _require_str() rejected "" as missing and made the PWS3 root
    unreachable — `move` into it answered {"error":"invalid","detail":"group is
    required"} for a request the backend would have honoured. Both backends
    resolve None and "" to their own root, so both are passed through as the
    caller sent them; neither is coerced into the other.
    """
    value = req.get(name)
    if value is None:
        return None
    if not isinstance(value, str):
        raise Invalid("%s must be a string" % name)
    if len(value) > 1024:
        raise Invalid("%s must be 1024 characters or fewer" % name)
    return value


def _require_obj(req, name):
    value = req.get(name)
    if not isinstance(value, dict) or not value:
        raise Invalid("%s must be a non-empty object" % name)
    return value


def v_add(req, ctx):
    group = req.get("group")
    if group is not None and not isinstance(group, str):
        raise Invalid("group must be a string")
    entry_obj = _require_obj(req, "entry")
    return _mutate(req, ctx, "add", lambda b: b.add(group, entry_obj))


def v_edit(req, ctx):
    uuid = _require_str(req, "uuid")
    changes = _require_obj(req, "changes")
    return _mutate(req, ctx, "edit", lambda b: b.edit(uuid, changes))


def v_move(req, ctx):
    uuid = _require_str(req, "uuid")
    group = _require_group(req, "group")
    return _mutate(req, ctx, "move", lambda b: b.move(uuid, group))


def v_rm(req, ctx):
    uuid = _require_str(req, "uuid")
    permanent = bool(req.get("permanent"))
    return _mutate(req, ctx, "rm", lambda b: b.rm(uuid, permanent=permanent))


def v_group_add(req, ctx):
    parent = _require_group(req, "parent")
    name = _require_str(req, "name", maxlen=255)
    return _mutate(req, ctx, "group-add", lambda b: b.group_add(parent, name))


def v_group_rm(req, ctx):
    uuid = _require_str(req, "uuid")
    permanent = bool(req.get("permanent"))
    return _mutate(req, ctx, "group-rm",
                   lambda b: b.group_rm(uuid, permanent=permanent))


def v_group_mv(req, ctx):
    uuid = _require_str(req, "uuid")
    parent = _require_group(req, "parent")
    return _mutate(req, ctx, "group-mv", lambda b: b.group_mv(uuid, parent))


def v_save(req, ctx):
    """Session-only on purpose: an unlock-then-save with no mutation between
    them rewrites the file for nothing, and rewriting a password safe for
    nothing is how a backup ring fills with identical generations."""
    handle = req.get("handle")
    if not handle:
        raise Invalid("save needs a handle from an open session; a single-shot "
                      "mutation should use autosave instead")
    sess = find_session(handle, ctx.ident)
    ctx.safe_id = sess.safe
    gate(sess.entry, ctx.ident, want_write=True)
    # A stale `.lock`/`.plk` — the debris a helper killed mid-save leaves —
    # otherwise makes the safe permanently un-savable, because LockFile removes
    # only a lock still carrying OUR token and has no timeout heuristic (I13,
    # deliberately). The override is per-call, explicit, never inferred, and
    # the schema marks the field so the UI has to ask before sending it.
    out = sess.backend.save(override_stale=bool(req.get("override_stale")))
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed save result")
    sess.mutated = False
    out.setdefault("ok", True)
    out.setdefault("conflict", False)
    return scrub_listing(out, "save")


# -------------------------------------------------------------- tools -----

#: No quote, backslash or space: those are the characters that get mangled by a
#: shell, a CSV export or a config file somewhere downstream, and a password
#: that cannot be pasted is a password that gets written down.
GEN_SYMBOLS = "!#$%&()*+,-./:;<=>?@[]^_{|}~"
#: Removed when exclude_ambiguous is on — the pairs people mistype off a screen.
GEN_AMBIGUOUS = "0OoIl1|`',\";:.{}[]()"
GEN_CLASSES = (
    ("upper", "ABCDEFGHIJKLMNOPQRSTUVWXYZ"),
    ("lower", "abcdefghijklmnopqrstuvwxyz"),
    ("digits", "0123456789"),
    ("symbols", GEN_SYMBOLS),
)


def v_generate(req, ctx):
    """A password from `secrets.SystemRandom`, with the entropy calculation.

    `random` is a Mersenne Twister: 624 outputs recover the state and every
    password it ever generates, before or after. `SystemRandom.choice` draws
    from the OS CSPRNG through `_randbelow`, which rejection-samples rather
    than taking a modulus, so every character is uniform over the alphabet and
    the reported entropy is the real figure.
    """
    policy = req.get("policy")
    if policy is None:
        policy = {}
    if not isinstance(policy, dict):
        raise Invalid("policy must be an object")

    length = policy.get("length", 20)
    if not _is_int(length) or not 8 <= length <= 256:
        raise Invalid("policy.length must be an integer between 8 and 256")

    wanted = []
    for name, chars in GEN_CLASSES:
        default = name != "symbols" or True
        flag = policy.get(name, default if name != "symbols" else True)
        if not isinstance(flag, bool):
            raise Invalid("policy.%s must be true or false" % name)
        if flag:
            wanted.append((name, chars))
    if not wanted:
        raise Invalid("at least one character class must be enabled")

    custom = policy.get("symbol_set")
    if custom is not None:
        if not isinstance(custom, str) or not 1 <= len(custom) <= 128:
            raise Invalid("policy.symbol_set must be 1..128 characters")
        wanted = [(n, custom if n == "symbols" else c) for n, c in wanted]

    exclude = policy.get("exclude_ambiguous", True)
    require_each = policy.get("require_each", True)
    for name, flag in (("exclude_ambiguous", exclude),
                       ("require_each", require_each)):
        if not isinstance(flag, bool):
            raise Invalid("policy.%s must be true or false" % name)

    pools = []
    for name, chars in wanted:
        pool = "".join(dict.fromkeys(
            c for c in chars
            if not (exclude and c in GEN_AMBIGUOUS)))
        if pool:
            pools.append((name, pool))
    if not pools:
        raise Invalid("every selected character class is empty after "
                      "excluding ambiguous characters")

    alphabet = "".join(dict.fromkeys("".join(p for _, p in pools)))
    if len(alphabet) < 2:
        raise Invalid("the alphabet must have at least two characters")
    if require_each and length < len(pools):
        raise Invalid("policy.length is shorter than the number of required "
                      "character classes")

    rng = _sysrandom.SystemRandom()
    value = None
    for _ in range(10000):
        candidate = "".join(rng.choice(alphabet) for _ in range(length))
        if not require_each or all(any(c in pool for c in candidate)
                                   for _, pool in pools):
            value = candidate
            break
    if value is None:
        raise Internal("the generator could not satisfy its own policy")

    bits = length * math.log2(len(alphabet))
    out = {
        "value": value,
        "length": length,
        "alphabet_size": len(alphabet),
        "entropy_bits": round(bits, 1),
        "calculation": "%d characters x log2(%d) = %.1f bits"
                       % (length, len(alphabet), bits),
        "classes": [name for name, _ in pools],
        "source": "secrets.SystemRandom (the OS CSPRNG), rejection sampled",
        "note": "",
    }
    if require_each:
        out["note"] = ("requiring one of each class rejects some strings, so "
                       "the true entropy is a fraction of a bit below the "
                       "figure above")
    return out


# ===========================================================================
# resolving a request to an ENTRY without unlocking anything
# ===========================================================================

def _entry_for(req, ctx):
    """The registry entry a request names — and NOT a credential of any kind.

    `need_backend` resolves a request all the way to an unlocked database,
    which is the wrong order for a verb whose first job is to refuse. `export`
    must decide that this caller may not export BEFORE it accepts a passphrase
    and runs a KDF against it: a refusal that costs an operator their
    passphrase is a refusal that taught an attacker their passphrase was
    plausible. This returns the entry, so the cheap refusals can happen first.
    """
    handle = req.get("handle")
    if handle:
        sess = find_session(handle, ctx.ident)
        ctx.safe_id = sess.safe
        return sess.entry
    entry = lookup_safe(req.get("safe"), ctx)
    ctx.safe_id = entry["id"]
    return entry


# ===========================================================================
# export — the most dangerous verb in the program  (I21)
# ===========================================================================
#
# Everything else here hands out one field at a time through one audited door.
# This writes EVERY password in the safe to a file in the clear, in one act.
# Four independent things must all be true before a byte is written, and none
# of them is a browser-side check:
#
#   1. the safe's access class is `admin` AND the caller passes the admin gate
#      — euid 0, plus membership of an administrative group, from the kernel;
#   2. the registry entry sets `export_allowed: true` — an operator decision
#      recorded in a root-owned file, not a request field;
#   3. the request carries the exact confirmation token for THIS safe id, so a
#      confirm the operator gave for a throwaway safe cannot be replayed
#      against the domain-administrator safe;
#   4. the destination is derived HERE from the registry and a UTC stamp. No
#      caller-supplied path reaches the filesystem (I4) — that whole shape is
#      the exfiltration channel I21 names.
#
# The response carries the path, the size and the row count. It does NOT carry
# the content: an export that streamed back through the Cockpit channel would
# put the entire safe in the browser's heap, and the operator asked for a file.


def export_dir_for(entry):
    """Where an export lands. Registry `export_dir`, else the default.

    The default follows `COCKPIT_SECRETS_VAR` when it is set, for the same
    reason the audit log does: the test suite has to be able to run this verb
    without writing into /var/lib, and a seam that only moves data is not a
    hole (see the module docstring).
    """
    named = entry.get("export_dir")
    if named:
        return named
    var = _var_root()
    if var:
        return os.path.join(var, DEFAULT_EXPORT_SUBDIR)
    return DEFAULT_EXPORT_DIR


def _export_health(ctx):
    """What `export` would do right now, for `health` — without doing it.

    An operator needs to be able to answer "which safes on this host can be
    dumped in the clear, and where would that land" without running the verb.
    """
    rows = []
    for sid in sorted(ctx.registry):
        entry = ctx.registry[sid]
        if not entry.get("export_allowed"):
            continue
        rows.append({"safe": sid, "access": entry["access"],
                     "dir": export_dir_for(entry)})
    return {
        "enabled_safes": rows,
        "default_dir": DEFAULT_EXPORT_DIR,
        "formats": list(EXPORT_FORMATS),
        "confirm_prefix": EXPORT_CONFIRM_PREFIX,
        "note": "export writes every password in the safe to a 0600 file in "
                "the clear; it is admin-class, off unless the registry enables "
                "it, and refused without the per-safe confirmation token",
    }


def _write_export(dirpath, safe_id, fmt, data):
    """Write one export 0600 into a 0700 directory. Returns (path, name).

    The name is `<safe id>-<UTC stamp>.<ext>` and every part of it comes from
    the registry or the clock. `O_EXCL` so an export can never overwrite an
    earlier one — a dump of a safe is evidence, and evidence that silently
    replaces evidence is not much use. `O_NOFOLLOW` so the export directory
    cannot be salted with symlinks by anyone who can write into it.
    """
    root = _ensure_dir(dirpath, 0o700)
    if root is None:
        raise Internal("the export directory could not be created 0700 and "
                       "owned by this caller")
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    for attempt in range(16):
        name = "%s-%s%s.%s" % (safe_id, stamp,
                               "" if attempt == 0 else "-%d" % attempt,
                               EXPORT_SUFFIX[fmt])
        path = os.path.join(root, name)
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                         | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        except FileExistsError:
            continue
        except OSError as exc:
            raise Internal("the export file could not be created (%s)"
                           % errno.errorcode.get(exc.errno, "EIO"))
        try:
            os.fchmod(fd, 0o600)      # explicit; umask must not get a vote
            # One write loop for the whole program (backends/base.py). This
            # site was already correct; using the shared helper is what keeps
            # it correct and lets validate.sh ban the bare form everywhere.
            write_all(fd, data)
            os.fsync(fd)
            if os.fstat(fd).st_size != len(data):
                raise Internal("the export is short (%d of %d bytes)"
                               % (os.fstat(fd).st_size, len(data)))
        except OSError as exc:
            try:
                os.unlink(path)
            except OSError:
                pass
            raise Internal("the export could not be written (%s)"
                           % errno.errorcode.get(exc.errno, "EIO"))
        finally:
            os.close(fd)
        return path, name
    raise Internal("could not pick an unused export file name")


def v_export(req, ctx):
    """Write the whole safe to disk in PLAINTEXT. Refused four ways first."""
    entry = _entry_for(req, ctx)

    # -- 1. the class gate, from kernel identity, before anything else -----
    gate(entry, ctx.ident)
    if entry.get("access", "admin") != "admin":
        # A user-class safe is not exportable at all. The gate above passed for
        # it — it is that user's own file — but "you own it" is not the same
        # permission as "this Cockpit page may write it out in the clear".
        raise AccessDenied("export is an administrator-class verb; this safe "
                           "is user-class")

    # -- 2. the registry switch, off by default ---------------------------
    if not entry.get("export_allowed"):
        raise AccessDenied("this safe does not permit export; set "
                           "export_allowed in its registry entry if that is "
                           "genuinely intended")

    fmt = req.get("fmt")
    if fmt not in EXPORT_FORMATS:
        raise Invalid("fmt must be one of %s" % ", ".join(EXPORT_FORMATS))

    # -- 3. the confirmation the UI must have shown the operator ----------
    want = EXPORT_CONFIRM_PREFIX + entry["id"]
    confirm = req.get("confirm")
    if not isinstance(confirm, str) or not constant_time_eq(confirm, want):
        raise AccessDenied(
            "export requires the confirmation token %r, which the UI must "
            "show the operator in full before sending" % want)

    backend, resolved, kind = need_backend(req, ctx, verb="export")
    try:
        fn = getattr(backend, "export_plain", None)
        if not callable(fn):
            raise Unsupported("the %s backend does not implement "
                              "export_plain" % resolved["format"])
        data = fn(fmt=fmt)
        if not isinstance(data, (bytes, bytearray)):
            raise Internal("the backend returned a malformed export")
        data = bytes(data)
        # The row count comes from `entries`, not from counting lines in the
        # export: one format-independent number that means the same thing for
        # csv, xml and json, and no parser of our own output to get wrong.
        listing = backend.entries(offset=0, limit=1)
        rows = listing.get("total") if isinstance(listing, dict) else None
        rows = int(rows) if _is_int(rows) else 0
        path, name = _write_export(export_dir_for(resolved), resolved["id"],
                                   fmt, data)
    finally:
        if kind == "transient":
            backend.lock()

    # I21: "always audited by name". The name and the row count go on the
    # audit line; the content does not go anywhere except that one 0600 file.
    ctx.artifact = name
    ctx.rows = rows
    warning = ("this file is the entire safe in plaintext; move it to "
               "where it belongs and delete it")
    # How many CSV cells began with a spreadsheet formula character and were
    # given a leading apostrophe. Reported rather than done quietly: the change
    # is a deliberate divergence from KeePassXC's CSV (see backends/base.py
    # `csv_cell`), and an operator re-importing the file has to know to strip
    # it. Zero on every ordinary export, so the noise is paid only when it is
    # the answer to a real question.
    neutralised = int(getattr(backend, "last_export_neutralised", 0) or 0)
    if neutralised:
        warning += ("; %d cell(s) began with a character a spreadsheet reads "
                    "as a formula (= + - @ tab CR) and were prefixed with an "
                    "apostrophe so they cannot execute — strip one leading "
                    "apostrophe if you import this elsewhere" % neutralised)
    return {"path": path, "bytes": len(data), "entries": rows, "fmt": fmt,
            "mode": "0600", "name": name,
            "neutralised": neutralised,
            "warning": warning}


# ===========================================================================
# save-as — a NEW file, from a bare name, beside the original
# ===========================================================================

#: Characters that must never appear in a save-as target name. `/` and `\`
#: because a name is not a path; NUL because everything below Python's string
#: layer is C and a truncated path is a different path than the one validated.
_NAME_FORBIDDEN = ("/", "\\", "\x00")


def _target_path(req, entry):
    """A caller's bare `name` -> an absolute path beside the source safe.

    The caller never supplies a path (I4). They supply a NAME, which is
    refused unless it is a single ordinary file name, and it is joined to the
    directory the registry already named. Five refusals, in the order that
    gives the clearest message, then one belt-and-braces check that the join
    really did stay in the same directory.
    """
    name = req.get("name")
    if not isinstance(name, str) or not name:
        raise Invalid("name is required")
    if len(name) > 128:
        raise Invalid("name must be 128 characters or fewer")
    for ch in _NAME_FORBIDDEN:
        if ch in name:
            raise Invalid("a target name is a file name, not a path: it may "
                          "not contain a slash, a backslash or a NUL")
    if name.startswith("."):
        # Also refuses "." and "..", and refuses hiding the copy of a password
        # safe as a dotfile.
        raise Invalid("a target name may not start with a dot")
    if not _ARTIFACT_RE.match(name):
        # The same pattern the audit log accepts. I21 wants a file this program
        # creates to be auditable by name, and a name the log would have to
        # drop is a file with no trail. Refusing it here is the cheaper end of
        # that bargain.
        raise Invalid("a target name must match %s"
                      % _ARTIFACT_RE.pattern)

    directory = os.path.dirname(entry["path"])
    target = os.path.join(directory, name)
    if os.path.dirname(target) != directory:
        raise Invalid("the target name does not resolve beside the safe")
    if os.path.lexists(target):
        # lexists, not exists: a dangling symlink already sitting on the name
        # must be a refusal, not something os.open would happily create through.
        raise Conflict("a file with that name already exists beside the safe")
    return target, name


def v_save_as(req, ctx):
    """Write the in-memory database to a NEW file. The original is untouched.

    Registered read-only counts here even though nothing writes the original:
    `mode: "ro"` is the operator saying this plugin does not produce new copies
    of this safe, and a duplicate created beside it is a second file with the
    same secrets in it and none of the operator's attention on it.
    """
    entry = _entry_for(req, ctx)
    gate(entry, ctx.ident, want_write=True)
    # The target is resolved and refused BEFORE a passphrase is accepted: a bad
    # name should cost the operator a retype, not an unlock.
    target, name = _target_path(req, resolve_entry(entry, ctx.ident))

    backend, opened, kind = need_backend(req, ctx, verb="save-as", write=True)
    try:
        fn = getattr(backend, "save_as", None)
        if not callable(fn):
            raise Unsupported("the %s backend does not implement save_as"
                              % opened["format"])
        out = fn(target, override_stale=bool(req.get("override_stale")))
    finally:
        if kind == "transient":
            backend.lock()
    if not isinstance(out, dict):
        raise Internal("the backend returned a malformed save_as result")
    out = dict(out)
    out.setdefault("path", target)
    out.setdefault("bytes", 0)
    out["name"] = name
    out["ok"] = True
    ctx.artifact = name
    return out


# ===========================================================================
# the backup ring — list it, and restore from it
# ===========================================================================

#: The first bytes of each format, checked before a backup is allowed to
#: replace a live safe. KDBX signature 1 is 0x9AA2D903 little-endian; PWS3
#: opens with its literal tag. This does not prove a backup is GOOD — only the
#: passphrase can do that — but it does prove it is not a truncated file, an
#: error page, or something a ring directory picked up by accident, and
#: refusing those costs nothing.
_SAFE_MAGIC = {"kdbx": (b"\x03\xd9\xa2\x9a",), "psafe3": (b"PWS3",)}


def _backup_ring(entry):
    """(directory, rows newest first). Rows are {name, when, size}.

    The directory is `backup_dir_for()` — the SAME function `atomic_replace`
    uses — so this lists what `save` writes and nothing else. Only names the
    ring itself produces are listed: `<safe basename>.<stamp>.<pid>.bak`. That
    is also what makes `restore-backup` safe, because it restores by
    membership of this list rather than by a path.
    """
    path = entry["path"]
    bdir = backup_dir_for(path, (entry.get("backup") or {}).get("dir"))
    base = os.path.basename(path)
    rows = []
    try:
        with os.scandir(bdir) as it:
            for item in it:
                name = item.name
                if not name.startswith(base + ".") or not name.endswith(".bak"):
                    continue
                try:
                    if not item.is_file(follow_symlinks=False):
                        continue
                    st = item.stat(follow_symlinks=False)
                except OSError:
                    continue
                rows.append({"name": name, "when": _iso_utc(st.st_mtime),
                             "size": st.st_size})
    except OSError:
        # A ring that does not exist yet is an empty ring, not an error: a safe
        # that has never been saved has no generations.
        return bdir, []
    # The stamp is the second field and is UTC, so lexical order IS
    # chronological order (backends/base.py `_ring_backup` says so and puts the
    # timestamp first for exactly this reason). Newest first.
    rows.sort(key=lambda r: r["name"], reverse=True)
    return bdir, rows[:MAX_BACKUP_LIST]


def v_backups(req, ctx):
    """List the backup ring for a safe. Metadata only; no credential needed.

    No passphrase, because there is nothing here to decrypt — a name, a time
    and a size. The class gate still runs: which safes exist and how often they
    change is not something a caller who cannot open the safe should learn.
    """
    entry = _entry_for(req, ctx)
    gate(entry, ctx.ident)
    resolved = resolve_entry(entry, ctx.ident)
    bdir, rows = _backup_ring(resolved)
    keep = (resolved.get("backup") or {}).get("keep") \
        or Limits.DEFAULT_BACKUP_KEEP
    return {"safe": resolved["id"], "dir": bdir, "keep": keep,
            "total": len(rows), "backups": rows}


def _read_backup(bdir, name, fmt):
    """Read one generation through the same guard a safe file gets (I5).

    O_NOFOLLOW and fstat on the fd, owner and mode checked on the descriptor,
    size bounded, and the format's magic checked before the bytes are allowed
    anywhere near `atomic_replace`.
    """
    path = os.path.join(bdir, name)
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Invalid("that backup generation is not a regular file")
        if st.st_uid != os.geteuid():
            raise AccessDenied("that backup generation is owned by another "
                               "user")
        if stat.S_IMODE(st.st_mode) & 0o077:
            raise AccessDenied("that backup generation is group- or "
                               "other-accessible; it must be 0600")
        if st.st_size <= 0:
            raise Invalid("that backup generation is empty")
        if st.st_size > Limits.MAX_SAFE_BYTES:
            raise Invalid("that backup generation is larger than the %d byte "
                          "limit" % Limits.MAX_SAFE_BYTES)
        data = b""
        while len(data) < st.st_size:
            chunk = os.read(fd, min(1 << 20, st.st_size - len(data)))
            if not chunk:
                break
            data += chunk
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise AccessDenied("that backup generation is a symbolic link")
        if exc.errno == errno.ENOENT:
            raise NotFound("no backup generation with that name")
        raise Invalid("that backup generation could not be read")
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    magics = _SAFE_MAGIC.get(fmt, ())
    if magics and not any(data.startswith(m) for m in magics):
        raise Invalid("that backup generation is not a %s database; nothing "
                      "was written" % fmt)
    # AND THAT IT IS A WHOLE ONE. The magic proves the first four bytes; it
    # proves nothing about the last four, and a prefix of a real database keeps
    # its magic. `restore-backup` is the recovery path of last resort and it
    # used to install a file it had not checked: a 4096-byte prefix of a
    # 4661-byte KDBX — produced by a short write on a full filesystem — was
    # accepted, written over the live safe, and the safe then did not open.
    # `verify_structure` walks the format's own framing with no credential,
    # which is the strongest statement available to a verb that deliberately
    # takes no passphrase. It is NOT a claim that the file decrypts.
    try:
        # `load_backend_class`, not `backend_for`: the backend module is
        # imported lazily, and `backend_for` on a format nobody has imported
        # yet raises Unsupported — which the handler below would have read as
        # "this format has no completeness check" and waved the generation
        # through. That is the finding coming back through the fix, so the
        # lookup is the one that guarantees the import.
        load_backend_class(fmt).verify_structure(data)
    except Unsupported:
        # A format with no completeness check gets the magic test and a note,
        # rather than a silent pass that reads like verification.
        _note("no completeness check exists for format %r; restoring a "
              "generation on the magic bytes alone" % fmt)
    except SecretsError as exc:
        raise Invalid("that backup generation is not a complete %s database "
                      "(%s); nothing was written" % (fmt, exc.detail))
    return data


def v_restore_backup(req, ctx):
    """Put one generation back, atomically, and back up what it replaces.

    A restore is a MUTATION OF THE LIVE SAFE, and the most dangerous kind: it
    discards everything since that generation in one act. So it is the same
    write discipline `save` uses and nothing weaker —

      - the desktop clients' own lock file is held for the whole operation, so
        a restore cannot land underneath KeePassXC (I13);
      - the live file is fingerprinted immediately before the replace and that
        fingerprint is handed to `atomic_replace`, so anything that changed the
        file in between is a `conflict` and nothing is written;
      - `atomic_replace` copies the CURRENT file into the ring before writing,
        so ONE unwanted restore is undoable — the generation just replaced is
        the newest one in the listing afterwards.

    WHAT "UNDOABLE" DOES NOT MEAN, because the verb used to claim more than it
    could deliver. The ring is a FIXED-SIZE ring of `keep` generations, and
    every restore pushes one more in. After `keep` restores no generation holds
    the state the operator started from and nothing on the host can recover it.
    Measured with keep=3: four ordinary saves, then five restores, and the
    state the operator had at the start existed in zero of three ring slots —
    while every reply had said "this restore is itself undoable". The verb now
    says what is actually true, per call, in `undo`, and sets `ring_full` so a
    caller can warn before the ring starts discarding rather than after.

    Deliberately NOT required: the passphrase. A restore is a recovery
    operation and the usual reason to want one is that the live file no longer
    opens. Requiring a credential to fix a file that cannot be opened would
    make the verb useless in exactly the case it exists for. The class gate,
    the write gate, the lock file, the fingerprint and the audit line all still
    apply, and none of them needs a key.
    """
    entry = _entry_for(req, ctx)
    gate(entry, ctx.ident, want_write=True)
    resolved = resolve_entry(entry, ctx.ident)

    name = req.get("name")
    bdir, rows = _backup_ring(resolved)
    if not isinstance(name, str) or not name:
        raise Invalid("name is required")
    # MEMBERSHIP OF THE LISTING, not a path test. A traversal-shaped name
    # cannot be in a listing built from `scandir` of one directory, so there is
    # no path to sanitise and nothing to get wrong twice.
    if not any(constant_time_eq(row["name"], name) for row in rows):
        raise NotFound("no backup generation with that name")

    data = _read_backup(bdir, name, resolved["format"])
    backup_cfg = resolved.get("backup") or {}
    keep = backup_cfg.get("keep") or Limits.DEFAULT_BACKUP_KEEP

    with LockFile(resolved["path"], fmt=resolved["format"],
                  override_stale=bool(req.get("override_stale"))):
        try:
            with open_safe_fd(resolved["path"]) as sf:
                fingerprint = sf.fingerprint()
        except NotFound:
            # The safe is gone entirely — someone deleted it, which is a very
            # good reason to be restoring a backup. There is nothing to
            # conflict with, so the re-check is skipped rather than faked.
            fingerprint = None
        result = atomic_replace(resolved["path"], data,
                                backup_dir=backup_cfg.get("dir"), keep=keep,
                                expect_fingerprint=fingerprint)

    ctx.artifact = name
    # What the ring looks like AFTER the write, so the sentence below is a
    # measurement rather than a promise. `keep` is the ring size; once it is
    # full every further restore evicts the oldest generation, and the oldest
    # generation is the operator's own history.
    _bdir, after = _backup_ring(resolved)
    ring_full = len(after) >= keep
    if fingerprint is None:
        undo = ("the safe did not exist before this restore, so there is "
                "nothing to undo back to")
    elif ring_full:
        undo = ("the file this replaced is now the newest of %d generations "
                "and the ring is FULL: the next save or restore discards the "
                "oldest one permanently. Copy anything you still need out of "
                "the ring before repeating this." % len(after))
    else:
        undo = ("the file this replaced is now the newest of %d generations, "
                "so this restore can be undone — but the ring holds %d, and "
                "each restore pushes one more in" % (len(after), keep))
    return {"ok": True, "restored": name, "bytes": result.get("bytes"),
            "backup": result.get("backup"),
            "created": fingerprint is None,
            "ring_full": ring_full,
            "undo": undo,
            "note": undo}


# ===========================================================================
# entry history
# ===========================================================================
#
# WHY THERE IS NO `history-reveal`, stated here because the absence is the
# design decision and an absence has nowhere else to be documented.
#
# `history` returns metadata and `has_password`, never a value. Getting an old
# password takes two steps: `history-restore` it onto the entry, then `reveal`
# it. That is deliberately more work than a direct `history-reveal` would be,
# for two reasons:
#
#   1. `reveal` is the only door (docs/CONTRACT.md invariant 1). A second door
#      that reads values out of history would let one unlock enumerate every
#      password an entry has EVER held — the exact opposite of "one field, one
#      entry, one audit line" — and it would do it without changing anything an
#      operator could later notice.
#   2. A restore is visible in the database. The current version is pushed onto
#      the history first, so the act leaves a mark and is itself undoable, and
#      the subsequent `reveal` writes its own audit line naming the safe and
#      the uid. Two auditable acts beat one invisible one.
#
# The cost is honest and small: reading an old password changes the entry, and
# the operator has to put it back (or not save). That is the right trade for
# the one program on this host that must not have a quiet way to read secrets.


def _history_rows(versions, uuid):
    """`Backend.history`'s list of rows -> the object the UI renders.

    The backend interface returns a bare list; the verb answers an object, for
    the same reason `entries` does — a caller reading frames off a session
    stream needs a `uuid` to pair the answer to its request, and a `total` it
    did not have to compute by measuring an array.

    The per-row defaults matter more than they look. The schema promises the UI
    `{index, when, title, username, url, has_password, notes_len}` for every
    row from every format, and PWS3's history is a list of (time, password)
    pairs with no title or URL in it at all. Filling the absent keys with null
    here is what makes the promise true for both formats, instead of leaving
    the UI to test for the presence of a key — which is a UI that will one day
    guess.
    """
    if not isinstance(versions, list):
        raise Internal("the backend returned a malformed history result")

    # ORDERING IS PART OF THE CONTRACT, not an implementation detail. Both
    # backends return their versions OLDEST FIRST, so `index` counts FORWARDS
    # through time: 0 is the oldest recorded version and the highest index is
    # the most recently archived one. It is enumerated here rather than taken
    # from the backend so the two formats cannot disagree about it, and it is
    # what `history-restore` is addressed by, so a UI that re-sorts must carry
    # `index` on the row rather than recompute it from its own display order.
    #
    # This descriptor was wrong once, in exactly the way that costs an hour:
    # the schema said "0 is the most recently archived version", secrets.js
    # correctly believed the schema and sorted descending, and the result put
    # the newest version first while labelling it the oldest. Whoever changes
    # the direction here changes it in three places — this comment, the
    # `index` field's help text, and the sort in `renderHistoryList`.
    # CLAMPED, and the clamp keeps the indexes honest. Truncation is from the
    # END, so index 0 stays the oldest version and a restore addressed by an
    # index this listing showed still means what it meant — dropping from the
    # front would silently renumber every row and make a restore act on the
    # wrong version. `truncated` says so out loud rather than leaving a caller
    # to infer it from a suspiciously round total.
    truncated = max(0, len(versions) - Limits.MAX_HISTORY_VERSIONS)
    if truncated:
        versions = versions[:Limits.MAX_HISTORY_VERSIONS]

    rows = []
    for index, item in enumerate(versions):
        if not isinstance(item, dict):
            raise Internal("the backend returned a malformed history version")
        row = dict(item)
        row.setdefault("index", index)
        for key in ("when", "title", "username", "url", "has_password",
                    "notes_len"):
            row.setdefault(key, None)
        rows.append(row)
    out = {"uuid": uuid, "total": len(rows), "versions": rows}
    if truncated:
        out["truncated"] = truncated
        out["warning"] = ("this entry declares more archived versions than "
                          "the %d this verb will enumerate; the %d oldest are "
                          "listed" % (Limits.MAX_HISTORY_VERSIONS,
                                      Limits.MAX_HISTORY_VERSIONS))
    return out


def v_history(req, ctx):
    """Previous versions of one entry. Metadata only — never a password."""
    uuid = _require_str(req, "uuid")
    backend, entry, kind = need_backend(req, ctx, verb="history")
    try:
        fn = getattr(backend, "history", None)
        if not callable(fn):
            raise Unsupported("the %s backend does not keep entry history"
                              % entry["format"])
        out = fn(uuid)
    finally:
        if kind == "transient":
            backend.lock()
    return _history_rows(out, uuid)


def v_history_restore(req, ctx):
    """Put an entry back to one of its previous versions. In memory until save."""
    uuid = _require_str(req, "uuid")
    index = req.get("index")
    if not _is_int(index) or index < 0 or index > Limits.MAX_ENTRIES:
        raise Invalid("index must be a non-negative integer from the history "
                      "listing")

    def run(backend):
        fn = getattr(backend, "history_restore", None)
        if not callable(fn):
            raise Unsupported("this backend does not keep entry history")
        out = fn(uuid, index)
        if not isinstance(out, dict):
            raise Internal("the backend returned a malformed history_restore "
                           "result")
        out = dict(out)
        out.setdefault("uuid", uuid)
        out.setdefault("restored_from", index)
        return out

    return _mutate(req, ctx, "history-restore", run)


# ===========================================================================
# attachments — bytes in, by value, never by path  (I4, I10)
# ===========================================================================

def _attachment_payload(req):
    """`data_b64` -> bytes, bounded TWICE and never through a temp file.

    The order matters. Base64 of N bytes is 4*ceil(N/3) characters, so a string
    of length L cannot decode to more than (L // 4) * 3 bytes — which means the
    oversize case can be refused by ARITHMETIC, before the allocation the limit
    exists to prevent. Then the decoded length is checked as well, because a
    base64 length check alone is not a bound: padding, a non-canonical tail and
    any tolerated whitespace all move the two numbers apart.
    """
    b64 = req.get("data_b64")
    if not isinstance(b64, str) or not b64:
        raise Invalid("data_b64 is required and must be base64")
    cap = Limits.MAX_ATTACHMENT_BYTES
    if (len(b64) // 4) * 3 > cap:
        raise Invalid("the attachment exceeds the %d byte limit" % cap)
    try:
        data = base64.b64decode(b64, validate=True)
    except (binascii.Error, ValueError):
        raise Invalid("the attachment content is not valid base64")
    if len(data) > cap:
        raise Invalid("the attachment exceeds the %d byte limit" % cap)
    return data


def v_attach_add(req, ctx):
    """Attach bytes to an entry. In memory until save.

    The effective ceiling is NOT `MAX_ATTACHMENT_BYTES` on this transport: the
    whole request is one JSON object capped at `MAX_REQUEST_BYTES` (1 MiB), and
    base64 costs a third on top, so about 760 KiB of attachment actually fits.
    The 32 MiB limit is still checked because it is the limit the backend and
    the file format work to, and a bound that only exists in another module is
    a bound this verb does not have.
    """
    uuid = _require_str(req, "uuid")
    name = _require_str(req, "name", maxlen=255)
    replace = bool(req.get("replace"))
    data = _attachment_payload(req)
    size = len(data)

    def run(backend):
        fn = getattr(backend, "attach_add", None)
        if not callable(fn):
            raise Unsupported("this backend does not support attachments")
        # DECODED BYTES, not the base64. The decode happens here, once, where
        # the bound is enforced — a backend that decoded it again would be a
        # second place for the limit to be got wrong.
        out = fn(uuid, name, data, replace=replace)
        if not isinstance(out, dict):
            raise Internal("the backend returned a malformed attach_add "
                           "result")
        out = dict(out)
        out.setdefault("ok", True)
        out.setdefault("name", name)
        out.setdefault("size", size)
        return out

    return _mutate(req, ctx, "attach-add", run)


def v_attach_rm(req, ctx):
    """Detach one attachment from an entry. In memory until save."""
    uuid = _require_str(req, "uuid")
    name = _require_str(req, "name", maxlen=255)

    def run(backend):
        fn = getattr(backend, "attach_rm", None)
        if not callable(fn):
            raise Unsupported("this backend does not support attachments")
        out = fn(uuid, name)
        if not isinstance(out, dict):
            raise Internal("the backend returned a malformed attach_rm result")
        out = dict(out)
        out.setdefault("ok", True)
        out.setdefault("name", name)
        return out

    return _mutate(req, ctx, "attach-rm", run)


# ===========================================================================
# strength — estimated HERE, and the value goes no further
# ===========================================================================
#
# Two properties this verb has that no library dependency would have given us:
#
#   - the candidate never leaves this process. It is not sent anywhere, not
#     written anywhere, and not put in the audit log — the log records verb,
#     safe, uid and outcome and has no field a value could reach (I15).
#   - no weakness names the text that triggered it. "keyboard-run" is the whole
#     answer; reporting the matched fragment would put a piece of the candidate
#     in the response, and a response is a thing that gets screenshotted.
#
# The estimator is a deliberate few dozen lines rather than zxcvbn: a
# dependency here would be a third party's code reading every password an
# operator types into this page.

#: A small, blunt list: the passwords that top every breach dump, plus the
#: words that show up wrapped in digits. It is not a dictionary and does not
#: pretend to be one — `breach-check` against a real corpus is the honest
#: answer to "has this one actually been seen", and this list only catches the
#: candidate that was never going to survive anything.
_STRENGTH_WORDS = frozenset("""
password passwd pass secret letmein welcome admin administrator root toor
login user guest test qwerty asdf zxcv monkey dragon master shadow superman
batman football baseball soccer hockey iloveyou princess sunshine flower
summer winter spring autumn january february march april june july august
september october november december monday friday
apple google amazon microsoft windows linux ubuntu server domain cockpit
keepass safe vault secure changeme default temp temporary abc123 trustno1
whatever qazwsx starwars pokemon computer internet
""".split())

#: Rows and columns people walk along. Reversed forms are checked too.
_KEYBOARD_ROWS = (
    "`1234567890-=",
    "qwertyuiop[]\\",
    "asdfghjkl;'",
    "zxcvbnm,./",
    "~!@#$%^&*()_+",
    "1qaz2wsx3edc4rfv5tgb",
    "abcdefghijklmnopqrstuvwxyz",
    "0123456789",
)

#: The substitutions that make "P@ssw0rd" feel clever. Folding them is what
#: turns it back into "password" for the dictionary test.
_L33T = {"4": "a", "@": "a", "8": "b", "(": "c", "3": "e", "6": "g",
         "9": "g", "1": "l", "!": "i", "|": "l", "0": "o", "5": "s",
         "$": "s", "7": "t", "+": "t", "2": "z"}

_DATE_YEAR_RE = re.compile(r"(?:19|20)\d{2}")
_DATE_FULL_RE = re.compile(r"\d{1,2}[-/.]\d{1,2}[-/.]\d{2,4}")
_RUN_CHAR_RE = re.compile(r"(.)\1{2,}")

#: id -> (operator-facing label, bits deducted). The costs are judgement, not
#: measurement, and they are listed in one place so they can be argued with.
_STRENGTH_PENALTIES = {
    "dictionary-word": ("contains a common word or a known-bad password", 14),
    "l33t-substitution": ("a common word with digits or symbols swapped in",
                          8),
    "keyboard-run": ("four or more characters walked along a keyboard row or "
                     "column", 10),
    "repetition": ("a character or a short group repeated", 8),
    "sequence": ("an alphabetical or numeric run", 8),
    "date": ("a year or a date", 6),
    "single-class": ("only one kind of character", 10),
    "too-short": ("fewer than 12 characters", 10),
}

#: Effective bits -> category. The boundaries follow the same reasoning as the
#: generator's help text: below ~36 bits an offline attacker is done in
#: minutes, and 60 is where a modern GPU rig stops being the deciding factor.
_STRENGTH_BANDS = ((28, "very-weak"), (36, "weak"), (60, "fair"),
                   (96, "strong"))


def _fold_l33t(text):
    return "".join(_L33T.get(ch, ch) for ch in text.lower())


def _alphabet_size(value):
    """The pool an attacker would have to search, from the classes present."""
    size = 0
    if any(c.islower() for c in value):
        size += 26
    if any(c.isupper() for c in value):
        size += 26
    if any(c.isdigit() for c in value):
        size += 10
    if any((not c.isalnum()) and c != " " and ord(c) < 128 for c in value):
        size += 33
    if " " in value:
        size += 1
    if any(ord(c) > 127 for c in value):
        # A stand-in, and a conservative one: a non-ASCII character does widen
        # the search, but nothing like the size of Unicode, because an attacker
        # guesses the plane people actually type in.
        size += 100
    return max(size, 2)


def _class_count(value):
    return sum(bool(test) for test in (
        any(c.islower() for c in value),
        any(c.isupper() for c in value),
        any(c.isdigit() for c in value),
        any(not c.isalnum() for c in value),
    ))


def _keyboard_run(value):
    low = value.lower()
    for row in _KEYBOARD_ROWS:
        back = row[::-1]
        for i in range(len(low) - 3):
            frag = low[i:i + 4]
            if frag in row or frag in back:
                return True
    return False


def _repetition(value):
    if _RUN_CHAR_RE.search(value):
        return True
    # Bounded on both ends: group size up to 8 and only on a candidate we have
    # already capped, so this cannot become a regex the caller chose the cost of.
    for size in range(2, min(8, len(value) // 3) + 1):
        if re.search(r"(.{%d})\1{2,}" % size, value):
            return True
    return False


def _pattern_length(value):
    """How many characters an attacker must actually GUESS, not type.

    `length x log2(pool)` is the formula every strength meter starts with and
    it has one catastrophic failure: it rewards length regardless of content,
    so 4000 copies of the letter "a" score as unbreakable. A guesser does not
    try 4000 characters; it tries one character and a repeat count.

    Two collapses, both cheap and both bounded:

      1. a run of one character down to two — "aaaaaa" -> "aa";
      2. a whole string that is one unit repeated down to that unit —
         "abababab" -> "ab".

    Deliberately NOT a general "collapse any repeated adjacent group" regex:
    `(.+?)\\1+` needs a backreference under a lazy quantifier, and the input to
    this function is a string a caller chose, which is how a strength meter
    becomes a denial of service. Divisor testing is O(n x d(n)) with no
    backtracking at all.
    """
    squeezed = _RUN_CHAR_RE.sub(lambda m: m.group(1) * 2, value)
    n = len(squeezed)
    for size in range(1, n // 2 + 1):
        if n % size == 0 and squeezed[:size] * (n // size) == squeezed:
            return size
    return n


def _sequence(value):
    """Four or more characters whose code points step by a constant ±1."""
    run = 1
    step = None
    for a, b in zip(value.lower(), value.lower()[1:]):
        delta = ord(b) - ord(a)
        if delta in (1, -1) and (step is None or delta == step):
            step, run = delta, run + 1
            if run >= 4:
                return True
        else:
            step = delta if delta in (1, -1) else None
            run = 2 if step is not None else 1
    return False


def _estimate_strength(value):
    """Entropy, a category, and the specific weaknesses. Never the value."""
    folded = _fold_l33t(value)
    stripped = folded.strip("0123456789!@#$%^&*()_+-=[]{};:'\",.<>/?\\|`~ ")

    weaknesses = []

    def flag(wid):
        if wid not in [w["id"] for w in weaknesses]:
            label, cost = _STRENGTH_PENALTIES[wid]
            weaknesses.append({"id": wid, "label": label, "cost_bits": cost})

    hit = None
    for word in _STRENGTH_WORDS:
        if len(word) >= 4 and word in folded:
            hit = word
            break
    if hit or stripped in _STRENGTH_WORDS:
        flag("dictionary-word")
        if folded != value.lower():
            # The candidate only became a dictionary word after the l33t fold,
            # which is worth naming separately: the operator believes the
            # substitution bought them something.
            flag("l33t-substitution")
    if _keyboard_run(value):
        flag("keyboard-run")
    if _repetition(value):
        flag("repetition")
    if _sequence(value):
        flag("sequence")
    if _DATE_YEAR_RE.search(value) or _DATE_FULL_RE.search(value):
        flag("date")
    if _class_count(value) <= 1:
        flag("single-class")
    if len(value) < 12:
        flag("too-short")

    pool = _alphabet_size(value)
    raw_bits = len(value) * math.log2(pool)

    # The guessable length, not the typed one. When they differ, the repeat
    # COUNT still has to be guessed, so it is added back: an attacker trying
    # "one character, N times" pays log2(N) for choosing N.
    guessable = _pattern_length(value)
    base_bits = guessable * math.log2(pool)
    if guessable < len(value):
        base_bits += math.log2(len(value))

    penalty = sum(w["cost_bits"] for w in weaknesses)
    effective = max(0.0, base_bits - penalty)

    category = "excellent"
    for ceiling, name in _STRENGTH_BANDS:
        if effective < ceiling:
            category = name
            break

    if guessable < len(value):
        calc = ("%d characters, but only %d of them have to be guessed "
                "(the rest is the pattern repeating): %d x log2(%d) + "
                "log2(%d) = %.1f bits, less %d bits for %d weakness(es)"
                % (len(value), guessable, guessable, pool, len(value),
                   base_bits, penalty, len(weaknesses)))
    else:
        calc = ("%d characters x log2(%d) = %.1f bits, less %d bits for %d "
                "weakness(es)"
                % (len(value), pool, base_bits, penalty, len(weaknesses)))

    return {
        "length": len(value),
        "guessable_length": guessable,
        "alphabet_size": pool,
        "entropy_bits": round(raw_bits, 1),
        "effective_bits": round(effective, 1),
        "penalty_bits": penalty,
        "category": category,
        "weaknesses": weaknesses,
        "calculation": calc,
        "source": "estimated inside secrets-admin; the candidate is not "
                  "stored, not sent anywhere, and does not appear in the "
                  "audit log",
        "note": "entropy_bits is the naive length x log2(alphabet) figure; "
                "effective_bits is the one to act on. Both describe the SPACE "
                "a password was drawn from, not the one it was actually drawn "
                "from — a candidate a human chose is weaker than either "
                "number whatever the numbers say",
    }


def v_strength(req, ctx):
    """Estimate a candidate's strength. The candidate goes no further.

    Wrapping it in a `Secret` is not theatre: that registers it with
    `redact()`'s live set, so if any code below ever put a fragment of the
    candidate into an error detail, the blanket filter over stdout would catch
    it. It is zeroed BEFORE this returns, which is what keeps the same filter
    from mangling the legitimate response (see `emit`) — and it is the same
    order every credential-handling path in this file uses.

    The `str` the JSON parser made is still un-wipeable (hop 5 in
    docs/ARCHITECTURE.md). This does not fix that. The process exiting does.
    """
    raw = req.get("value")
    if not isinstance(raw, str) or not raw:
        raise Invalid("value is required")
    if len(raw) > 4096:
        raise Invalid("value must be 4096 characters or fewer")
    holder = Secret(raw)
    try:
        return _estimate_strength(raw)
    finally:
        holder.zero()


# ===========================================================================
# breach-check — OFFLINE, opt-in, and it never grows a network path
# ===========================================================================
#
# THERE IS NO FALLBACK. If no corpus is configured this verb answers
# `{"available": false, "reason": ...}` and stops. It does not resolve a name,
# it does not open a socket, it does not "just this once" ask
# api.pwnedpasswords.com. A Cockpit page that phones out about the passwords it
# holds is precisely what this project must not become, and the way to be sure
# of that is for the code path to contain no client at all — grep it.
#
# The corpus is an HIBP-style text file, one record per line:
#
#     <40 hex characters of SHA-1, upper case>:<how many times it was seen>
#
# and it is read two ways depending on size, because the real file is 30+ GiB:
#
#   - at or below BREACH_LINEAR_MAX_BYTES the whole file is scanned, which is
#     exact and assumes nothing about ordering;
#   - above it the file is BINARY SEARCHED, which is O(log n) reads but does
#     assume the HIBP ordering (sorted by hash). The response says which method
#     ran, so nothing is claimed that was not done.


def _breach_corpus_for(entry):
    """(path, where it came from) or (None, ""). Configured or absent."""
    named = entry.get("breach_corpus")
    if named:
        return named, "the safe's breach_corpus registry field"
    fallback = os.path.join(registry_root(), BREACH_CORPUS_FILE)
    if os.path.exists(fallback):
        return fallback, "%s under the registry root" % BREACH_CORPUS_FILE
    return None, ""


def _breach_health(ctx):
    """Whether breach-check would work, for `health`, without running it."""
    rows = []
    for sid in sorted(ctx.registry):
        path, source = _breach_corpus_for(ctx.registry[sid])
        if path:
            rows.append({"safe": sid, "corpus": path, "source": source})
    return {
        "enabled_safes": rows,
        "fallback": os.path.join(registry_root(), BREACH_CORPUS_FILE),
        "network": "none",
        "offline_only": True,
        "note": "breach-check has no network client at all; with no corpus "
                "configured it answers available:false and stops",
    }


def _open_corpus(path):
    """Open a corpus through the same discipline as a registry file (I5)."""
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Invalid("the breach corpus is not a regular file")
        if st.st_uid not in (0, os.geteuid()):
            raise AccessDenied("the breach corpus is owned by another user")
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            # A corpus anyone can rewrite is a corpus that answers "not
            # breached" for whatever the attacker wants it to.
            raise AccessDenied("the breach corpus is group- or "
                               "other-writable")
        if st.st_size <= 0:
            raise Invalid("the breach corpus is empty")
        return fd, st.st_size
    except OSError as exc:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if exc.errno == errno.ELOOP:
            raise AccessDenied("the breach corpus path is a symbolic link")
        if exc.errno == errno.ENOENT:
            raise NotFound("the configured breach corpus does not exist")
        raise Invalid("the breach corpus could not be opened")
    except BaseException:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        raise


def _corpus_row(line):
    """One corpus line -> (40-hex key, occurrences) or (None, 0)."""
    text = line.strip()
    if not text:
        return None, 0
    head, _, tail = text.partition(b":")
    key = head.strip().upper()
    try:
        seen = int(tail.strip() or b"0")
    except ValueError:
        seen = 0
    return key, seen


def _corpus_line_at(fd, size, off):
    """(start offset, complete line) for the line containing byte `off`.

    A line longer than BREACH_PROBE_BYTES is truncated rather than chased: an
    HIBP record is 47 bytes, and a "corpus" with a 64 KiB line is not one.
    """
    back = max(0, off - BREACH_PROBE_BYTES)
    head = os.pread(fd, off - back, back) if off > back else b""
    nl = head.rfind(b"\n")
    start = back + nl + 1 if nl >= 0 else back
    tail = os.pread(fd, BREACH_PROBE_BYTES, start)
    end = tail.find(b"\n")
    return start, (tail[:end] if end >= 0 else tail)


def _corpus_seek(fd, size, prefix):
    """Byte offset of the first line whose key is >= `prefix`. O(log n) reads."""
    lo, hi = 0, size
    while lo < hi:
        mid = (lo + hi) // 2
        start, line = _corpus_line_at(fd, size, mid)
        if start < lo:
            # The line containing `mid` begins before the region still in play;
            # step past `mid` rather than re-examining what is already excluded.
            lo = min(hi, mid + 1)
            continue
        key, _seen = _corpus_row(line)
        if key is not None and key < prefix:
            lo = start + len(line) + 1
        else:
            hi = start
    return lo


def _corpus_collect(fd, size, offset, prefix, sorted_file):
    """Rows sharing `prefix`, from `offset`. Returns (count, [(key, seen)]).

    Two different jobs behind one function, and the difference is `sorted_file`:

      sorted     the seek already put us at the first candidate line, so the
                 scan stops the moment a key sorts ABOVE the prefix. That is
                 what makes a 30 GiB corpus answer in milliseconds, and the
                 read budget is a backstop for a file that is not as sorted as
                 it claims rather than the normal exit.
      unsorted   every line has to be looked at, so the budget is the WHOLE
                 file. It is the caller that guarantees this only happens for a
                 file at or below BREACH_LINEAR_MAX_BYTES — a budget smaller
                 than the file would silently turn a hit near the end into
                 "not breached", which is the one wrong answer this verb must
                 never give.
    """
    budget = BREACH_SCAN_BYTES if sorted_file else size
    count, rows = 0, []
    off, read = offset, 0
    while off < size and read < budget:
        chunk = os.pread(fd, min(BREACH_PROBE_BYTES, size - off), off)
        if not chunk:
            break
        read += len(chunk)
        cut = chunk.rfind(b"\n")
        if cut < 0:
            body, off = chunk, size
        else:
            body, off = chunk[:cut], off + cut + 1
        for line in body.split(b"\n"):
            key, seen = _corpus_row(line)
            if key is None:
                continue
            if key.startswith(prefix):
                count += 1
                if len(rows) < BREACH_MAX_SUFFIXES:
                    rows.append((key.decode("ascii", "replace"), seen))
            elif sorted_file and key > prefix:
                # Past the range in a sorted file: every remaining key is
                # larger still. A key BELOW the prefix means the seek
                # undershot, so that case keeps scanning rather than
                # concluding "not found" from a landing spot.
                return count, rows
    return count, rows


def v_breach_check(req, ctx):
    """Look one SHA-1 up in a LOCAL corpus. No network, ever.

    Two input shapes, and the response echoes at most five hex characters of
    either — the k-anonymity prefix HIBP's own protocol is built on. The full
    hash of a password is an offline-crackable value; it does not go in the
    response and it does not go in the audit log.

      value        the candidate itself, hashed HERE. Never stored, never
                   logged, never echoed.
      sha1_prefix  5..40 upper-case hex. 40 asks an exact question; anything
                   shorter asks how many corpus records share the prefix.
    """
    entry = _entry_for(req, ctx)
    gate(entry, ctx.ident)
    resolved = resolve_entry(entry, ctx.ident)

    value = req.get("value")
    prefix_in = req.get("sha1_prefix")
    if (value is None) == (prefix_in is None):
        raise Invalid("supply exactly one of value or sha1_prefix")

    exact = False
    if value is not None:
        if not isinstance(value, str) or not value:
            raise Invalid("value must be a non-empty string")
        if len(value) > 4096:
            raise Invalid("value must be 4096 characters or fewer")
        holder = Secret(value)
        try:
            digest = hashlib.sha1(
                holder.bytes).hexdigest().upper()          # noqa: S324
        finally:
            # Zeroed before anything is serialised, same order as every other
            # credential path here.
            holder.zero()
        prefix, exact = digest.encode("ascii"), True
    else:
        if not isinstance(prefix_in, str):
            raise Invalid("sha1_prefix must be a string")
        text = prefix_in.strip().upper()
        if not 5 <= len(text) <= 40 or any(c not in "0123456789ABCDEF"
                                           for c in text):
            raise Invalid("sha1_prefix must be 5 to 40 hexadecimal characters")
        prefix, exact = text.encode("ascii"), len(text) == 40

    # Only ever five characters of it leave this function.
    echo = prefix[:5].decode("ascii")
    base = {"available": True, "prefix5": echo, "exact": exact,
            "network": "none", "offline_only": True}

    path, source = _breach_corpus_for(resolved)
    if not path:
        return {"available": False, "prefix5": echo, "exact": exact,
                "network": "none", "offline_only": True,
                "reason": "no breach corpus is configured for this safe; set "
                          "breach_corpus in its registry entry or place %s "
                          "under the registry root. There is no online "
                          "fallback and there will not be one."
                          % BREACH_CORPUS_FILE}

    fd, size = _open_corpus(path)
    try:
        if size <= BREACH_LINEAR_MAX_BYTES:
            method, offset, sorted_file = "linear-scan", 0, False
        else:
            method, sorted_file = "binary-search", True
            offset = _corpus_seek(fd, size, prefix)
        count, rows = _corpus_collect(fd, size, offset, prefix, sorted_file)
    finally:
        try:
            os.close(fd)
        except OSError:
            pass

    base.update({
        "corpus": path, "corpus_source": source, "corpus_bytes": size,
        "method": method,
        "requires_sorted": sorted_file,
        "count": count,
    })
    if exact:
        base["found"] = count > 0
        base["occurrences"] = rows[0][1] if rows else 0
    else:
        # A short prefix cannot answer "is this password breached" — it answers
        # "how many breached hashes start like this". Saying `found: null`
        # rather than `false` keeps a UI from rendering a reassurance nobody
        # earned.
        base["found"] = None
        base["occurrences"] = None
        base["suffixes"] = [key[len(echo):] for key, _seen in rows]
    base["note"] = ("checked against %s with no network access of any kind; "
                    "an absent corpus answers available:false and never falls "
                    "back to an online service" % path)
    return base


# ===========================================================================
# creating, adopting and removing safes — the registry's WRITE side
# ===========================================================================
#
# READ THE CONSTANT BLOCK AT THE TOP OF THIS FILE FIRST. Everything here is
# downstream of the three rules stated there:
#
#   * the caller supplies an ID and nothing path-like, ever (C1/I4);
#   * the id is validated against `_NEW_ID_RE` before it reaches a filesystem
#     call, and an id that already exists — as a registry entry OR as a file at
#     the minted path — is a `conflict` that touches nothing (C2);
#   * `admin` is the default access class and creating one needs the admin
#     gate, exactly like every other admin verb (C3/I1/I3).
#
# The single most important structural fact, because it makes several later
# checks unnecessary rather than merely correct: **for a safe this program
# creates, the access class and the registry are the same decision.** `gate()`
# refuses `admin` unless euid is 0, and refuses `user` unless it is not — so an
# admin-class safe can only ever be written to the root-owned system registry,
# and a user-class one only ever to the caller's own per-user registry. There
# is no path through this code that writes a user-class entry into /etc, and
# none that writes anything at all into a directory the caller does not already
# have on the strength of their kernel identity.


def _new_id(req, field="id"):
    """The id of a safe about to be created. Validated to C2's allow-list.

    Refused BEFORE anything opens a file, because this string is about to
    become one: a file name under a managed directory, a registry file name,
    and the key the whole access model is then indexed on.

    `fullmatch`, not `match`, and the `\\x00` check before it — see `_NEW_ID_RE`
    for the trailing-newline corner, and note that Python happily carries a NUL
    inside a `str` while every layer below it is C and stops at one. A name
    that is `lab-dc\\x00/etc/shadow` to Python is `lab-dc` to `open(2)`: the
    checks would be run against one string and the syscall made with another.
    """
    value = req.get(field)
    if not isinstance(value, str) or not value:
        raise Invalid("an id is required")
    if "\x00" in value:
        raise Invalid("an id may not contain a NUL byte")
    if len(value) > 63 or not _NEW_ID_RE.fullmatch(value):
        # The pattern is quoted in full: an operator fixing this needs the
        # rule, and the rule is short enough to say. Nothing about the value
        # they sent is echoed back.
        raise Invalid("an id must match %s — lower-case letters, digits and "
                      "hyphens only, 2 to 63 characters, no leading hyphen, "
                      "no dot and no slash" % NEW_ID_PATTERN)
    return value


#: Format characters that make a rendered string differ from the stored one.
#: The bidi overrides and isolates (U+202A..202E, U+2066..2069) REVERSE the
#: visual order of what follows them, so "Personal \u202eybdk.CD balbaL" is
#: stored as one thing and drawn as another; the zero-width characters
#: (U+200B..200F, U+FEFF) let two different labels render identically. The
#: registry schema names label confusion as the way a passphrase gets typed
#: into the wrong prompt, so a label is the exact field this matters in.
#:
#: Refused rather than stripped: silently altering an operator's label means
#: the name in the list is not the name they typed, and the one case where
#: somebody genuinely wants U+200B in a safe's name does not exist.
_LABEL_SPOOF_CHARS = frozenset(
    [0x200B, 0x200C, 0x200D, 0x200E, 0x200F, 0xFEFF]
    + list(range(0x202A, 0x202F)) + list(range(0x2066, 0x206A)))


def _new_label(req, field="label"):
    label = _require_str(req, field, maxlen=128)
    if any(ord(ch) < 0x20 or ord(ch) == 0x7f for ch in label):
        # The label reaches a JSON registry file and a UI list. A control
        # character in either is somebody trying to make one thing look like
        # another.
        raise Invalid("a label may not contain control characters")
    if any(ord(ch) in _LABEL_SPOOF_CHARS
           or unicodedata.category(ch) == "Cf" for ch in label):
        # The `Cf` sweep catches the ones not listed by name too — a format
        # character has no business in a label whatever it does, and naming
        # only the ones we thought of is how the next one gets through (I52).
        raise Invalid("a label may not contain bidirectional-override, "
                      "zero-width or other invisible formatting characters — "
                      "they make the name in the list differ from the name "
                      "that was typed")
    return label


def _new_format(req, field="format"):
    fmt = req.get(field)
    if fmt not in FORMATS:
        raise Invalid("format must be one of %s" % ", ".join(FORMATS))
    return fmt


def _new_access(req, ctx, field="access"):
    """The access class of a safe about to be created, GATED. (C3)

    A request with no `access` makes an ADMIN-class safe, which is I1's default
    applied to the write side: the restrictive class is what a missing field
    means, here as everywhere else. Creating one therefore needs the admin gate
    — euid 0 plus membership of an administrative group — and that gate is
    `gate()` itself, run against a synthetic entry, so there is exactly one
    implementation of "may this caller have the admin class" in the program.
    """
    access = req.get(field, "admin")
    if access is None:
        access = "admin"
    if access not in ("admin", "user"):
        raise Invalid("access must be 'admin' or 'user'")
    # `gate()` reads only access/groups/owner/mode from an entry, and every one
    # of those is helper-supplied here. Nothing from the request reaches it.
    gate({"access": access, "groups": [], "owner": None, "mode": "rw"},
         ctx.ident, want_write=True)
    return access


def _managed_dirs(ident, access):
    """(safe directory, registry directory) for one access class. THE MINT.

    This is the whole of C1: two directories chosen by the ACCESS CLASS the
    caller has already been gated for, and no input of any kind. Both are
    created 0700 if absent and re-validated by `_ensure_dir` — owned by this
    euid, and never group- or other-readable.

    The admin pair is the pair `install.sh` ships (`/etc/cockpit-secrets/safes`
    0700 root:root, `/etc/cockpit-secrets/safes.d` 0755 root:root); the user
    pair is under the caller's own home. Note the asymmetry in mode: the system
    `safes.d` is world-READABLE because it is policy several tools may want to
    read, while the per-user one is 0700 because nothing outside the user's own
    session has any business enumerating their safes.
    """
    if access == "admin":
        root = registry_root()
        safes = _ensure_dir(os.path.join(root, MANAGED_SAFES_SUBDIR), 0o700)
        reg = os.path.join(root, SAFES_D)
        if not _trusted_dir(reg, ident.euid):
            raise AccessDenied("the system registry directory is missing or "
                               "not trusted; the helper will not write to it")
    else:
        home = user_home(ident)
        safes = _ensure_dir(os.path.join(home, *USER_SAFES_REL), 0o700)
        reg = _ensure_dir(os.path.join(home, *USER_REGISTRY_REL), 0o700)
    if not safes or not reg:
        raise AccessDenied("the directory this safe would live in could not "
                           "be created 0700 and owned by this caller")
    return safes, reg


def _mint(ident, sid, fmt, access):
    """id + format + access class -> the two paths this feature may write.

    The ONLY place a new path is produced, and it is produced by joining a
    validated id to a directory the access class chose. There is no branch here
    that reads the request, and `os.path.join` cannot escape the directory
    because `_new_id` has already refused `/`, `.` and NUL.

    Returns (safe_path, registry_dir, registry_name).
    """
    safes, reg = _managed_dirs(ident, access)
    return (os.path.join(safes, sid + SAFE_SUFFIX[fmt]), reg, sid + ".json")


def _refuse_conflict(ctx, sid, safe_path, registry_dir, registry_name):
    """Three ways this id is already taken. NOTHING is written after any of
    them, and nothing existing is read, moved, truncated or renamed.

    `os.path.lexists`, not `os.path.exists`, on both files: a DANGLING symlink
    at the name we were about to create is still a name that is taken, and
    following it is I5. `validate_new_path` in backends/base.py makes the same
    distinction for the same reason and is called again at the moment of the
    write; this is the cheap early refusal so an operator hears "that id is
    taken" before a 128 MiB upload rather than after it.
    """
    if sid in ctx.registry:
        raise Conflict("a safe with that id is already registered; this never "
                       "replaces an existing entry")
    if os.path.lexists(safe_path):
        raise Conflict("a file for that id already exists in the managed "
                       "directory; this never overwrites a safe")
    if os.path.lexists(os.path.join(registry_dir, registry_name)):
        raise Conflict("a registry file for that id already exists; this "
                       "never overwrites a registry entry")


# ------------------------------------------------- the registry writer (C6)

def _atomic_json_file(directory, name, doc, mode, expect_uid):
    """Write ONE registry file: temp -> fsync -> replace -> fsync(dir).

    The same sequence `base.atomic_replace` uses on a safe, and for the same
    reason one level up: **a half-written registry file is DROPPED by the
    loader** — correctly, fail-closed (I1) — and silently, because a dropped
    entry only shows up in `health.registry_errors`. An operator who created a
    safe and cannot find it would have no way to tell "the write tore" from
    "the create never ran". So this never produces one.

    The temp name begins with a dot and does not end in `.json`, which is what
    makes a torn write invisible rather than harmful: `_read_registry_dir`
    lists only `*.json`, so a leftover temp file is not a registry entry at
    all, merely litter.

    `mode` is 0644 for the system registry (root-owned policy other tools read)
    and 0600 for the per-user one. `expect_uid` is asserted on the descriptor
    after creation rather than assumed from the umask.
    """
    blob = (json.dumps(doc, indent=1, sort_keys=True,
                       ensure_ascii=False) + "\n").encode("utf-8")
    target = os.path.join(directory, name)
    tmp = os.path.join(directory, ".%s.tmp-%d" % (name, os.getpid()))
    fd = None
    try:
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                         | os.O_CLOEXEC | os.O_NOFOLLOW, mode)
        except FileExistsError:
            # A previous run of THIS pid died here; the content is unusable and
            # the pid is ours. Same reasoning as atomic_replace's.
            os.unlink(tmp)
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                         | os.O_CLOEXEC | os.O_NOFOLLOW, mode)
        os.fchmod(fd, mode)                  # umask must not get a vote
        st = os.fstat(fd)
        if st.st_uid != expect_uid:
            raise Internal("the registry file was created with the wrong owner")
        write_all(fd, blob)
        os.fsync(fd)
        if os.fstat(fd).st_size != len(blob):
            raise Internal("the registry file is short; nothing was published")
        os.close(fd)
        fd = None
        os.replace(tmp, target)
        tmp = None
        dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except SecretsError:
        raise
    except OSError as exc:
        raise Internal("the registry entry could not be written: %s"
                       % errno.errorcode.get(exc.errno, "OSError"))
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    return target


def _registry_doc(sid, label, fmt, safe_path, access, *, origin,
                  source=None):
    """The registry entry this program writes. Nineteen keys, no more.

    Everything here is a helper-side decision except the id, the label and the
    format, and the three of those have already been validated. In particular:

      * `password_required` is TRUE and `keyfile` is NULL, always. This program
        never registers a key-file PATH, so it never writes an entry that opens
        with no passphrase — see `v_safe_create`'s docstring for why that is a
        deliberate refusal rather than a missing feature.
      * `owner` is null on a user-class entry, which means "the caller" — the
        usual answer, and the only correct one for an entry in the caller's own
        per-user registry.
      * `export_allowed` is false and `agent.enabled` is false: both defaults
        are the restrictive ones (I21, I18), and turning either on is an
        administrator editing the registry, deliberately, later.
    """
    doc = {
        "id": sid,
        "label": label,
        "format": fmt,
        "path": safe_path,
        "access": access,
        "mode": "rw",
        "password_required": True,
        "keyfile": None,
        "yubikey_slot": None,
        "groups": [],
        "agent": dict(AGENT_DEFAULT),
        "export_allowed": False,
        "export_dir": None,
        "breach_corpus": None,
        "backup": {"keep": Limits.DEFAULT_BACKUP_KEEP, "dir": None},
        # THE THREE PROVENANCE KEYS (I46). They are what makes "this program
        # made this file" a fact the program can check rather than a story the
        # documentation tells, and `safe-delete` reads `origin` as
        # corroboration for the derived-path gate. They were declared in
        # schema/safe-registry.schema.json and documented in docs/CONTRACT.md
        # before any verb wrote one, and `_KNOWN_KEYS` did not list them — so
        # an operator who copied a shipped example got an entry the loader
        # DROPPED, silently, which is the one outcome `_atomic_json_file`'s
        # docstring says must never happen. Writing them and knowing them
        # landed in the same change on purpose.
        "origin": origin,
        "created_utc": _iso_utc(),
    }
    if source is not None:
        doc["source"] = source
    if access == "user":
        doc["owner"] = None
    return doc


def _publish_entry(ctx, doc, registry_dir, registry_name, access):
    """Validate the entry, then land it. Returns the written entry.

    BOTH validators run BEFORE the write, in the order `load_registry` runs
    them, against the document that is about to be serialised — not against the
    idea of it. An entry this program writes that its own loader would drop is
    the worst possible outcome of this feature: the operator is told the safe
    was created, `list` does not show it, and the reason is a line in
    `health.registry_errors` they have no reason to look at.
    """
    entry, why = validate_entry(doc)
    if why:
        raise Internal("the registry entry this helper built is invalid (%s)"
                       % why)
    validator = _schema_validator(registry_root())
    if validator is not None:
        errs = sorted(validator.iter_errors(doc), key=str)
        if errs:
            raise Internal("the registry entry this helper built was rejected "
                           "by safe-registry.schema.json: %s"
                           % str(errs[0].message)[:120])
    mode = 0o644 if access == "admin" else 0o600
    _atomic_json_file(registry_dir, registry_name, doc, mode, ctx.ident.euid)
    entry["registry"] = "system" if access == "admin" else "user"
    entry["registry_file"] = registry_name
    # Re-read the registry so the rest of THIS process (an `open` session in
    # particular) sees the safe it just made. Cheap, and the alternative is a
    # session in which `list` disagrees with what `safe-create` just returned.
    ctx.load()
    return entry


def _entry_row(entry, ctx):
    """One safe, in exactly the shape `list` reports it. Same code path, so a
    create cannot describe a safe differently from the way it is listed."""
    for row in v_list({}, ctx).get("safes", []):
        if row.get("id") == entry["id"]:
            return row
    # Not reachable through a successful create — the entry was just written
    # and `ctx.load()` re-read it — but a loader that dropped it must not turn
    # into a KeyError three frames away.
    raise Internal("the entry was written but the registry did not load it; "
                   "see health.registry_errors")


# ------------------------------------------------ building an empty safe ---

def _create_warnings(fmt):
    """What a NEWLY CREATED safe cannot do, said at creation time.

    A limitation an operator meets for the first time three weeks later, on the
    safe they have already filled, is a limitation this program failed to
    mention. There is one, and it is real: a Password Safe database this
    program creates declares format **0x030D**, and the attachment fields
    (0x25..0x29) were introduced at **0x030F**, so `attach-add` refuses on it —
    correctly, and naming the version.

    The version is NOT raised to 0x030F to make the refusal go away, and that
    is `backends/psafe3.py`'s decision rather than this file's: a declared
    version is a claim about what a file contains and which readers can open
    it, raising it would make every safe created here unreadable by Password
    Safe before 3.68, and **there is no Password Safe on this host to check
    either choice against** (docs/COMPATIBILITY.md §3.3). Refusing loudly at a
    version everything reads is the conservative half of that trade. What was
    missing was saying so at the moment the operator picks the format.
    """
    if fmt != "psafe3":
        return []
    return ["A Password Safe database created here declares format version "
            "0x030D. Attachments need 0x030F (Password Safe V3.68) or later, "
            "so `attach-add` will refuse on this safe and say so. Everything "
            "else — entries, fields, TOTP, history, save — works normally. If "
            "you need attachments, create the safe in Password Safe itself and "
            "adopt it here."]


def _keyfile_bytes():
    """A fresh KeePass 2.0 XML key file. 32 bytes of CSPRNG, plus its own hash.

    Version 2.0 rather than 1.0 or raw: it is what KeePassXC 2.7 writes today,
    it is self-checking (the `Hash` attribute is the first four bytes of the
    SHA-256 of the key, which catches a truncated or mangled copy at unlock
    instead of as `bad-credential`), and `backends/kdbx.py::_keyfile_composite`
    reads it with a constant-time comparison on that hash.

    Returned to the operator ONCE and stored nowhere. See `v_safe_create`.
    """
    key = _sysrandom.token_bytes(32)
    digest = hashlib.sha256(key).digest()[:4]
    grouped = " ".join(key.hex().upper()[i:i + 8] for i in range(0, 64, 8))
    return ("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
            "<KeyFile>\n"
            "    <Meta>\n"
            "        <Version>2.0</Version>\n"
            "    </Meta>\n"
            "    <Key>\n"
            "        <Data Hash=\"%s\">%s</Data>\n"
            "    </Key>\n"
            "</KeyFile>\n" % (digest.hex().upper(), grouped)).encode("utf-8")


def _kdf_choice(req, fmt):
    """The KDF parameters for a NEW safe, clamped by `Limits` before use.

    An operator may raise the cost; they may not lower it past the floors here
    and they may not raise it past the clamps in `backends/base.py`, which are
    the same clamps a hostile FILE's parameters are checked against (I7). The
    reason the same ceiling applies to an operator's own choice is that the
    machine this runs on does not care who chose `m=4 GiB`.
    """
    raw = req.get("kdf")
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise Invalid("kdf must be an object")
    unknown = sorted(set(raw) - {"memory_kib", "time", "parallelism",
                                 "iterations"})
    if unknown:
        raise Invalid("kdf has no %r parameter" % unknown[0])
    if fmt == "psafe3":
        want = raw.get("iterations", Limits.PWS3_WRITE_MIN_ITER)
        if not _is_int(want):
            raise Invalid("kdf.iterations must be an integer")
        # The floor is the format's own current default, applied to everything
        # we WRITE (backends/base.py PWS3_WRITE_MIN_ITER): we never create a
        # file weaker than the reference implementation would.
        want = max(int(want), Limits.PWS3_WRITE_MIN_ITER)
        Limits.check_pws3_iter(want, for_write=True)
        return {"iterations": want}
    out = {"memory_kib": KDBX_NEW_MEMORY_KIB, "time": KDBX_NEW_TIME,
           "parallelism": KDBX_NEW_PARALLELISM}
    for name, floor in (("memory_kib", KDBX_MEMORY_MIN),
                        ("time", KDBX_TIME_MIN),
                        ("parallelism", KDBX_PAR_MIN)):
        if name in raw:
            if not _is_int(raw[name]):
                raise Invalid("kdf.%s must be an integer" % name)
            if int(raw[name]) < floor:
                raise Invalid("kdf.%s must be at least %d" % (name, floor))
            out[name] = int(raw[name])
    # The ceilings AND the write floors, from the one place this program keeps
    # them — `for_write=True` is the same call `Backend.create_new` will make
    # on these numbers a moment later, so a request cannot pass here and be
    # refused there.
    Limits.check_argon2(out["memory_kib"], out["time"], out["parallelism"],
                        for_write=True)
    return out


def _build_new_bytes(fmt, password, keyfile, label, kdf):
    """A brand-new, empty, valid database as BYTES. Delegated, deliberately.

    `Backend.create_new` is the whole of this function now, and the delegation
    is the fix rather than a tidy-up. This file used to build a KDBX itself out
    of pykeepass's blank template, and doing so it inherited three published
    constants from that template — the MASTER SEED, the ENCRYPTION IV and the
    INNER PROTECTED-STREAM KEY — into every safe it created. The last of those
    is the ChaCha20 key masking every protected value in the XML, so until the
    operator's first save it was a public constant; two safes created here
    shared a keystream. It also called `Secret.str_view()`, minting an
    unwipeable `str` of the new master passphrase, which is the exact hop
    `backends/kdbx.py` states never happens inside it (I14).

    `create_new` reseeds all three at the CIPHER'S OWN nonce length, and it is
    also the only implementation of the five-step policy the ABC documents —
    empty-credential refusal (C7), `build_new`, the size cap,
    `verify_structure`, and a cold re-open through `validate_candidate` with
    the same passphrase (I24/I41). Keeping a second implementation here is what
    made those five steps something this file could get wrong; there is now no
    second implementation to disagree.

    **No path, no temp file, no staging.** The bytes exist in memory and the
    caller lands them through `_land_new_safe`. That is C1 and I10 together:
    the only place a new path is produced is `_mint`.
    """
    cls = load_backend_class(fmt)
    options = dict(kdf)
    # The operator's LABEL becomes the database's own name, which is a
    # different thing from the registry label and is why it is passed
    # explicitly: `list` reads the registry, and a client that opens the file
    # directly reads this. They should agree.
    options["name"] = label
    return cls.create_new(
        credential={"password": password, "keyfile": keyfile},
        options=options)


def _new_credentials(req):
    """(password, keyfile) as `Secret`s, from the request's stdin JSON.

    `new_password` and not `password`, and the difference is not cosmetic. The
    `password` field means "the credential that opens a REGISTERED safe", and
    everything that follows from that meaning is attached to it: it is counted
    by the I16 lockout, it is bounded by the per-safe rate cap, and a failure
    against it waits out the constant time floor. None of those apply to a
    passphrase being SET on a safe that does not exist yet, or to one being
    tried against a file the caller uploaded from their own machine and still
    holds — so calling it the same field would attach three promises to it that
    this code does not keep. `tests/integration/lockout.py` builds its list of
    credential-bearing verbs by asking the `schema` verb which verbs declare
    `password`; that list stays true because these verbs honestly do not.

    Both are zeroed by the caller in a `finally`, like every other credential
    in this file (I14).
    """
    raw = req.get("new_password")
    password = None
    if isinstance(raw, str) and raw != "":
        password = Secret(raw)
    elif raw is not None and not isinstance(raw, str):
        raise Invalid("new_password must be a string")
    keyfile = None
    kf = req.get("keyfile_b64")
    if kf:
        if not isinstance(kf, str):
            raise Invalid("keyfile_b64 must be a base64 string")
        keyfile = Secret.from_b64(kf)
    return password, keyfile


def _open_candidate(fmt, data, password, keyfile, *, mine):
    """Do THESE BYTES open with this credential? Returns the candidate summary.

    **IT TAKES BYTES AND IT WILL NEVER TAKE A PATH AGAIN (I43).** That signature
    is the fix for a real defect, not a preference, so the reason is here rather
    than in a changelog: this function used to take the staged file's PATH and
    open it, while `import-commit` separately re-read that same path for the
    bytes it wrote. Two reads, nothing tying them together, and a full KDF
    derivation in between — so the bytes that were PROVEN to be a safe and the
    bytes that LANDED as a safe were never the same bytes, and a file that does
    not open could be registered as a safe. The invariant every reader of this
    code relies on ("a file that does not open does not land") was false.

    Taking bytes makes the two physically the same object. There is no second
    read to diverge from the first, because there is nothing left to re-read
    and no path to re-read it from. `validate.sh` bans re-introducing the path
    parameter, and `tests/integration/newverbs.py` proves the landed bytes are
    the validated ones.

    `Backend.validate_candidate` is the check itself — the SAME reader a later
    `unlock` will use, with the same clamps, the same MAC gate and the same
    post-decode refusals, so no second, laxer parse path exists (I24/I41).

    `mine` decides only the TAXONOMY of a failure, which is the whole reason
    the flag exists:

      * `mine=True`  (safe-create) — we built these bytes seconds ago from this
        very passphrase. A `bad-credential` is this program's fault, not the
        operator's, and answering `bad-credential` would send them away
        retyping a passphrase that was right. It becomes `internal`.
      * `mine=False` (safe-import) — the file came from the operator. A
        `bad-credential` is exactly what it says.
    """
    if not isinstance(data, (bytes, bytearray)):
        raise Internal("the candidate check was handed something that is not "
                       "bytes")
    cls = load_backend_class(fmt)
    try:
        return cls.validate_candidate(
            bytes(data), credential={"password": password, "keyfile": keyfile})
    except BadCredential:
        if mine:
            raise Internal("this helper built a database it cannot re-open; "
                           "nothing was written")
        raise
    except SecretsError:
        raise
    except Exception as exc:                                   # noqa: BLE001
        raise Internal("the %s backend raised %s while checking the file"
                       % (fmt, type(exc).__name__))


def _place_new_safe(path, data, ident):
    """Land a new safe file: never over anything, 0600, owned by this caller.

    `validate_new_path` is the refusal that matters and it is deliberately
    called AGAIN here, after `_refuse_conflict` already looked: everything
    between the two is a KDF and an upload, which is long enough for somebody
    to have created that name in the meantime. It refuses a dangling symlink at
    the name too (`lexists`), which is the I5 landing for this verb.
    """
    validate_new_path(path, "new safe")
    return atomic_replace(path, data, backup_dir=None,
                          keep=Limits.DEFAULT_BACKUP_KEEP,
                          expect_fingerprint=None, expect_uid=ident.euid,
                          mode=0o600)


def _land_new_safe(ctx, safe_path, data, doc, reg_dir, reg_name, access):
    """Place the file AND publish its entry, or leave neither behind. (I45)

    THE ONE FUNCTION THAT MAY CREATE A SAFE, and it exists because doing the
    two steps separately produced an unrecoverable state. `_place_new_safe`
    lands the file and `_publish_entry` writes the registry entry; if the
    second failed — a read-only /etc, ENOSPC, a registry directory somebody
    chmodded, a SIGKILL in the window — the file stayed and nothing pointed at
    it. That id was then BURNED from inside the program: `safe-create` answered
    `conflict` (the minted path exists), `list` did not show it, and
    `safe-forget` and `safe-delete` both answered `not-found` because they need
    a registry entry. For the admin class the orphan sat in
    /etc/cockpit-secrets/safes where only root could clean it, and for an
    import it was up to 128 MiB of the operator's uploaded safe.

    So the file is UNLINKED when the entry cannot be published. It is safe to
    unlink unconditionally here and nowhere else: this path was minted seconds
    ago, `_refuse_conflict` proved nothing was at it, and `_place_new_safe`
    created it — so the only thing that can be there is what we just wrote.

    The one case that cannot be made clean is the rollback itself failing, and
    that is the ONE place this program names a path in an error: an operator
    who cannot see the orphan cannot remove it, and `health.registry_errors`
    will not mention it either because there is no entry to fail to load. The
    AUDIT line still carries no path (I15) — that separation is deliberate and
    `tests/integration/newverbs.py` asserts both halves.

    Returns (write report, published entry).
    """
    report = _place_new_safe(safe_path, data, ctx.ident)
    try:
        entry = _publish_entry(ctx, doc, reg_dir, reg_name, access)
    except BaseException as exc:
        try:
            os.unlink(safe_path)
        except OSError:
            detail = getattr(exc, "detail", None) or type(exc).__name__
            raise Internal(
                "the registry entry could not be written (%s) and the safe "
                "file just created could not be removed either; delete %s by "
                "hand before reusing that id" % (detail, safe_path))
        raise

    # A NEW SAFE STARTS WITH A CLEAN LOCKOUT COUNTER (I55).
    #
    # I16's counter is keyed on (real uid, safe ID), and until 0.4.0 an id was
    # never freed from inside this program — so a counter and the safe it
    # counted for had the same lifetime and nothing had to say this.
    # `safe-delete` broke that: the counter survived the safe, and a new safe
    # created at the same id inherited somebody's old failure count. Measured:
    # six wrong guesses, `safe-delete`, `safe-create` with the same id, then the
    # CORRECT passphrase -> `locked-out`. The operator is told "too many failed
    # unlock attempts" about a safe that has existed for two seconds and has
    # never been guessed at.
    #
    # Cleared HERE rather than in the two verbs, so an import cannot get it and
    # a create forget it. It is safe at this point: the class gate passed and
    # `_refuse_conflict` proved the id was free, so any counter under it is
    # about a safe that no longer exists.
    #
    # OUTSIDE THE ROLLBACK, AND BEST-EFFORT, both deliberately. It is after the
    # `try` because the safe is FULLY CREATED by now — file landed, entry
    # published — and undoing all of that because a 60-byte counter could not be
    # zeroed would be a far worse outcome than the stale counter. And
    # `lockout_reset` can legitimately fail: it takes the same `flock` every
    # guess takes, so another helper holding it answers `Conflict`. The cost of
    # the failure is bounded and self-clearing — one lockout window on a safe
    # nobody has guessed at — and it is reported as a warning rather than
    # swallowed.
    try:
        lockout_reset(ctx.ident, entry["id"])
    except SecretsError as exc:
        _note("the lockout counter for %r could not be cleared (%s); if this "
              "id was used before, the first unlock may be refused until the "
              "old window expires" % (entry["id"], exc.code))
    return report, entry

# ------------------------------------------------------- import staging ---
#
# WHY THE BYTES ARRIVE BEFORE THE PASSPHRASE, AND WHY THAT IS THE ORDER (C5).
#
# `import-begin` -> `import-chunk`* -> `import-inspect` -> `import-commit`, and
# **no credential exists anywhere in the first three**. That ordering is a
# requirement, not a preference, and it is better on both counts:
#
#   * A 128 MiB upload takes visible time. Collecting the passphrase in the
#     file-picker step means holding it in browser memory for the whole
#     transfer — precisely the window I11 and I14 exist to shrink. Prompting
#     after the bytes are staged means it exists for one request, on one
#     stdin, and is zeroed before the response is serialised.
#   * The header of a KDBX or PWS3 file is NOT SECRET. Format, version, cipher,
#     KDF and its parameters are readable from the bytes by anyone holding the
#     file — and the person uploading it holds the file. So `import-inspect`
#     can report all of it with no credential at all, which lets the operator
#     confirm they uploaded the file they meant to BEFORE they type anything.
#     The UI must label that summary as what it is: read from the header, not
#     authenticated.
#
# Staging lives in a 0700 directory under the helper's own state root. Never
# `/tmp` (world-writable, a different filesystem, and the classic place for a
# plaintext-adjacent file to be read by somebody else) and never the final path
# (a half-finished upload must not be reachable as a safe, and must not be able
# to become one by the process dying).

_STAGING_TOKEN_RE = re.compile(r"^[0-9a-f]{32}$")


def _staging_root(ident):
    """`<state>/import`, 0700 and owned by this euid, or a typed refusal."""
    state = init_state(ident)["state_dir"]
    if not state:
        raise Unsupported("there is no writable state directory on this host, "
                          "so an upload has nowhere to be staged; "
                          "health.state says why")
    root = _ensure_dir(os.path.join(state, IMPORT_SUBDIR), 0o700)
    if not root:
        raise Internal("the import staging directory could not be created "
                       "0700 and owned by this caller")
    return root


def _staging_paths(root, token):
    d = os.path.join(root, token)
    return d, os.path.join(d, "meta.json"), os.path.join(d, "blob")


def _staging_destroy(dirpath):
    """Remove one staging directory. Flat by construction, so no recursion.

    `os.unlink` of two known names and an `rmdir` — deliberately NOT a
    recursive tree walk. This directory is inside a 0700 directory we own, so
    the only thing that should be in it is what we put there; a walker would
    turn "something unexpected is in here" into "delete whatever is in here",
    and the `rmdir` failing loudly is the better outcome.

    The staged bytes are an ENCRYPTED safe, not plaintext, so this unlinks
    rather than overwrites — see `_shred` for where overwriting is done and
    what it is honestly worth.

    THROUGH A DIRFD OPENED `O_NOFOLLOW|O_DIRECTORY` (I53). Unlinking by path
    meant a symlink standing where a staging directory should be had its TARGET
    emptied instead: the start-up sweep accepted any name matching the token
    pattern, `os.stat` followed it, and the two `os.unlink` calls removed a
    `blob` and a `meta.json` outside the staging root. The dirfd makes the
    symlink itself the thing that is refused rather than the thing that is
    traversed, and `unlinkat` then names files RELATIVE to a directory this
    call proved is a directory.
    """
    dirfd = None
    try:
        dirfd = os.open(dirpath, os.O_RDONLY | os.O_DIRECTORY
                        | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        # Not a directory, a symlink, or gone. Either way there is nothing here
        # this function is entitled to remove.
        return False
    try:
        for name in ("meta.json", "blob"):
            try:
                os.unlink(name, dir_fd=dirfd)
            except OSError:
                pass
    finally:
        try:
            os.close(dirfd)
        except OSError:
            pass
    try:
        os.rmdir(dirpath)
    except OSError:
        return False
    return True


class _ImportWorkSlot:
    """A non-blocking work slot for the two expensive import verbs. (I54)

    Used as a context manager::

        with _ImportWorkSlot(root):
            ...

    `flock(LOCK_EX | LOCK_NB)` on `slot-<n>` inside the staging root, which is
    already 0700 and owned by this euid — so the slots are per-identity by
    construction and one user cannot exhaust another's. The fd is held for the
    body and the lock dies with the process, which is the property that matters:
    a helper that is SIGKILLed mid-inspect does not leak a slot the way a
    counter file would.

    Refuses rather than waits. A caller queued behind two 128 MiB inspections
    is a Cockpit channel held open for the duration, and `conflict` is a
    retryable code the UI already knows how to present.
    """

    def __init__(self, root):
        self._root = root
        self._fd = None

    def __enter__(self):
        for n in range(IMPORT_MAX_CONCURRENT):
            path = os.path.join(self._root, "slot-%d" % n)
            fd = None
            try:
                fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC
                             | os.O_NOFOLLOW, 0o600)
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError:
                        pass
                continue
            self._fd = fd
            return self
        raise Conflict(
            "%d uploads are already being read or opened on this host and "
            "each one costs it a full file read or a full key derivation; "
            "try again in a moment" % IMPORT_MAX_CONCURRENT)

    def __exit__(self, *exc):
        if self._fd is not None:
            try:
                os.close(self._fd)          # closing releases the flock
            except OSError:
                pass
            self._fd = None
        return False


def _staging_meta_read(metapath):
    try:
        with open(metapath, "rb") as fh:
            doc = json.loads(fh.read(64 * 1024).decode("utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None
    return doc if isinstance(doc, dict) else None


def _staging_meta_write(dirpath, meta):
    _atomic_json_file(dirpath, "meta.json", meta, 0o600, os.geteuid())


def _sweep_staging(ident):
    """Destroy every staging that has been idle too long. Called at start-up.

    The crash-cleanup half of C5's rule 6: `import-abort` and every failure
    path remove their own staging, but a helper that is SIGKILLed mid-upload
    cannot, and a browser tab that is closed never sends the abort. Without
    this, an abandoned upload is up to 128 MiB of somebody's encrypted safe
    sitting in a state directory forever.

    Best effort and never fatal: a sweep that cannot read a directory must not
    stop the verb the operator actually asked for.
    """
    try:
        state = _STATE_REPORT.get("state_dir")
        if not state:
            return 0
        root = os.path.join(state, IMPORT_SUBDIR)
        if not os.path.isdir(root):
            return 0
        now = time.time()
        gone = 0
        for token in os.listdir(root):
            if not _STAGING_TOKEN_RE.fullmatch(token):
                continue
            d, metapath, _blob = _staging_paths(root, token)
            # I53: a NON-DIRECTORY wearing a staging token's name is not a
            # staging and is not this sweep's to age or to destroy. `os.lstat`,
            # so a symlink is seen as a symlink; `os.stat` followed it, which
            # is how the mtime of somebody else's directory decided whether
            # files inside it were unlinked. Left in place deliberately — this
            # function's remit is stale stagings, and "something unexpected is
            # in here" must not become "delete whatever is in here".
            try:
                lst = os.lstat(d)
            except OSError:
                continue
            if not stat.S_ISDIR(lst.st_mode):
                continue
            meta = _staging_meta_read(metapath)
            used = None
            if isinstance(meta, dict) and _is_int(meta.get("used")):
                used = float(meta["used"])
            if used is None:
                # No readable meta: fall back to the directory's own mtime, so
                # a staging whose meta write was interrupted still ages out.
                try:
                    used = os.stat(d).st_mtime
                except OSError:
                    continue
            if now - used > IMPORT_IDLE_SECONDS:
                gone += 1 if _staging_destroy(d) else 0
        return gone
    except OSError:
        return 0


def _staging_open(req, ctx, *, touch=True):
    """Resolve a `staging` token to (dir, meta). Bound to the real caller.

    The token is 128 bits from the CSPRNG and names a directory inside a 0700
    tree this euid owns, so another unprivileged user cannot reach it at all.
    The `uid` check on top of that is for the ADMIN path, where every caller is
    euid 0 and the only record of who is who is `real_uid` (I40's key): one
    administrator's upload is not another's to commit, and the audit line has
    to be able to say which of them did it.

    A token that does not exist and a token belonging to somebody else are the
    same `access-denied`, for the same reason a wrong handle is: distinguishing
    them would make this an enumeration oracle.
    """
    token = req.get("staging")
    if not isinstance(token, str) or not _STAGING_TOKEN_RE.fullmatch(token):
        raise Invalid("a staging token is required")
    root = _staging_root(ctx.ident)
    d, metapath, blob = _staging_paths(root, token)
    meta = _staging_meta_read(metapath)
    if meta is None or meta.get("uid") != ctx.ident.real_uid:
        raise AccessDenied("no such upload is in progress for this caller")
    if time.time() - float(meta.get("used") or 0) > IMPORT_IDLE_SECONDS:
        # Measured: on a fresh helper invocation this branch is normally NOT
        # the one that fires — `init_state`'s start-up sweep has already
        # removed the staging, so the lookup above answers access-denied
        # instead. It is here for the case the sweep cannot cover: a long-lived
        # `open` session, where start-up happened once at the beginning and the
        # staging aged out while the channel was held.
        _staging_destroy(d)
        ctx.note = "staging-expired"
        raise NotFound("this upload expired and its staged bytes were "
                       "destroyed; start it again")
    ctx.safe_id = meta.get("id")
    if touch:
        meta["used"] = int(time.time())
        _staging_meta_write(d, meta)
    return d, blob, meta


def _staging_report(ctx):
    """What `health` says about staging. A COUNT, never a token.

    A staging token is a bearer name for a directory: knowing one and being the
    right uid is what `import-commit` needs. `health` is a diagnostic, not a
    place to hand them out, so it reports how many exist and nothing that
    identifies one.
    """
    out = {"dir": None, "staged": 0, "idle_seconds": IMPORT_IDLE_SECONDS,
           "chunk_bytes": IMPORT_CHUNK_BYTES,
           "max_bytes": Limits.MAX_SAFE_BYTES,
           "max_attempts": IMPORT_MAX_ATTEMPTS,
           "max_concurrent": IMPORT_MAX_CONCURRENT, "reason": ""}
    state = _STATE_REPORT.get("state_dir")
    if not state:
        out["reason"] = "no writable state directory; import is unavailable"
        return out
    root = os.path.join(state, IMPORT_SUBDIR)
    out["dir"] = root
    try:
        out["staged"] = sum(1 for n in os.listdir(root)
                            if _STAGING_TOKEN_RE.fullmatch(n))
    except OSError:
        out["staged"] = 0
    return out


def _registry_source_report(ctx):
    """Which registry each loaded entry came from, and where the other one is.

    The per-user directory is reported as `null` with a reason on the root
    path, and the path is not even computed there — C4 rule 1 is that a
    root-mode helper does not open it, and a `health` verb that resolved it
    "just to report it" would be the first exception to that rule.
    """
    counts = {"system": 0, "user": 0}
    for entry in ctx.registry.values():
        counts[entry.get("registry", "system")] = \
            counts.get(entry.get("registry", "system"), 0) + 1
    user = {"dir": None, "entries": counts.get("user", 0), "read": False,
            "reason": "a root helper never reads the per-user registry "
                      "(C4 rule 1)"}
    if ctx.ident.euid != 0:
        user["read"] = True
        user["reason"] = ""
        try:
            user["dir"] = user_registry_dir(ctx.ident)
        except SecretsError as exc:
            user["reason"] = exc.detail
    return {
        "system": {"dir": os.path.join(registry_root(), SAFES_D),
                   "entries": counts.get("system", 0)},
        "user": user,
    }


# ===========================================================================
# the eight registry-writing verbs
# ===========================================================================

def v_safe_create(req, ctx):
    """Make a brand-new empty safe and register it. (C1, C2, C3, C6, C7)

    Order, and every step is a refusal before it is a feature:

      1. the id, label and format are validated by shape — no filesystem call
         has happened yet, and a traversal-shaped id dies here;
      2. the ACCESS CLASS is resolved (missing means `admin`) and gated from
         kernel identity, so a non-root caller cannot create an admin safe and
         a root helper cannot create a user one;
      3. the path is MINTED from the id and the managed directory that class
         chose. The caller never names one;
      4. three conflict checks, none of which touch anything: the id must not
         be registered, the minted safe path must not exist, the minted
         registry file must not exist;
      5. the credential arrives on stdin (I10) and the bytes are built in
         MEMORY by `Backend.create_new`, which also re-opens them from cold
         with that same passphrase before it returns them (I24/I41) — a
         database this program cannot read back is never published, and there
         is no staging file involved at any point;
      6. `_land_new_safe` lands the file and publishes the entry as one
         operation: if the registry write fails the file is unlinked again, so
         a failed create leaves neither half behind (I45).

    **A NEW SAFE ALWAYS HAS A PASSPHRASE, and that is stricter than it needs to
    be on purpose.** A key file may be added as a second factor — generated
    here, or supplied as `keyfile_b64` — but this program never registers a key
    file PATH, so it can never write `password_required: false`, which the
    registry schema permits only alongside a registered `keyfile` or
    `yubikey_slot`. The alternative would be to store the key file next to the
    safe it opens, and `safe-registry.schema.json` says exactly what that is
    worth: "an attacker who gets the safe gets the key in the same directory".
    Registering a key file is an administrator's decision, made by hand, later.

    A GENERATED KEY FILE IS RETURNED ONCE AND STORED NOWHERE. It is handled the
    way a private key is: shown at creation, never retrievable afterwards, and
    the response says so. If the operator loses it the safe is gone — which is
    the same bargain as the passphrase (docs/THREAT-MODEL.md puts key escrow
    explicitly out of scope).
    """
    sid = _new_id(req)
    label = _new_label(req)
    fmt = _new_format(req)
    access = _new_access(req, ctx)
    ctx.safe_id = sid
    kdf = _kdf_choice(req, fmt)

    make_keyfile = req.get("make_keyfile", False)
    if not isinstance(make_keyfile, bool):
        raise Invalid("make_keyfile must be true or false")
    if fmt == "psafe3" and (make_keyfile or req.get("keyfile_b64")):
        # §2 of formatV3.txt has no key-file or hardware-key concept at all.
        # `unsupported`, not `invalid`: the request was well formed and the
        # answer will not change until the safe is a different format.
        raise Unsupported("Password Safe v3 has no key-file concept; a PWS3 "
                          "safe is opened by its passphrase alone")

    safe_path, reg_dir, reg_name = _mint(ctx.ident, sid, fmt, access)
    _refuse_conflict(ctx, sid, safe_path, reg_dir, reg_name)

    password, keyfile = _new_credentials(req)
    generated = None
    try:
        if password is None:
            raise Invalid("a new safe needs a passphrase; this helper never "
                          "creates one that opens with nothing (C7)")
        if make_keyfile and keyfile is not None:
            raise Invalid("send either make_keyfile or keyfile_b64, not both")
        if make_keyfile:
            generated = _keyfile_bytes()
            keyfile = Secret(generated)
        # Reported, NEVER enforced. Telling an operator their passphrase is
        # weak is this program's job; refusing the one they chose is not.
        strength = _estimate_strength(password.str_view())

        # Steps 5 AND 6 in one call. `Backend.create_new` builds the bytes and
        # then re-opens them from cold through the reader a later unlock will
        # use, with this same passphrase (I24/I41) — so there is no staging
        # file for a create any more, and no window in which a database this
        # program cannot read back could be published.
        data = _build_new_bytes(fmt, password,
                                bytes(keyfile.bytes) if keyfile else None,
                                label, kdf)
        doc = _registry_doc(sid, label, fmt, safe_path, access,
                            origin="created")
        report, entry = _land_new_safe(ctx, safe_path, data, doc,
                                       reg_dir, reg_name, access)
    finally:
        for item in (password, keyfile):
            if item is not None:
                item.zero()

    ctx.note = "created-%s" % entry["registry"]
    out = {"ok": True, "safe": _entry_row(entry, ctx),
           "registry": entry["registry"], "bytes": report["bytes"],
           "format": fmt, "kdf": kdf, "strength": strength,
           "warnings": _create_warnings(fmt)}
    if generated is not None:
        out["keyfile_b64"] = base64.b64encode(generated).decode("ascii")
        out["keyfile_warning"] = (
            "This key file is shown ONCE and is stored nowhere on this host. "
            "Save it somewhere the safe is not, and send it as keyfile_b64 on "
            "every unlock. Lose it and this safe cannot be opened again.")
    return out


def v_import_begin(req, ctx):
    """Declare an upload. NO CREDENTIAL. (C5 step 1)

    Everything that can be refused before a byte arrives is refused here: the
    id's shape, the access class and its gate, the three conflicts, and the
    declared SIZE against `Limits.MAX_SAFE_BYTES`. Rejecting an over-sized
    declaration before the transfer rather than after it is the difference
    between one refused request and 128 MiB of wasted upload.
    """
    sid = _new_id(req)
    label = _new_label(req)
    fmt = _new_format(req)
    access = _new_access(req, ctx)
    ctx.safe_id = sid

    total = req.get("total_bytes")
    if not _is_int(total) or total <= 0:
        raise Invalid("total_bytes must be a positive integer")
    if total > Limits.MAX_SAFE_BYTES:
        raise Invalid("total_bytes %d exceeds the %d byte limit for a safe"
                      % (total, Limits.MAX_SAFE_BYTES))
    digest = req.get("sha256")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}",
                                                       digest):
        raise Invalid("sha256 must be the whole file's SHA-256 as 64 "
                      "lower-case hex characters")

    safe_path, reg_dir, reg_name = _mint(ctx.ident, sid, fmt, access)
    _refuse_conflict(ctx, sid, safe_path, reg_dir, reg_name)

    root = _staging_root(ctx.ident)
    live = 0
    try:
        live = sum(1 for n in os.listdir(root)
                   if _STAGING_TOKEN_RE.fullmatch(n))
    except OSError:
        pass
    if live >= IMPORT_MAX_STAGINGS:
        raise Conflict("too many uploads are already in progress; finish or "
                       "abort one first (limit %d)" % IMPORT_MAX_STAGINGS)

    token = _sysrandom.token_hex(16)
    d, _metapath, blob = _staging_paths(root, token)
    try:
        os.mkdir(d, 0o700)
    except OSError:
        raise Internal("the staging directory could not be created")
    try:
        # O_EXCL: the blob is created here and nowhere else, and a name that
        # already exists is a refusal rather than something to open.
        fd = os.open(blob, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                     | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
        os.close(fd)
        now = int(time.time())
        _staging_meta_write(d, {
            "id": sid, "label": label, "format": fmt, "access": access,
            "total": int(total), "sha256": digest, "received": 0,
            "created": now, "used": now, "uid": ctx.ident.real_uid,
            "attempts": 0, "inspected": False,
        })
    except BaseException:
        _staging_destroy(d)
        raise
    ctx.note = "staged"
    return {"ok": True, "staging": token, "chunk_bytes": IMPORT_CHUNK_BYTES,
            "total_bytes": int(total), "received": 0,
            "expires_in": IMPORT_IDLE_SECONDS,
            "next": "import-chunk"}


def v_import_chunk(req, ctx):
    """Append one chunk. NO CREDENTIAL. (C5 step 2)

    The aggregate cap is enforced INCREMENTALLY — before each write, against
    both the declared total and `Limits.MAX_SAFE_BYTES` — because a cap checked
    after reassembly is a cap that has already let the disk fill up.

    `offset` must equal what has been received. That is not pedantry: it makes
    reassembly a plain append with no seek, so there is no hole for a caller to
    leave unwritten and no way for two chunks to overlap. A client that lost a
    reply retries the same offset and is told what the helper actually has.
    """
    d, blob, meta = _staging_open(req, ctx)
    offset = req.get("chunk_offset", meta["received"])
    if not _is_int(offset) or offset < 0:
        raise Invalid("chunk_offset must be a non-negative integer")
    if offset != meta["received"]:
        raise Conflict("this upload has %d bytes; the next chunk must start "
                       "there" % meta["received"])
    raw = req.get("chunk_b64")
    if not isinstance(raw, str) or not raw:
        raise Invalid("chunk_b64 is required")
    # Refuse by arithmetic before decoding: base64 is 4 characters per 3 bytes,
    # so an over-long chunk is caught without allocating the decoded copy.
    if (len(raw) // 4) * 3 > IMPORT_CHUNK_BYTES + 3:
        raise Invalid("a chunk may carry at most %d bytes"
                      % IMPORT_CHUNK_BYTES)
    try:
        chunk = base64.b64decode(raw, validate=True)
    except (binascii.Error, ValueError):
        raise Invalid("chunk_b64 is not valid base64")
    if not chunk:
        raise Invalid("a chunk may not be empty")
    if len(chunk) > IMPORT_CHUNK_BYTES:
        raise Invalid("a chunk may carry at most %d bytes"
                      % IMPORT_CHUNK_BYTES)
    end = meta["received"] + len(chunk)
    if end > meta["total"] or end > Limits.MAX_SAFE_BYTES:
        raise Invalid("this chunk would take the upload past the size it "
                      "declared; nothing was written")

    fd = None
    try:
        fd = os.open(blob, os.O_WRONLY | os.O_APPEND | os.O_CLOEXEC
                     | os.O_NOFOLLOW)
        st = os.fstat(fd)
        if st.st_size != meta["received"]:
            # The file and the meta disagree: a previous append was torn, or
            # something else has been writing here. Neither is recoverable by
            # guessing which one is right.
            raise Conflict("the staged file no longer matches its record; "
                           "abort this upload and start again")
        write_all(fd, chunk)
        os.fsync(fd)
    except OSError as exc:
        raise Internal("the chunk could not be staged: %s"
                       % errno.errorcode.get(exc.errno, "OSError"))
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    meta["received"] = end
    meta["used"] = int(time.time())
    _staging_meta_write(d, meta)
    ctx.note = "staged"
    return {"ok": True, "received": end, "total_bytes": meta["total"],
            "remaining": meta["total"] - end,
            "complete": end == meta["total"],
            "next": "import-inspect" if end == meta["total"]
                    else "import-chunk"}


def v_import_inspect(req, ctx):
    """Say what the staged file claims to be. NO CREDENTIAL. (C5 step 3)

    **WHY THIS IS NOT A DISCLOSURE.** Everything returned here — format,
    version, cipher, KDF and its parameters — lives in the UNAUTHENTICATED
    header of the file, in the clear, and is readable by anyone who holds the
    bytes. The person who just uploaded them holds the bytes. Reporting them
    tells that caller nothing they did not already have, and it is the same
    test `probe` is held to: a probe that says too much is one that reveals
    something a key was needed for, and none of this needed a key.

    It does three jobs, in this order:

      1. verify the whole-file SHA-256 the caller declared at `import-begin`.
         A truncated or corrupted upload must fail LOUDLY here, not become a
         corrupt safe. A mismatch destroys the staging: bytes that are not what
         the caller said they were have no claim on this host's disk.
      2. prove the bytes are a STRUCTURALLY COMPLETE file of the declared
         format (`Backend.verify_structure`, no credential), so "this is not a
         safe at all" is answered before anybody is asked for a passphrase.
      3. apply the `Limits` KDF clamps to the file's DECLARED parameters, so a
         KDF bomb — Argon2 `m=4 GiB`, or a PWS3 ITER of 2^31 — is refused here
         rather than after an operator has typed a passphrase and waited
         minutes for it (I7).

    The UI must present this as what it is: read from the header, and NOT
    authenticated. Nothing here has been verified against a MAC, because
    verifying anything requires the key and the key requires the passphrase
    this step deliberately has not asked for.
    """
    d, blob, meta = _staging_open(req, ctx)
    if meta["received"] != meta["total"]:
        raise Conflict("this upload is incomplete: %d of %d bytes"
                       % (meta["received"], meta["total"]))
    # I54. Taken BEFORE the read, because the read is the cost, and released
    # by the `with` on every path out of this verb including the refusals
    # below that destroy the staging.
    with _ImportWorkSlot(os.path.dirname(d)):
        return _inspect_staged(req, ctx, d, blob, meta)


def _inspect_staged(req, ctx, d, blob, meta):
    """The body of `import-inspect`, inside the work slot. See `v_import_inspect`."""
    try:
        with open_safe_fd(blob, expect_uid=ctx.ident.euid) as sf:
            data = sf.read_all(Limits.MAX_SAFE_BYTES)
    except SecretsError:
        raise
    # FROM HERE ON, THIS VERB EITHER SUCCEEDS OR THE STAGING IS GONE.
    #
    # Everything below is a judgement about bytes that have already arrived in
    # full, and every refusal below is permanent: a file whose SHA-256 does not
    # match, whose structure is incomplete, or whose KDF parameters are outside
    # the clamps will fail this check identically on every retry. Keeping the
    # staging would leave up to 128 MiB that `import-commit` will not accept
    # either — commit requires `inspected` — waiting only for the idle sweep.
    #
    # It is placed AFTER the completeness check above deliberately: an upload
    # that is merely unfinished must NOT be destroyed, because the caller is
    # still sending it. "Incomplete" is a conflict the caller resolves by
    # sending more bytes; everything past this line is not.
    try:
        got = hashlib.sha256(data).hexdigest()
        if not constant_time_eq(got, meta["sha256"]):
            raise Invalid("the staged bytes do not match the SHA-256 declared "
                          "at import-begin; the upload was destroyed and "
                          "nothing was written")
        fmt = meta["format"]
        cls = load_backend_class(fmt)
        # No credential, and none is needed: this asks the FORMAT whether these
        # bytes are a complete file of it, which is a property of the bytes.
        cls.verify_structure(data)
        # The KDF clamp lives inside this call and it can raise; when it does
        # the staging goes with it — that is a KDF bomb, refused before any
        # operator was prompted.
        facts = _header_facts(fmt, data)
    except SecretsError:
        _staging_destroy(d)
        raise
    meta["inspected"] = True
    meta["used"] = int(time.time())
    # Stashed so `import-commit` can record in the registry entry exactly what
    # the operator was SHOWN before they typed a passphrase — see
    # `_import_source`. It is a copy of this response, not a second parse.
    meta["facts"] = {"version": facts.get("version"),
                     "cipher": facts.get("cipher"), "kdf": facts.get("kdf"),
                     "kdf_params": dict(facts.get("kdf_params") or {}),
                     "inspected_utc": _iso_utc()}
    _staging_meta_write(d, meta)
    out = {
        "ok": True, "staging": req.get("staging"), "id": meta["id"],
        "label": meta["label"], "access": meta["access"],
        "bytes": len(data), "sha256_ok": True,
        "authenticated": False,
        "note": "read from the file's unauthenticated header; nothing here "
                "has been checked against a MAC, because that needs the "
                "passphrase this step deliberately did not ask for",
        "next": "import-commit",
    }
    out.update(facts)
    return out


def _header_facts(fmt, data):
    """Header metadata for `import-inspect`, plus the KDF clamp. (C5 step 3)

    **BYTES ONLY, AND ONE READ (I43).** This used to take the staged file's
    PATH as well and build a synthetic registry entry so it could call
    `probe()` — which re-opened and re-read the whole file, a second time, for
    facts the caller had already read into memory. On a 128 MiB upload that
    doubled the verb's peak resident memory (measured at 2.35x the file), and
    it meant the digest was computed over one read while the reported cipher
    and KDF came from another. It also reached into `backends.kdbx` for two
    private names to get the cipher and the clamp, with a `getattr` fallback
    that silently degraded the clamp to "after the passphrase prompt".

    `Backend.inspect_bytes` answers all of it from the bytes already in hand:
    format, version, cipher, KDF and its declared parameters, with the `Limits`
    clamps applied to those parameters HERE, before anyone is prompted (I7).
    That is the whole point of the step — a KDF bomb refused at this moment
    costs the host microseconds, and refused one step later costs it the
    derivation and the operator the wait.

    Nothing here needed a credential and nothing here is authenticated: it is
    the file's own claim about itself, and the caller must label it that way.
    """
    cls = load_backend_class(fmt)
    facts = cls.inspect_bytes(data)
    out = {
        "format": facts.get("format") or fmt,
        "version": facts.get("version"),
        "cipher": facts.get("cipher"),
        "kdf": facts.get("kdf"),
        "kdf_params": dict(facts.get("kdf_params") or {}),
        # KDBX records nothing about whether a passphrase is required and PWS3
        # has no key-file concept, so these two are what the FORMAT can say and
        # no more. `import-commit` is where the truth is established: the file
        # opens with the credential given, or it does not land.
        "needs_password": bool(facts.get("needs_password", True)),
        "needs_keyfile": bool(facts.get("needs_keyfile", False)),
        "warnings": list(facts.get("warnings") or []),
    }
    if facts.get("compressed") is not None:
        out["compressed"] = bool(facts["compressed"])
    # `iterations` is the ONE number an operator recognises, and which of the
    # declared parameters it is depends on the KDF: a passes count for Argon2,
    # a rounds count for AES-KDF, an iteration count for PWS3. The precedence
    # is fixed here rather than left to each backend so `probe` and this verb
    # answer the same question the same way.
    params = out["kdf_params"]
    for key in ("iterations", "rounds", "time"):
        if _is_int(params.get(key)):
            out["iterations"] = int(params[key])
            break
    else:
        out["iterations"] = None
    return out


def _import_source(meta, summary, nbytes):
    """The `source` provenance block an imported entry carries. (I46)

    Written from what `import-inspect` READ FROM THE HEADER and stashed in the
    staging meta, not from a fresh parse: this is a record of what the operator
    was shown before they typed their passphrase, which is the only thing it is
    any use as. `schema/safe-registry.schema.json` says the rest — it is not
    authenticated, it is not re-verified, and nothing is keyed on it.

    Every key is dropped rather than guessed when it is not known, because the
    schema is `additionalProperties: false` and a key this writer invents is an
    entry the loader will refuse on its next load.
    """
    facts = meta.get("facts") or {}
    out = {"inspected_utc": facts.get("inspected_utc") or _iso_utc(),
           "bytes": int(nbytes)}
    digest = meta.get("sha256")
    if isinstance(digest, str) and re.fullmatch(r"[0-9a-f]{64}", digest):
        out["sha256_at_import"] = digest
    for key, src in (("format_version", "version"), ("cipher", "cipher"),
                     ("kdf", "kdf")):
        val = facts.get(src) or (summary or {}).get(src)
        if isinstance(val, str) and 1 <= len(val) <= 32:
            out[key] = val
    params = {k: int(v) for k, v in (facts.get("kdf_params") or {}).items()
              if k in _SOURCE_KDF_KEYS and _is_int(v) and v >= 0}
    if params:
        out["kdf_params"] = params
    return out


def v_import_commit(req, ctx):
    """Open the staged file with the credential, and only then land it. (C5.4)

    **THIS IS WHAT STOPS `safe-import` BEING AN ARBITRARY-WRITE PRIMITIVE.**
    The credential arrives here on stdin for the first time (I10), and the only
    bytes that can ever become a safe are bytes that are demonstrably a safe
    the uploader can already open. A file that does not open does not land.

    A WRONG PASSPHRASE KEEPS THE STAGING. Re-uploading 100 MiB because of a
    typo is a bug, not a security control. The staging survives a failed
    attempt and the operator may try again, up to `IMPORT_MAX_ATTEMPTS` times
    or until the idle timer expires it.

    WHAT THAT BOUND IS, SAID PLAINLY, BECAUSE IT IS EASY TO MISREAD AS A
    LOCKOUT. It protects THIS HOST'S CPU, not the safe. The caller uploaded the
    file and still has it, so they can guess against their own copy offline as
    fast as their hardware allows — rate-limiting the guess here would be
    theatre and this code does not pretend otherwise. What is real is that
    every attempt costs this machine one full KDF derivation, at up to
    `Limits.ARGON2_MAX_MEMORY_KIB`, on a helper that may be root. So the
    attempts are counted and the staging expires. The I16 lockout is NOT wired
    in: it counts guesses against a REGISTERED safe, keyed on (real uid, safe
    id), and neither of those exists until this verb succeeds.
    """
    d, blob, meta = _staging_open(req, ctx)
    sid, fmt, access = meta["id"], meta["format"], meta["access"]

    # I3: the class gate is re-derived here from kernel identity, not trusted
    # from `import-begin`. A staging is a file on disk and the process that
    # made it is gone.
    gate({"access": access, "groups": [], "owner": None, "mode": "rw"},
         ctx.ident, want_write=True)
    if meta["received"] != meta["total"]:
        raise Conflict("this upload is incomplete: %d of %d bytes"
                       % (meta["received"], meta["total"]))
    if not meta.get("inspected"):
        # `import-inspect` is where the SHA-256 is verified and the KDF is
        # clamped. Committing without it would mean deriving a key from
        # parameters nothing had range-checked, which is I7 with extra steps.
        raise Conflict("run import-inspect first: it is where the upload's "
                       "SHA-256 is verified and the file's key-derivation "
                       "parameters are range-checked")
    if meta.get("attempts", 0) >= IMPORT_MAX_ATTEMPTS:
        _staging_destroy(d)
        raise NotFound("this upload has used its %d credential attempts and "
                       "its staged bytes were destroyed; start it again"
                       % IMPORT_MAX_ATTEMPTS)
    # I54, taken before the read and the derivation, released on every path out.
    with _ImportWorkSlot(os.path.dirname(d)):
        return _commit_staged(req, ctx, d, blob, meta, sid, fmt, access)


def _commit_staged(req, ctx, d, blob, meta, sid, fmt, access):
    """The body of `import-commit`, inside the work slot. See `v_import_commit`."""

    safe_path, reg_dir, reg_name = _mint(ctx.ident, sid, fmt, access)
    # Re-checked, because an id that was free when the upload started may not
    # be free now: an upload takes minutes and another administrator may have
    # used the name. Nothing is overwritten, ever (C2).
    _refuse_conflict(ctx, sid, safe_path, reg_dir, reg_name)

    meta["attempts"] = int(meta.get("attempts", 0)) + 1
    meta["used"] = int(time.time())
    _staging_meta_write(d, meta)

    # ONE READ, AND THE BYTES THAT ARE PROVEN ARE THE BYTES THAT LAND (I43).
    #
    # This used to read the staged blob twice: once by path inside the
    # candidate check, and again by path for the bytes it wrote, with a full
    # KDF derivation in between and nothing tying the two together. So the
    # bytes that opened and the bytes that became a safe were never the same
    # bytes, and the invariant this verb's whole security argument rests on —
    # "a file that does not open does not land" — was not true.
    #
    # The fix is structural rather than a re-check: `data` is read once, and it
    # is the same object that is validated and the same object that is written.
    # `_open_candidate` no longer accepts a path at all, so there is nothing
    # left to re-read and no way to reintroduce the divergence by accident.
    with open_safe_fd(blob, expect_uid=ctx.ident.euid) as sf:
        data = sf.read_all(Limits.MAX_SAFE_BYTES)
    # And the digest is re-checked against what the caller DECLARED at
    # import-begin, on these bytes, now. `import-inspect` verified it too, but
    # that was a separate read at a separate moment; checking it here is what
    # makes "what landed is what was declared and inspected" a statement about
    # one array of bytes rather than about three reads that were probably the
    # same.
    if not constant_time_eq(hashlib.sha256(data).hexdigest(), meta["sha256"]):
        _staging_destroy(d)
        raise Invalid("the staged bytes no longer match the SHA-256 declared "
                      "at import-begin; the upload was destroyed and nothing "
                      "was written")

    password, keyfile = _new_credentials(req)
    try:
        if password is None and keyfile is None:
            raise Invalid("a credential is required to prove this file opens")
        result = _open_candidate(fmt, data, password, keyfile, mine=False)
        if password is None:
            # The file opened on a key file alone. This program cannot express
            # that in the registry without storing the key file at a path it
            # registers — and a key file kept beside the safe it opens is worth
            # nothing (safe-registry.schema.json says so in as many words). So
            # it is refused, with the reason, rather than registered as a safe
            # whose entry would be a lie about what opens it.
            raise Unsupported(
                "this file opens with a key file and no passphrase. This "
                "helper does not register a key-file path, so it cannot "
                "describe such a safe in the registry; an administrator can "
                "add the entry by hand with a keyfile it stores deliberately")
        doc = _registry_doc(sid, meta["label"], fmt, safe_path, access,
                            origin="imported",
                            source=_import_source(meta, result, len(data)))
        report, entry = _land_new_safe(ctx, safe_path, data, doc,
                                       reg_dir, reg_name, access)
    except BadCredential:
        # THE STAGING SURVIVES. See the docstring: the bytes are expensive and
        # the passphrase is a typo away from right.
        ctx.note = "credential-rejected"
        raise
    finally:
        for item in (password, keyfile):
            if item is not None:
                item.zero()

    _staging_destroy(d)
    ctx.note = "imported-%s" % entry["registry"]
    return {"ok": True, "safe": _entry_row(entry, ctx),
            "registry": entry["registry"], "bytes": report["bytes"],
            "format": fmt,
            # `validate_candidate` names them `entries`/`groups`; the response
            # has always named them `*_total` and docs/CONTRACT.md fixes that,
            # so the mapping is here rather than in the backend.
            "entries_total": result.get("entries"),
            "groups_total": result.get("groups"),
            "warnings": list(result.get("warnings") or [])}


def v_import_abort(req, ctx):
    """Destroy a staging. NO CREDENTIAL, and it always succeeds or says why."""
    d, _blob, meta = _staging_open(req, ctx, touch=False)
    dropped = _staging_destroy(d)
    ctx.note = "staged"
    return {"ok": True, "dropped": bool(dropped), "id": meta.get("id"),
            "discarded_bytes": int(meta.get("received") or 0)}


# ------------------------------------------------------- forget / delete ---

def _registry_file_of(entry, ctx):
    """(directory, file name) the entry was loaded from — never from a request.

    Both halves are helper-derived: the directory from the entry's own
    `registry` tag, and the name from `os.listdir` at load time. A caller
    cannot influence either, which is what keeps `safe-forget` from being an
    "unlink any file" verb wearing a registry id as a disguise (I4).
    """
    source = entry.get("registry", "system")
    name = entry.get("registry_file")
    if not isinstance(name, str) or not name.endswith(".json") \
            or "/" in name or name.startswith("."):
        raise Internal("this entry has no registry file recorded")
    if source == "user":
        return user_registry_dir(ctx.ident), name
    return os.path.join(registry_root(), SAFES_D), name


def v_safe_forget(req, ctx):
    """Remove the registry entry. LEAVE THE FILE EXACTLY WHERE IT IS.

    This is the default and the safe half of C8: creating without removing
    means an operator can fill the registry and never clean it, and the removal
    that should be easy is the one that destroys nothing. After this the safe
    file is still on disk, still 0600, still openable by anything that knows
    its path — it is simply no longer a safe this program will open, because
    the registry is the only thing that says which files are safes.

    The unlink is done with `unlinkat` through a descriptor on the registry
    directory, using a name that came from `os.listdir` — not a path built from
    anything the caller sent.
    """
    entry = lookup_safe(req.get("safe"), ctx)
    ctx.safe_id = entry["id"]
    # The same class gate as every other verb (I3). `want_write=False` on
    # purpose: `mode: "ro"` is a statement about the safe's CONTENTS, and
    # unregistering a safe does not touch its contents. `safe-delete`, which
    # does, passes True.
    gate(entry, ctx.ident, want_write=False)
    if entry.get("access", "admin") == "admin" and ctx.ident.euid != 0:
        raise AccessDenied("only a root helper may edit the system registry")

    dupes = [n for n in (entry.get("registry_files") or [])
             if n != entry.get("registry_file")]
    if dupes:
        # I51. Refusing is the only honest answer: unlinking one file of two
        # would report success and leave the safe registered, and unlinking
        # both would destroy a second entry the operator never named. The
        # message says which files, because they are in a directory the caller
        # can already list and the remedy is `rm`.
        raise Conflict(
            "%d registry files declare the id %r (%s); this will not remove "
            "one of them and report the safe unregistered. Delete the ones "
            "you did not mean to keep by hand, then try again"
            % (len(dupes) + 1, entry["id"],
               ", ".join(sorted(dupes + [entry.get("registry_file")]))))

    # Resolved BEFORE the unlink, because afterwards there is no entry to
    # resolve. `resolve_entry` is the same function every other verb uses; it
    # never consults the request.
    try:
        resolved_path = resolve_entry(entry, ctx.ident)["path"]
    except SecretsError:
        resolved_path = entry.get("path")

    directory, name = _registry_file_of(entry, ctx)
    dirfd = None
    try:
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY
                        | os.O_NOFOLLOW | os.O_CLOEXEC)
        os.unlink(name, dir_fd=dirfd)
        os.fsync(dirfd)
    except OSError as exc:
        if exc.errno in (errno.EACCES, errno.EPERM, errno.EROFS):
            raise AccessDenied("this caller may not write to the registry "
                               "directory holding that entry")
        if exc.errno == errno.ENOENT:
            raise NotFound("that entry's registry file is already gone")
        raise Internal("the registry entry could not be removed: %s"
                       % errno.errorcode.get(exc.errno, "OSError"))
    finally:
        if dirfd is not None:
            try:
                os.close(dirfd)
            except OSError:
                pass
    ctx.note = "forgotten"
    ctx.load()
    return {"ok": True, "forgotten": entry["id"],
            "registry": entry.get("registry", "system"),
            # THE PATH, in the RESPONSE and never in the audit line (I15).
            # "We stopped listing it" is only a useful answer if the operator is
            # told where the file went, and this caller could already read that
            # path out of the registry entry they just unregistered. The audit
            # log is the place where a path would be a leak, and it does not get
            # one — `tests/integration/registry_writes.py` asserts both halves.
            "path": resolved_path,
            "file_kept": True,
            "warning": "the safe file was NOT deleted; it is still on disk "
                       "and this program has simply stopped listing it. Use "
                       "safe-delete if you meant to destroy it."}


def _shred(path):
    """Overwrite a file with random bytes, then unlink it. BE HONEST ABOUT IT.

    WHAT THIS GUARANTEES: the file is unlinked, so the name is gone and the
    space is released; and on a filesystem that overwrites blocks in place —
    ext4 in its default `data=ordered` mode, no snapshots, a spinning disk —
    the previous contents of those blocks are gone from the media.

    WHAT IT DOES NOT GUARANTEE, AND THIS IS MOST INSTALLATIONS:

      * on a copy-on-write filesystem (btrfs, ZFS, bcachefs, or any overlay or
        LVM thin volume) the overwrite writes NEW blocks. The old ones are
        still there and are reachable from any snapshot;
      * on an SSD the flash translation layer decides where a write lands. An
        overwrite of a logical block does not erase the physical page that held
        it, and wear levelling has probably already made several copies;
      * a journal, a `fsck` recovery, a backup, a `.bak.d` generation on
        another filesystem, a KeePassXC `.lock` sibling, or a snapshot of the
        VM this runs in are all outside this function entirely.

    So it is a courtesy, not a wipe. The honest statement in the response says
    exactly this, because "shredded" printed next to a file that is still
    recoverable is worse than no claim at all — an operator who believes it
    stops taking the other precautions.
    """
    fd = None
    overwritten = False
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        st = os.fstat(fd)
        if stat.S_ISREG(st.st_mode) and 0 < st.st_size <= Limits.MAX_SAFE_BYTES:
            remaining = st.st_size
            while remaining > 0:
                block = min(remaining, 1024 * 1024)
                write_all(fd, _sysrandom.token_bytes(block))
                remaining -= block
            os.fsync(fd)
            overwritten = True
    except OSError:
        overwritten = False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    try:
        os.unlink(path)
    except OSError:
        return overwritten, False
    return overwritten, True


def _minted_path_or_refuse(entry, ctx):
    """The entry's `path`, PROVED to be the path this program would mint. (I47)

    THE GATE THAT MAKES `safe-delete` A DELETE AND NOT AN UNLINK PRIMITIVE.
    docs/CONTRACT.md has always specified it and the code did not have it: the
    verb resolved the registry `path` and shredded whatever was there. That is
    an arbitrary-file-destroy primitive scoped to whatever identity the helper
    runs as, driven from a field an operator can edit — and C4 deliberately
    hands every unprivileged user a registry they can write, so it was reachable
    without any privilege at all. 512 bytes of /dev/urandom declared
    `format: psafe3` and pointed at `~/.gnupg/trustdb.gpg` was enough; the file
    was never opened through a backend, so nothing checked it was a safe.

    The gate is DERIVED, not declared: `_mint` is asked what path this id and
    access class would produce TODAY, and the entry's own path must equal it
    exactly. `origin: "created"` corroborates and does NOT authorise — a
    hand-edited provenance key must not be able to talk this helper into an
    unlink, which is why the check reads the id and not the entry.

    The consequence, and it is intended: **a hand-registered safe can only be
    forgotten.** Its file is somewhere an administrator chose, this program did
    not put it there, and removing it is `rm`, not a browser button.
    `safe-forget` still works on it and destroys nothing.
    """
    resolved = resolve_entry(entry, ctx.ident)
    path = resolved["path"]
    minted, _reg_dir, _reg_name = _mint(ctx.ident, entry["id"],
                                        entry["format"],
                                        entry.get("access", "admin"))
    # os.path.realpath is deliberately NOT used on either side: a symlink in
    # the chain is `open_safe_fd`'s refusal to make, and resolving one here
    # would turn "these are the same name" into "these end up in the same
    # place", which is the weaker claim.
    if path != minted:
        raise AccessDenied(
            "this safe's registry entry names a file this program did not "
            "create, so it will not destroy it. safe-forget removes the "
            "entry and leaves the file alone; deleting the file is a "
            "deliberate act outside this program")
    return path


def _delete_ring(safe_path, entry):
    """Shred the backup ring of a safe about to be destroyed. Returns a count.

    TWO NARROWINGS, BOTH OF THEM FIXES (I47).

      1. **The directory is DERIVED from the minted safe path**, never read
         from the entry's `backup.dir`. A registry entry that pointed its ring
         at `~/docs` had that whole directory swept by one `safe-delete` — the
         confirmation token named the safe id and the operator was never shown
         the directory that was about to be emptied. `backup_dir_for(path,
         None)` is `<safe>.bak.d`, which is beside a file we just proved this
         program minted.
      2. **Only files named like a generation are removed.** `_ring_backup`
         writes `<basename>.<stamp>.<pid>.bak`; anything else in that directory
         is somebody else's and is left, along with every non-regular entry.

    A ring at a custom `backup.dir` is therefore NOT destroyed, and the caller
    reports that in a warning rather than quietly leaving copies of a safe the
    operator asked to destroy. Sweeping it would mean unlinking inside a
    directory a request-editable field named, which is the bug.
    """
    ring = backup_dir_for(safe_path, None)
    prefix = os.path.basename(safe_path) + "."
    removed = 0
    try:
        names = sorted(os.listdir(ring))
    except OSError:
        return 0
    for name in names:
        if not (name.startswith(prefix) and name.endswith(".bak")):
            continue
        gen = os.path.join(ring, name)
        try:
            st = os.lstat(gen)
        except OSError:
            continue
        if not stat.S_ISREG(st.st_mode):
            # Not a generation. Left alone and NOT recursed into: a directory
            # or a symlink in a backup ring is somebody else's business and
            # deleting it would be this verb exceeding its remit.
            continue
        if _shred(gen)[1]:
            removed += 1
    try:
        os.rmdir(ring)          # only if we emptied it; a leftover is left
    except OSError:
        pass
    return removed


def v_safe_delete(req, ctx):
    """Forget the entry AND destroy the file and its backup ring. (C8)

    The most destructive verb in this program, gated in this order, and every
    step refuses before anything is touched:

      1. the class gate, from kernel identity, FIRST — before the confirmation
         token is even looked at, so a caller who may not have this safe is
         refused for that reason rather than for a typo in their confirm;
      2. `want_write=True`, so a registry `mode: "ro"` refuses. Unlinking a
         file is the most complete write there is, and an operator who marked a
         safe read-only has said they are not prepared to lose it;
      3. **the DERIVED-PATH gate** (`_minted_path_or_refuse`) — the entry's
         path must be the path this program would mint for this id and class
         today, or nothing is destroyed. Without it this verb destroys any file
         a registry entry names, and a user's own registry is a registry they
         can write;
      4. an exact confirmation token that NAMES THIS SAFE
         (`delete-safe:<id>`), read from the SCHEMA-DECLARED field
         `delete_confirm` and compared with `constant_time_eq`. Per-safe for
         the same reason `export`'s token is: a confirm the operator gave for a
         throwaway safe must not be replayable against the one that matters;
      5. audited BY ID. There is no path in the audit line, here or anywhere.

    **THE REGISTRY ENTRY GOES FIRST, THEN THE FILE (I48).** The original order
    was the other way round, and it produced the worst partial failure this
    program can have: the safe and its entire backup ring were shredded, then
    the registry unlink failed, and the caller was told `access-denied` — so
    the operator believed nothing had happened, `list` still showed the safe as
    usable, and the loss surfaced at the next unlock with the ring already
    gone. Unregistering first means a delete that cannot complete leaves the
    file intact and merely unregistered, which is `safe-forget`'s outcome and a
    state the operator can act on.

    The backup ring goes with the file deliberately. Leaving `<safe>.bak.d/`
    full of complete copies of a safe the operator asked to destroy would make
    this verb a lie, and a ring beside a deleted safe is the one place nobody
    thinks to look. But only the DERIVED ring — see `_delete_ring`.
    """
    entry = lookup_safe(req.get("safe"), ctx)
    ctx.safe_id = entry["id"]
    gate(entry, ctx.ident, want_write=True)
    if entry.get("access", "admin") == "admin" and ctx.ident.euid != 0:
        raise AccessDenied("only a root helper may delete an admin-class safe")

    path = _minted_path_or_refuse(entry, ctx)

    want = DELETE_CONFIRM_PREFIX + entry["id"]
    # `delete_confirm`, which is the field `schema` declares, docs/CONTRACT.md
    # documents and secrets.js sends. It used to read `confirm` — `export`'s
    # field name — so through the published interface this verb could never
    # succeed, and it destroyed on a field nobody was told about. The
    # dispatcher now refuses a request key no verb declares, so the old
    # spelling is not merely ignored, it is an error (I50).
    confirm = req.get("delete_confirm")
    if not isinstance(confirm, str) or not constant_time_eq(confirm, want):
        raise AccessDenied(
            "safe-delete requires the confirmation token %r, which the UI must "
            "show the operator in full before sending" % want)

    size = 0
    try:
        with open_safe_fd(path, expect_uid=ctx.ident.euid) as sf:
            size = sf.st.st_size
    except SecretsError:
        # The entry may outlive its file. Forgetting it is still the right
        # outcome, and the response says the file was already gone.
        size = -1

    # STEP 1 OF THE DESTRUCTION: the registry. It can fail (a read-only /etc, a
    # registry directory this caller cannot write) and when it does, nothing
    # has been destroyed yet.
    forget = v_safe_forget({"safe": entry["id"]}, ctx)
    # The counter for a safe that no longer exists (I55). `lockout_reset` ZEROES
    # rather than unlinks, deliberately — see its docstring: unlinking a file
    # other helpers hold an flock on is I39 reached from the one path allowed to
    # make the counter smaller. So this leaves a 60-byte file behind, and that
    # is the intended state rather than litter.
    lockout_reset(ctx.ident, entry["id"])

    # STEP 2: the bytes. Past this line a failure can only leave MORE of the
    # safe than the operator asked for, never less than they were told.
    overwritten = removed = False
    ring_removed = 0
    if size >= 0:
        overwritten, removed = _shred(path)
        ring_removed = _delete_ring(path, entry)

    custom_ring = (entry.get("backup") or {}).get("dir")
    warning = (
        "the file was overwritten once with random bytes and unlinked. "
        "That is a courtesy, not a wipe: on a copy-on-write filesystem "
        "the overwrite wrote new blocks and the old ones survive in any "
        "snapshot, and on an SSD the flash translation layer decides "
        "where a write lands, so the physical pages that held this safe "
        "are not necessarily erased. Backups, journals and VM snapshots "
        "are outside this program entirely.")
    if custom_ring:
        # Said out loud rather than swept. This verb will not unlink inside a
        # directory a registry field named — that is the amplification I47 was
        # — so the operator is told where the copies still are.
        warning += (" This safe's registry entry names its own backup "
                    "directory, which was NOT touched: complete copies of "
                    "this safe may still be in it, and removing them is a "
                    "deliberate act outside this program.")
    ctx.note = "deleted"
    return {
        "ok": True, "deleted": entry["id"],
        "registry": forget.get("registry"),
        "file_removed": bool(removed), "file_missing": size < 0,
        "bytes": int(size) if size > 0 else 0,
        "backups_removed": ring_removed,
        "overwritten": bool(overwritten),
        "warning": warning,
    }


# ===========================================================================
# the `schema` verb — the single source of truth for the UI
# ===========================================================================
#
# Same shape as cockpit-wireguard's contract v2 and cockpit-adlab's verb table,
# merged into the five keys docs/CONTRACT.md fixes for this project:
#
#     { version, verbs[], groups[], fields[], enums{} }
#
# The rule the UI agent works to: **render nothing that is not in here.** Every
# control, bound, option, placeholder, help string and `breaks_when_wrong` hint
# comes from this verb, so adding a field to the helper adds it to the page with
# no JS change — and anything omitted here cannot appear in the UI at all.
#
# Two keys are specific to this project and the UI must implement both:
#
#   "secret": true      the value is a credential. Render type=password with
#                       autocomplete="off", never put it in a storage API, never
#                       in a data-attribute, never in a global, and overwrite the
#                       variable after the spawn (I11).
#   "options_from"      the option list is not static. "list.safes" means "call
#                       the list verb"; "tree.groups" means "call tree". The
#                       schema cannot know the registry, and inventing the list
#                       in JS is exactly what this design forbids.

CONTROLS = ("text", "password", "number", "toggle", "select", "radio",
            "textarea", "tags", "search", "object", "json", "file-bytes",
            "readonly", "password-reveal", "hidden")


def fld(fid, label, control, **kw):
    """One field. Every key the UI may read is present on every field, with
    null where it does not apply — a renderer that has to test for the presence
    of a key is a renderer that will one day guess.

    `fields` and `key` are the two that describe a SHAPE rather than a value:

      * `fields` on an `object` control is the sub-form, one level down, in
        this same descriptor shape. On a `json` control it describes the shape
        of each VALUE in the map — there is no sub-form to draw, because the
        keys are the operator's, but a renderer that grows a proper key/value
        control has everything it needs to draw one without inventing a rule.
      * `key` is that renderer's other half: a full field descriptor for the
        map's KEY, so the per-key validation (its pattern, its length cap, what
        breaks when it is wrong) is published rather than left for the page to
        assume. Null on every control that is not a map.
    """
    out = {
        "id": fid,
        "label": label,
        "control": control,
        "type": kw.get("type", "string"),
        "required": kw.get("required", False),
        "secret": kw.get("secret", False),
        "default": kw.get("default", None),
        "min": kw.get("min", None),
        "max": kw.get("max", None),
        "maxlength": kw.get("maxlength", None),
        "options": kw.get("options", None),
        "options_from": kw.get("options_from", None),
        "pattern": kw.get("pattern", None),
        "placeholder": kw.get("placeholder", ""),
        "help": kw.get("help", ""),
        "breaks_when_wrong": kw.get("breaks_when_wrong", None),
        "unit": kw.get("unit", None),
        "fields": kw.get("fields", None),
        "key": kw.get("key", None),
        "partial": kw.get("partial", False),
    }
    if control not in CONTROLS:
        raise Internal("schema field %r uses an unknown control" % fid)
    return out


