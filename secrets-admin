# ===========================================================================
# output framing — one JSON object, redacted, and nothing else  (I15)
# ===========================================================================

def _note(msg):
    """Diagnostics to stderr. stdout carries exactly one JSON object."""
    try:
        sys.stderr.write("secrets-admin: %s\n" % redact(str(msg)))
    except Exception:                                          # noqa: BLE001
        pass


def emit(obj):
    """Write ONE JSON object to stdout, through the redaction filter.

    `ensure_ascii=False` is deliberate: with the default, a non-ASCII passphrase
    that somehow reached a response would be escaped to \\uXXXX and would slip
    straight past `redact()`, which matches text. Emitting real UTF-8 keeps the
    safety net able to see what it is supposed to catch.

    The net only works if credentials are already zeroed by the time a response
    is built — otherwise a revealed value that happens to equal the master
    passphrase would come back as "***". Every verb zeroes its `Secret`s in a
    `finally` before returning, which is also what I14 wants.
    """
    text = json.dumps(obj, ensure_ascii=False, sort_keys=False)
    try:
        sys.stdout.write(redact(text) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        # The Cockpit channel went away mid-answer. Nothing to report to, and a
        # traceback here would be the only thing this program ever printed that
        # was not one JSON object.
        raise SystemExit(0)


def _iso_utc(when=None):
    ts = datetime.datetime.fromtimestamp(
        time.time() if when is None else when, datetime.timezone.utc)
    return ts.strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


# ===========================================================================
# identity — from the kernel, never from the request body  (I2, I3)
# ===========================================================================

class Identity:
    """Who the kernel says is calling, re-derived inside every verb.

    `real_uid` is the human behind an escalation. Cockpit's admin path runs this
    helper through pkexec/sudo, so `getuid()` is 0 there too and the only record
    of who asked is SUDO_UID / PKEXEC_UID. Those are read ONLY when euid is 0:
    an unprivileged caller can set SUDO_UID to anything they like, and believing
    it would turn an environment variable into a group membership.
    """

    __slots__ = ("uid", "euid", "gid", "egid", "groups", "real_uid",
                 "real_name", "escalated", "admin_group", "pid")

    def __init__(self):
        self.uid = os.getuid()
        self.euid = os.geteuid()
        self.gid = os.getgid()
        self.egid = os.getegid()
        self.pid = os.getpid()
        try:
            self.groups = sorted(os.getgroups())
        except OSError:
            self.groups = []
        self.escalated = False
        real = self.uid
        if self.euid == 0:
            for var in ("SUDO_UID", "PKEXEC_UID"):
                raw = os.environ.get(var)
                if raw and raw.isdigit():
                    try:
                        cand = int(raw)
                    except ValueError:
                        continue
                    if 0 < cand < 2 ** 31:
                        real, self.escalated = cand, True
                        break
        self.real_uid = real
        self.real_name = _uid_name(real)
        self.admin_group = _host_admin_group()

    def as_dict(self):
        """What `health` may show. No environment, no command line."""
        return {"uid": self.uid, "euid": self.euid,
                "real_uid": self.real_uid, "real_user": self.real_name,
                "escalated": self.escalated, "pid": self.pid,
                "admin_group": self.admin_group,
                "class_available": "admin" if self.euid == 0 else "user"}


def _uid_name(uid):
    try:
        return pwd.getpwuid(uid).pw_name
    except (KeyError, OSError, TypeError):
        return None


def _host_admin_group():
    """`sudo` on Debian/Ubuntu, `wheel` on the RPM side. Detected, not assumed —
    edt1 has `sudo` and no `wheel`, and a hardcoded name would silently widen
    the gate to "no group matched" on the other family."""
    for name in ("sudo", "wheel"):
        try:
            grp.getgrnam(name)
            return name
        except (KeyError, OSError):
            continue
    return None


def _in_group(uid, group_name):
    """Membership by primary gid OR supplementary list, resolved for the REAL
    caller — not from os.getgroups(), which behind an escalation is root's."""
    if not group_name:
        return False
    try:
        who = pwd.getpwuid(uid)
    except (KeyError, OSError, TypeError):
        return False
    try:
        gr = grp.getgrnam(group_name)
    except (KeyError, OSError):
        return False
    if who.pw_gid == gr.gr_gid:
        return True
    return who.pw_name in gr.gr_mem


def _resolve_owner(owner):
    """Registry `owner` (uid string, login name, or None/%u) -> uid or None."""
    if owner is None or owner == "%u":
        return None
    if isinstance(owner, str) and owner.isdigit():
        try:
            return int(owner)
        except ValueError:
            return None
    try:
        return pwd.getpwnam(owner).pw_uid
    except (KeyError, OSError, TypeError):
        # An owner we cannot resolve must not become "anybody". The gate treats
        # None-from-a-real-value as a refusal below, so this returns a sentinel.
        return -1


# ===========================================================================
# the access class gate — run inside EVERY verb  (I1, I2, I3)
# ===========================================================================

def gate(entry, ident, *, want_write=False):
    """Refuse the verb unless the kernel agrees this caller may have it.

    Called at the top of every verb and again for every frame inside an `open`
    session. Not once at start-up, and not when the safe list is built: a caller
    who can reach the helper can call any verb in any order, so the check has to
    live where the operation does.

    Nothing in this function reads the request. `access`, `groups` and `owner`
    come from the root-owned registry; `euid`, `real_uid` and group membership
    come from the kernel and /etc/group.
    """
    access = entry.get("access", "admin")

    if access == "admin":
        # I2: the admin class is the one that runs as root, so the euid check is
        # the whole point. `superuser: "require"` in the browser is a request,
        # not a guarantee — this is the guarantee.
        if ident.euid != 0:
            raise AccessDenied(
                "this safe is administrator-class; turn on Cockpit's "
                "Administrative access and try again")
        groups = list(entry.get("groups") or [])
        if not groups:
            groups = [ident.admin_group] if ident.admin_group else []
        # Direct root (no escalation behind it) is administrative by definition;
        # asking /etc/group whether uid 0 is in `sudo` would answer "no" on a
        # perfectly normal host.
        if ident.real_uid != 0:
            if not groups:
                raise AccessDenied(
                    "no administrative group is configured for this safe and "
                    "this host has neither sudo nor wheel")
            if not any(_in_group(ident.real_uid, g) for g in groups):
                raise AccessDenied(
                    "the calling user is not in an administrative group "
                    "permitted to open this safe")
    else:
        # I2 again, from the other side: a root helper opening a file inside a
        # directory the user controls is exactly the symlink race I5 exists for.
        # The user class is served unescalated or not at all.
        if ident.euid == 0:
            raise AccessDenied(
                "this safe is user-class and is not opened by a root helper; "
                "call it without Cockpit's Administrative access")
        want = _resolve_owner(entry.get("owner"))
        if want == -1:
            raise AccessDenied(
                "this safe names an owner that does not exist on this host")
        if want is not None and want != ident.euid:
            raise AccessDenied("this safe belongs to another user")
        # File ownership itself is not asserted here: open_safe_fd fstats the
        # descriptor it opened with expect_uid = this euid, which is the only
        # check that cannot be raced.

    if want_write and entry.get("mode", "rw") == "ro":
        # Three distinct causes of read-only, three distinct codes
        # (docs/CONTRACT.md): registry mode is access-denied; KDBX3 is
        # unsupported; a lossy round trip is conflict. The latter two are the
        # backend's to raise.
        raise AccessDenied("this safe is registered read-only")


# ===========================================================================
# the registry — the only source of safes  (I1, I4)
# ===========================================================================
#
# Two validators run over every entry and BOTH must pass:
#
#   1. `validate_entry()` below — hand written, dependency free, and the actual
#      enforcement point. It is what runs when python3-jsonschema is not
#      installed, so a missing package can never mean "no validation".
#   2. the Draft-07 schema in schema/safe-registry.schema.json, via jsonschema
#      when it is importable. That is the machine-readable half of
#      docs/CONTRACT.md, and running it here is how drift between the document
#      and this file shows up as a dropped entry rather than as a surprise.
#
# The duplication is deliberate and schema/README.md says so: a schema is a
# validator, not an enforcement point, and the only enforcement that counts is
# the one in the process the caller cannot rewrite.

_ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
_OWNER_RE = re.compile(r"^(%u|[0-9]{1,10}|[a-z_][a-z0-9_.-]{0,31}\$?)$")
_GROUP_RE = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_.-]*\$?$")
_DOTDOT_RE = re.compile(r"(^|/)\.\.(/|$)")

#: Backup rings under these trees are refused before atomic_replace ever sees
#: them: a backup is exactly as sensitive as the safe, and these are
#: world-writable and usually a different filesystem.
_FORBIDDEN_BACKUP_PREFIXES = ("/tmp/", "/var/tmp/", "/dev/shm/")


def _is_safe_abs_path(value, minlen=2):
    return (isinstance(value, str) and len(value) >= minlen
            and value.startswith("/") and not _DOTDOT_RE.search(value))


def _is_int(value):
    """int, and not a bool. `isinstance(True, int)` is True in Python, which is
    how `"keep": true` becomes a retention ring of one."""
    return isinstance(value, int) and not isinstance(value, bool)


def _sub_object(raw, key, spec, default):
    """Validate a nested object with additionalProperties:false semantics."""
    value = raw.get(key, None)
    if value is None and key not in raw:
        return dict(default), None
    if not isinstance(value, dict):
        return None, "%s must be an object" % key
    unknown = sorted(set(value) - set(spec))
    if unknown:
        return None, "%s has unknown key %s" % (key, unknown[0])
    out = dict(default)
    for name, (kind, lo, hi) in spec.items():
        if name not in value:
            continue
        got = value[name]
        if kind == "bool":
            if not isinstance(got, bool):
                return None, "%s.%s must be true or false" % (key, name)
        elif kind == "int":
            if not _is_int(got):
                return None, "%s.%s must be an integer" % (key, name)
            if got < lo or got > hi:
                return None, ("%s.%s must be between %d and %d"
                              % (key, name, lo, hi))
        elif kind == "path_or_null":
            if got is not None and not _is_safe_abs_path(got):
                return None, ("%s.%s must be an absolute path with no '..'"
                              % (key, name))
        out[name] = got
    return out, None


