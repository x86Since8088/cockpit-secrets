# secrets-agent.socket - the USER unit for the opt-in unlock agent (I18).
#
# A user unit, not a system one, and that is the whole security argument: the
# agent must run AS the person whose material it holds, or SO_PEERCRED on its
# socket reports a broker's uid for every caller and identifies nobody (the
# peercred-unix-relay pattern's first gotcha). See agent/README.md.
#
# Install with `./install.sh --with-agent`, which installs this file and
# ENABLES NOTHING. Turning it on is a per-user decision taken in that user's own
# session, and it should usually stay off:
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now secrets-agent.socket
#   systemctl --user status  secrets-agent.socket
#   systemctl --user disable --now secrets-agent.socket     # and turn it off
#
# Socket activation rather than a self-binding daemon because systemd creates
# the socket with the right owner and mode before anything is listening, so
# there is no window in which the socket exists loose, and no cross-namespace
# chown for the agent to get wrong.

[Unit]
Description=cockpit-secrets unlock agent socket (opt-in, off by default)
Documentation=file:/usr/local/lib/cockpit-secrets/agent/README.md
# The socket lives in the runtime dir, which only exists while the user is
# logged in. Nothing here should try to survive that.
PartOf=secrets-agent.service

[Socket]
# %t is $XDG_RUNTIME_DIR for a user unit: /run/user/<uid>/cockpit-secrets/.
ListenStream=%t/cockpit-secrets/agent.sock
SocketMode=0600
# The 0700 directory is what makes the 0600 socket un-raceable: no other
# unprivileged user can even look up a name inside it. RuntimeDirectory is
# declared HERE and not in the .service because systemd removes a runtime
# directory when the unit that declared it stops - the socket unit is the one
# that stays up across activations, so it is the one that must own the dir.
RuntimeDirectory=cockpit-secrets
RuntimeDirectoryMode=0700
# MEASURED on this host (systemd 259): RuntimeDirectoryMode= is honoured for a
# .service and IGNORED for a .socket - the directory lands 0755 whatever the
# line above says. So it is corrected here, after the socket is bound, and NOT
# with a leading '-': if the run dir cannot be made 0700 the socket unit must
# fail rather than listen in a directory anyone can read the name of.
ExecStartPost=/usr/bin/chmod 0700 %t/cockpit-secrets
# One client at a time is the normal case (a Cockpit bridge's helper); this is
# the queue depth, and it matches MAX_CONNECTIONS in secrets_agent.py.
Backlog=16
# No group gate. Group membership on a socket is a coarse gate and NOT an
# identity (the pattern says so explicitly), and with a 0700 dir there is
# nobody left to gate: the only non-owner who can reach this socket is root,
# who is out of scope in docs/THREAT-MODEL.md.

[Install]
WantedBy=sockets.target
