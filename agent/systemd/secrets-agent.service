# secrets-agent.service - the USER unit for the opt-in unlock agent (I18).
#
# Started by secrets-agent.socket, never enabled on its own: `Also=` is not set
# and there is no [Install] WantedBy for a target, so the only way this runs is
# a client connecting to the socket. Stopping the socket stops this.
#
# Everything under [Service] that is not ExecStart is there to make this the
# least useful process on the host to compromise. The agent holds passphrase
# material in memory, so the settings that matter most are the ones that stop it
# writing anything anywhere (ProtectSystem=strict, PrivateTmp) and the ones that
# stop that memory reaching disk or another process (LimitCORE=0, and
# harden_process()'s prctl(PR_SET_DUMPABLE,0) inside the program itself).

[Unit]
Description=cockpit-secrets unlock agent (opt-in, off by default)
Documentation=file:/usr/local/lib/cockpit-secrets/agent/README.md
Requires=secrets-agent.socket
After=secrets-agent.socket

[Service]
Type=exec
ExecStart=/usr/bin/python3 /usr/local/lib/cockpit-secrets/agent/secrets_agent.py
# The agent stops itself and zeroes everything on SIGTERM; that IS the stop.
KillSignal=SIGTERM
TimeoutStopSec=10
# Do NOT restart. A restarted agent is an empty agent - it holds nothing, by
# design - so an automatic restart would only hide the fact that everything was
# dropped. The next client connection activates it again through the socket.
Restart=no

# -- what it may not do -----------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# The agent never opens a safe file; the helper does that. So hiding /home
# costs nothing and removes the whole class of "the agent read something it
# should have left to the helper".
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectProc=invisible
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_UNIX and nothing else: this daemon has no business speaking to a network,
# and the one thing it does talk to (logind, over D-Bus) is a unix socket.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# A core dump of this process is every passphrase it holds. Belt (here) and
# braces (RLIMIT_CORE=0 set again by harden_process() at start-up, so the
# guarantee does not depend on the unit being installed correctly).
LimitCORE=0
UMask=0077
