# secrets-agent@.socket - the SYSTEM unit for the admin access class (I18).
#
# Instanced on the operator's NUMERIC UID: `secrets-agent@1000.socket`. One
# agent per operator, each with its own 0700 run dir, because for
# `access: "admin"` safes the client is the root helper and SO_PEERCRED
# therefore reports uid 0 for every caller - it cannot tell two admins apart.
# The separation between two admins is the per-uid INSTANCE and its run dir,
# not the peer credential. This is the peercred-unix-relay pattern's first
# gotcha, and pretending otherwise would be the exact mistake it warns about.
#
# NOT installed by ./install.sh --with-agent, which only installs the user
# units. Install this pair deliberately, as root:
#
#   install -m0644 secrets-agent@.socket secrets-agent@.service \
#           /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now secrets-agent@1000.socket
#
# Read agent/README.md first - in particular the part explaining that the
# cleaner integration is for the root helper to fork, drop to the operator's
# uid, and connect as them, which needs no uid exception here at all.

[Unit]
Description=cockpit-secrets unlock agent socket for uid %i (opt-in, off by default)
Documentation=file:/usr/local/lib/cockpit-secrets/agent/README.md
PartOf=secrets-agent@%i.service

[Socket]
ListenStream=/run/cockpit-secrets/%i/agent.sock
# systemd (as root) creates the socket owned by the instance uid with mode
# 0600, which is the reason to use socket activation here rather than let an
# unprivileged agent try to bind under a directory it does not own.
SocketUser=%i
SocketMode=0600
RuntimeDirectory=cockpit-secrets/%i
RuntimeDirectoryMode=0700
# See the user unit: a socket unit's RuntimeDirectoryMode is not applied by
# systemd 259, so the mode is set explicitly once the socket exists. No leading
# '-': failing to get 0700 must fail the unit.
ExecStartPost=/usr/bin/chmod 0700 /run/cockpit-secrets/%i
# The runtime directory is created owned by User=/Group= below, so the agent -
# and only the agent's uid, plus root - can traverse it.
User=%i
Backlog=16

[Install]
WantedBy=sockets.target
