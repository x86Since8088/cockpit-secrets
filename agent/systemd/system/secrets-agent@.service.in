# secrets-agent@.service - the SYSTEM unit for the admin access class (I18).
#
# Instanced on the operator's numeric uid and RUN AS that uid (User=%i). It is
# never root: an agent running as root would serve everyone and identify no
# one, and secrets_agent.py refuses to start as euid 0 for that reason.
#
# The hardening block is the same as the user unit's, and the same argument
# applies: this process holds passphrase material, so the settings that matter
# are the ones that keep it from writing anything (ProtectSystem=strict,
# PrivateTmp) and the ones that keep its memory off disk (LimitCORE=0, plus
# harden_process()'s prctl(PR_SET_DUMPABLE,0) inside the program).

[Unit]
Description=cockpit-secrets unlock agent for uid %i (opt-in, off by default)
Documentation=file:@LIBDIR@/agent/README.md
Requires=secrets-agent@%i.socket
After=secrets-agent@%i.socket

[Service]
Type=exec
User=%i
# --owner-uid %i is redundant with User=%i and stated anyway: the uid a holding
# is bound to is the single most important number in this program, and it
# should be readable in `systemctl cat` without inferring it.
ExecStart=/usr/bin/python3 @LIBDIR@/agent/secrets_agent.py --owner-uid %i
#
# THE ONE LINE TO THINK ABOUT BEFORE UNCOMMENTING
# -----------------------------------------------
# For `access: "admin"` safes the helper runs as root, so its peer credential
# is uid 0 and this agent will refuse it by default. Admitting uid 0 is a
# SPEAKING gate only - root gets its own holdings and still cannot read a
# holding another uid created, because the ownership check in the agent has no
# exception in it - but it does mean the agent can no longer tell which admin
# root is acting for. Prefer teaching the helper to fork and setuid to the
# operator before it connects; then these lines stay commented out and
# SO_PEERCRED means what it says.
#
# The empty ExecStart= below is not decoration: a Type=exec service may have
# only ONE ExecStart=, so the line above has to be cleared before a second one
# is set. Uncomment BOTH lines or neither.
#
#ExecStart=
#ExecStart=/usr/bin/python3 @LIBDIR@/agent/secrets_agent.py --owner-uid %i --allow-peer-uid 0
KillSignal=SIGTERM
TimeoutStopSec=10
# Deliberately no restart: a restarted agent holds nothing, and restarting it
# automatically would only hide that everything was dropped.
Restart=no

# -- what it may not do -----------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectProc=invisible
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LimitCORE=0
UMask=0077
